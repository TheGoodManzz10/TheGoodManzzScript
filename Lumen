    -- Attach helper element methods to window context for easier building
    function newWindow:CreateSection(tab, sectionName)
        local newSection = {
            Name = sectionName or "Section",
            Elements = {}
        }
        
        function newSection:AddButton(text, callback)
            local elem = Elements.CreateButton(self, text, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddToggle(text, defaultState, callback)
            local elem = Elements.CreateToggle(self, text, defaultState, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddSlider(text, min, max, default, callback)
            local elem = Elements.CreateSlider(self, text, min, max, default, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddDropdown(text, options, defaultOption, callback)
            local elem = Elements.CreateDropdown(self, text, options, defaultOption, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddColorPicker(text, defaultColor, callback)
            local elem = Elements.CreateColorPicker(self, text, defaultColor, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddKeybind(text, defaultKey, callback)
            local elem = Elements.CreateKeybind(self, text, defaultKey, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddTextbox(text, placeholder, clearOnFocus, callback)
            local elem = Elements.CreateTextbox(self, text, placeholder, clearOnFocus, callback)
            table.insert(self.Elements, elem)
            return elem
        end
        
        function newSection:AddLabel(text)
            local elem = Elements.CreateLabel(self, text)
            table.insert(self.Elements, elem)
            return elem
        end
        
        table.insert(tab.Sections, newSection)
        return newSection
    end
    
    return newWindow
end

