--                   SECTION 2: ANIMATION ENGINE                     --
--[================================================================]]--

local AnimationEngine = {}

function AnimationEngine.Lerp(a, b, t)
    return a + (b - a) * t
end

function AnimationEngine.TweenColor(startColor, targetColor, alpha)
    local r = AnimationEngine.Lerp(startColor[1], targetColor[1], alpha)
    local g = AnimationEngine.Lerp(startColor[2], targetColor[2], alpha)
    local b = AnimationEngine.Lerp(startColor[3], targetColor[3], alpha)
    return { r, g, b }
end

function AnimationEngine.EaseOutQuint(x)
    return 1 - math.pow(1 - x, 5)
end

function AnimationEngine.EaseInOutCubic(x)
    return x < 0.5 and 4 * x * x * x or 1 - math.pow(-2 * x + 2, 3) / 2
end

function LumenUI.CreateTween(object, properties, duration, easingStyle, easingDirection)
    if TweenService and object then
        local tweenInfo = TweenInfo.new(
            duration or 0.3,
            easingStyle or Enum.EasingStyle.Quart,
            easingDirection or Enum.EasingDirection.Out
        )
        local tween = TweenService:Create(object, tweenInfo, properties)
        tween:Play()
        return tween
    end
    return nil
end

