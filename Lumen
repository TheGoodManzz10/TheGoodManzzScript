local NotificationManager = {}
NotificationManager.__index = NotificationManager

function NotificationManager.new(parentUI)
    local self = setmetatable({}, NotificationManager)
    self.Parent = parentUI
    self.ActiveNotifications = {}
    return self
end

function NotificationManager:Notify(title, description, duration, notificationType)
    local notifData = {
        Title = title or "Notification",
        Description = description or "",
        Duration = duration or 4,
        Type = notificationType or "Info", -- Info, Success, Warning, Error
        Timestamp = os.time()
    }
    
    table.insert(self.ActiveNotifications, notifData)
    
    -- Simulate notification render cleanup
    task.delay(notifData.Duration, function()
        for i, n in ipairs(self.ActiveNotifications) do
            if n == notifData then
                table.remove(self.ActiveNotifications, i)
                break
            end
        end
    end)
    
    return notifData
end

