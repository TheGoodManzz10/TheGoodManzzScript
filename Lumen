local Signal = {}
Signal.__index = Signal

function Signal.new()
    local self = setmetatable({}, Signal)
    self._connections = {}
    return self
end

function Signal:Connect(listener)
    table.insert(self._connections, listener)
    local connection = {
        Connected = true,
        Disconnect = function(conn)
            for i, l in ipairs(self._connections) do
                if l == listener then
                    table.remove(self._connections, i)
                    conn.Connected = false
                    break
                end
            end
        end
    }
    return connection
end

function Signal:Fire(...)
    for _, listener in ipairs(self._connections) do
        task.spawn(listener, ...)
    end
end

