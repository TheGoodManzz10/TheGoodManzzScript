local Elements = {}

-- 1. Button Element
function Elements.CreateButton(section, text, callback)
    local buttonObj = {
        Type = "Button",
        Text = text or "Button",
        Callback = callback or function() end,
        Locked = false
    }
    
    function buttonObj:SetText(newText)
        self.Text = newText
    end
    
    function buttonObj:Fire()
        if not self.Locked then
            local success, err = pcall(self.Callback)
            if not success then
                warn("[LumenUI Error] Button callback failed: " .. tostring(err))
            end
        end
    end
    
    return buttonObj
end

-- 2. Toggle Element
function Elements.CreateToggle(section, text, defaultState, callback)
    local toggleObj = {
        Type = "Toggle",
        Text = text or "Toggle",
        State = defaultState or false,
        Callback = callback or function(state) end
    }
    
    function toggleObj:SetState(newState)
        self.State = newState
        local success, err = pcall(self.Callback, self.State)
        if not success then
            warn("[LumenUI Error] Toggle callback failed: " .. tostring(err))
        end
    end
    
    function toggleObj:Toggle()
        self:SetState(not self.State)
    end
    
    return toggleObj
end

-- 3. Slider Element
function Elements.CreateSlider(section, text, min, max, default, callback)
    local sliderObj = {
        Type = "Slider",
        Text = text or "Slider",
        Min = min or 0,
        Max = max or 100,
        Value = default or min or 0,
        Callback = callback or function(val) end
    }
    
    function sliderObj:SetValue(val)
        self.Value = math.clamp(val, self.Min, self.Max)
        local success, err = pcall(self.Callback, self.Value)
        if not success then
            warn("[LumenUI Error] Slider callback failed: " .. tostring(err))
        end
    end
    
    return sliderObj
end

-- 4. Dropdown Element
function Elements.CreateDropdown(section, text, options, defaultOption, callback)
    local dropdownObj = {
        Type = "Dropdown",
        Text = text or "Dropdown",
        Options = options or {},
        Selected = defaultOption or options[1] or "",
        Callback = callback or function(selected) end
    }
    
    function dropdownObj:Select(option)
        for _, opt in ipairs(self.Options) do
            if opt == option then
                self.Selected = option
                pcall(self.Callback, self.Selected)
                return true
            end
        end
        return false
    end
    
    return dropdownObj
end

-- 5. ColorPicker Element
function Elements.CreateColorPicker(section, text, defaultColor, callback)
    local colorPickerObj = {
        Type = "ColorPicker",
        Text = text or "Color Picker",
        Color = defaultColor or { 255, 255, 255 },
        Callback = callback or function(color) end
    }
    
    function colorPickerObj:SetColor(r, g, b)
        self.Color = { r, g, b }
        pcall(self.Callback, self.Color)
    end
    
    return colorPickerObj
end

-- 6. Keybind Element
function Elements.CreateKeybind(section, text, defaultKey, callback)
    local keybindObj = {
        Type = "Keybind",
        Text = text or "Keybind",
        Key = defaultKey or "F",
