local KeySystem = {}
KeySystem.__index = KeySystem

function KeySystem.new(options)
    local self = setmetatable({}, KeySystem)
    self.Title = options.Title or "Authentication Required"
    self.Description = options.Description or "Please enter your license key to proceed."
    self.KeyLink = options.KeyLink or "https://example.com/get-key"
    self.ValidKeys = options.ValidKeys or { "LUMEN-FREE-2026", "LUMEN-VIP-DEV" }
    self.IsAuthenticated = false
    self.OnAuthenticated = Signal.new()
    return self
end

function KeySystem:Validate(keyInput)
    for _, validKey in ipairs(self.ValidKeys) do
        if keyInput == validKey then
            self.IsAuthenticated = true
            self.OnAuthenticated:Fire(true)
            return true
        end
    end
    return false
end

function KeySystem:GetHardwareID()
    -- Mock HWID generator for licensing binding
    local rawId = "LUMEN-HWID-" .. math.random(100000, 999999)
    return rawId
end

