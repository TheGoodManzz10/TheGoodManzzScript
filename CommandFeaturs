-- =================================================================
-- Daftar Perintah v6.5.2 (Mendukung Tombol 'Fast' Nama Lengkap & Singkatan):
--   1.  fly [nilai kecepatan]         (fly / f)
--   2.  unfly                         (ufly / uf)
--   3.  noclip                        (ncp / cl)
--   4.  clip                          (cp / c)
--   5.  inf jump                      (infjp / fjp)
--   6.  uninf jump                    (ufjp / ujp)
--   7.  set waypoint [nama]           (swp / sp)
--   8.  tween to [nama waypoint]      (twp / tn)
--   9.  cframe to [nama waypoint]     (cfm / tp)
--   10. speed tween [nilai]           (spt / st)
--   11. speed walk [nilai]            (spw / sp)
--   12. jumppower [nilai]             (jpp / jp)
--   13. gravity [nilai]               (grav / gv)
--   14. siang                         (sng / sg)
--   15. malam                         (mlm / mm)
--   16. subuh                         (sbh / sh)    -- Kabut tebal & atmosfer subuh
--   17. pagi                          (pgi / pg)    -- Suasana pagi berkabut
--   18. subuh2                        (sbh2 / sb2)  -- Suasana subuh + sinar matahari (SunRays)
--   19. efek api [nilai radius]       (efkp / ei)   -- Cahaya & cincin api di sekitar karakter
--   20. unefek api                    (ufak / ufi)  -- Matikan efek api
--   21. salju                         (slj / s)     -- Salju layar + lapisan salju putih tipis di atas permukaan semua part (1x per part, anti-lag!)
--   22. unsalju                       (uslj / us)   -- Matikan salju & bersihkan lapisan salju part
--   23. salju extreme                 (sljex / se)  -- Seluruh layar warna biru muda salju transparan mulus seperti proses loading!
--   24. unsalju extreme               (usme / usx)  -- Matikan efek layar salju extreme
--   25. sore / sunset                 (sre / snt)   -- Suasana sore / sunset keemasan
--   26. hujan                         (hjn / rn)    -- Hujan + genangan air + partikel cipratan air
--   27. unhujan                       (uhjn / uh)   -- Matikan hujan, partikel air & genangan air
--   28. air walk                      (awk / aw)    -- Berjalan di udara di ketinggian tetap
--   29. unair walk                    (uak / uw)    -- Matikan Air Walk
--   30. intant promt                  (itpm / inp)  -- Semua ProximityPrompt langsung instan (0 detik)
--   + 10 Fitur Baru Tambahan (31 - 45):
--   31. dex                           (dex / dx)    -- Execute Dark Dex Explorer
--   32. sspy                          (sspy / rspy) -- Execute SimpleSpy Remote Explorer
--   33. iy                            (iy / infyield) -- Execute Infinite Yield
--   34. rejoin                        (rejoin / rj) -- Rejoin server saat ini
--   35. serverhop                     (serverhop / shop) -- Pindah ke server lain
--   36. esp player                    (espp / ep)   -- Highlight & nama semua player di server
--   37. unesp player                  (uespp / uep) -- Matikan ESP Player
--   38. fullbright                    (fb / terang) -- Pencahayaan terang maksimal tanpa bayangan
--   39. unfullbright                  (ufb / normalterang) -- Kembalikan pencahayaan asli
--   40. fov [nilai]                   (fov / fv)    -- Ubah luas pandangan kamera (30 - 120)
--   41. xray                          (xry / xr)    -- Tembus pandang dinding bangunan
--   42. unxray                        (uxry / uxr)  -- Matikan Xray dinding
--   43. spin [kecepatan]              (spn / sn)    -- Putar karakter dengan cepat
--   44. unspin                        (uspn / usn)  -- Hentikan putaran karakter
--   45. antiafk                       (aafk / afk)  -- Cegah terputus karena AFK
-- =================================================================

return function(AetherLib)
	local CoreGui = game:GetService("CoreGui")
	local Lighting = game:GetService("Lighting")
	local Players = game:GetService("Players")
	local ProximityPromptService = game:GetService("ProximityPromptService")
	local RunService = game:GetService("RunService")
	local TeleportService = game:GetService("TeleportService")
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")
	local Workspace = game:GetService("Workspace")
	local LocalPlayer = Players.LocalPlayer

	-- Bersihkan seluruh perintah lama agar hanya daftar perintah baru v6.5.2 ini yang tampil
	if type(AetherLib.RegisteredCommands) == "table" then
		for k in pairs(AetherLib.RegisteredCommands) do
			AetherLib.RegisteredCommands[k] = nil
		end
	end

	local States = {
		Fly = false,
		FlySpeed = 50,
		Noclip = false,
		InfJump = false,
		TweenSpeed = 150,
		IsTweening = false,
		ActiveTween = nil,
		Waypoints = {},
		FireEffectActive = false,
		SnowActive = false,
		SnowExtremeActive = false,
		RainActive = false,
		AirWalkActive = false,
		AirWalkY = nil,
		InstantPromptActive = false,
		EspPlayerActive = false,
		SpinActive = false,
		SpinSpeed = 30,
		XrayActive = false,
		AntiAfkActive = false,
		OriginalLighting = {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			FogStart = Lighting.FogStart,
			FogEnd = Lighting.FogEnd,
			FogColor = Lighting.FogColor,
			GlobalShadows = Lighting.GlobalShadows
		}
	}

	local Connections = {}
	local FireInstances = {}
	local SnowCapFolder = nil
	local CoveredSnowParts = {} -- [BasePart] = true (Anti-Lag: Part yang sudah tertutup salju tidak dibuatkan lagi)
	local RainPuddleFolder = nil
	local CoveredPuddleParts = {} -- [BasePart] = true (Anti-Lag: Part yang sudah ada genangan air tidak dibuatkan lagi)
	local RainEmitterPart = nil
	local AirWalkPart = nil
	local PlayerEspObjects = {}
	local WeatherScreenGui = nil
	local SnowScreenFrame = nil
	local FrostExtremeFrame = nil
	local RainScreenFrame = nil

	local function Notify(title, text, duration)
		if AetherLib and type(AetherLib.AddNotification) == "function" then
			pcall(function()
				AetherLib:AddNotification(title, text, duration or 2)
			end)
		end
	end

	local function GetRootPart()
		local char = LocalPlayer and LocalPlayer.Character
		return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChildWhichIsA("BasePart"))
	end

	local function GetHumanoid()
		local char = LocalPlayer and LocalPlayer.Character
		return char and char:FindFirstChildOfClass("Humanoid")
	end

	local function IsCharacterPart(inst)
		if not inst then return false end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character and inst:IsDescendantOf(plr.Character) then
				return true
			end
		end
		return false
	end

	-- Fungsi Pendaftaran Perintah Utama + Banyak Singkatan (Alias)
	-- Tombol "Fast" di Command List otomatis selalu menulis `mainCmd` (nama lengkap, bukan singkatan!)
	local function RegisterCmd(mainCmd, aliases, desc, syntax, callback)
		local cleanMain = string.lower(tostring(mainCmd))
		AetherLib:RegisterCommand(cleanMain, desc, syntax, callback, false, cleanMain)
		if type(aliases) == "table" then
			for _, al in ipairs(aliases) do
				local cleanAlias = string.lower(tostring(al))
				if cleanAlias ~= "" and cleanAlias ~= cleanMain then
					AetherLib:RegisterCommand(cleanAlias, "[Singkatan] " .. desc, syntax, callback, true, cleanMain)
				end
			end
		end
	end

	-- =================================================================
	-- 1 & 2. FLY & UNFLY
	-- =================================================================
	local function StopFly()
		States.Fly = false
		local root = GetRootPart()
		if root then
			local bg = root:FindFirstChild("AetherFlyGyro")
			if bg then bg:Destroy() end
			local bv = root:FindFirstChild("AetherFlyVel")
			if bv then bv:Destroy() end
		end
	end

	RegisterCmd("fly", { "f" }, "Mengaktifkan mode terbang dengan kecepatan tertentu", "fly [nilai kecepatan] (fly/f)", function(args)
		local speed = tonumber(args[1]) or 50
		States.FlySpeed = math.max(speed, 5)
		States.Fly = true

		local root = GetRootPart()
		if not root then return end

		local bg = root:FindFirstChild("AetherFlyGyro") or Instance.new("BodyGyro")
		bg.Name = "AetherFlyGyro"
		bg.P = 9e4
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.Parent = root

		local bv = root:FindFirstChild("AetherFlyVel") or Instance.new("BodyVelocity")
		bv.Name = "AetherFlyVel"
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Parent = root

		Notify("Fly Aktif", "Mode terbang aktif! Kecepatan: " .. tostring(States.FlySpeed), 2)

		task.spawn(function()
			while States.Fly do
				local r = GetRootPart()
				local cam = Workspace.CurrentCamera
				local hum = GetHumanoid()
				if not r or not cam or not bg.Parent or not bv.Parent then
					break
				end
				bg.CFrame = cam.CFrame
				if hum and hum.MoveDirection.Magnitude > 0 then
					bv.Velocity = cam.CFrame.LookVector * States.FlySpeed
				else
					bv.Velocity = Vector3.zero
				end
				RunService.RenderStepped:Wait()
			end
		end)
	end)

	RegisterCmd("unfly", { "ufly", "uf" }, "Mematikan mode terbang", "unfly (ufly/uf)", function()
		StopFly()
		Notify("Unfly", "Mode terbang dimatikan.", 1.8)
	end)

	-- =================================================================
	-- 3 & 4. NOCLIP & CLIP
	-- =================================================================
	if not Connections.NoclipLoop then
		Connections.NoclipLoop = RunService.Stepped:Connect(function()
			if (States.Noclip or States.IsTweening) and LocalPlayer and LocalPlayer.Character then
				for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	end

	RegisterCmd("noclip", { "ncp", "cl" }, "Menembus semua dinding dan objek", "noclip (ncp/cl)", function()
		States.Noclip = true
		Notify("Noclip", "Noclip diaktifkan!", 1.8)
	end)

	RegisterCmd("clip", { "cp", "c" }, "Mematikan noclip dan mengembalikan tabrakan karakter", "clip (cp/c)", function()
		States.Noclip = false
		if LocalPlayer and LocalPlayer.Character then
			for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
				if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
					part.CanCollide = true
				end
			end
		end
		Notify("Clip", "Noclip dimatikan (Clip aktif).", 1.8)
	end)

	-- =================================================================
	-- 5 & 6. INF JUMP & UNINF JUMP
	-- =================================================================
	if not Connections.InfJumpConn then
		Connections.InfJumpConn = UserInputService.JumpRequest:Connect(function()
			if States.InfJump then
				local hum = GetHumanoid()
				if hum then
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end)
	end

	RegisterCmd("inf jump", { "infjp", "fjp", "infjump" }, "Melompat tanpa batas di udara", "inf jump (infjp/fjp)", function()
		States.InfJump = true
		Notify("Inf Jump", "Infinite Jump diaktifkan!", 1.8)
	end)

	RegisterCmd("uninf jump", { "ufjp", "ujp", "uninfjump" }, "Mematikan lompatan tanpa batas", "uninf jump (ufjp/ujp)", function()
		States.InfJump = false
		Notify("Uninf Jump", "Infinite Jump dimatikan.", 1.8)
	end)

	-- =================================================================
	-- 7, 8, 9, 10, 11. WAYPOINT, TWEEN TO, CFRAME TO, SPEED TWEEN, SPEED WALK
	-- =================================================================
	local function SaveNamedWaypoint(wpName)
		local root = GetRootPart()
		if not root then
			Notify("Set Waypoint", "Karakter belum siap!", 2)
			return
		end
		local cleanName = tostring(wpName or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if cleanName == "" then
			cleanName = "default"
		end
		States.Waypoints[string.lower(cleanName)] = {
			Name = cleanName,
			CFrame = root.CFrame
		}
		Notify("Waypoint Disimpan", "Waypoint '" .. cleanName .. "' berhasil disimpan!", 2.2)
	end

	local function FindWaypointRecord(wpName)
		local key = string.lower(tostring(wpName or ""):gsub("^%s+", ""):gsub("%s+$", ""))
		if key == "" then
			key = "default"
		end
		if States.Waypoints[key] then
			return States.Waypoints[key]
		end
		for k, v in pairs(States.Waypoints) do
			if k:find(key, 1, true) then
				return v
			end
		end
		return nil
	end

	RegisterCmd("set waypoint", { "swp", "setwaypoint" }, "Menyimpan posisi saat ini sebagai waypoint bernama", "set waypoint [nama] (swp/sp)", function(args)
		local wpName = table.concat(args, " ")
		SaveNamedWaypoint(wpName)
	end)

	RegisterCmd("tween to", { "twp", "tn", "tweento" }, "Meluncur dengan gaya Tween ke waypoint yang disimpan", "tween to [nama waypoint] (twp/tn)", function(args)
		local wpName = table.concat(args, " ")
		local rec = FindWaypointRecord(wpName)
		if not rec or not rec.CFrame then
			Notify("Tween To Gagal", "Waypoint '" .. tostring(wpName) .. "' belum ditemukan!", 2.2)
			return
		end
		local root = GetRootPart()
		if not root then return end

		if States.ActiveTween then
			pcall(function() States.ActiveTween:Cancel() end)
			States.ActiveTween = nil
		end

		local dist = (root.Position - rec.CFrame.Position).Magnitude
		local spd = math.max(tonumber(States.TweenSpeed) or 150, 10)
		local dur = math.clamp(dist / spd, 0.08, 60)

		States.IsTweening = true
		local tw = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = rec.CFrame })
		States.ActiveTween = tw
		tw:Play()
		Notify("Tween To", "Meluncur ke waypoint '" .. tostring(rec.Name) .. "'...", 2)

		tw.Completed:Once(function()
			if States.ActiveTween == tw then
				States.ActiveTween = nil
				States.IsTweening = false
			end
		end)
	end)

	RegisterCmd("cframe to", { "cfm", "tp", "cframeto" }, "Teleport instan (CFrame) ke waypoint yang disimpan", "cframe to [nama waypoint] (cfm/tp)", function(args)
		local wpName = table.concat(args, " ")
		local rec = FindWaypointRecord(wpName)
		if not rec or not rec.CFrame then
			Notify("CFrame To Gagal", "Waypoint '" .. tostring(wpName) .. "' belum ditemukan!", 2.2)
			return
		end
		local root = GetRootPart()
		if not root then return end

		if States.ActiveTween then
			pcall(function() States.ActiveTween:Cancel() end)
			States.ActiveTween = nil
		end
		States.IsTweening = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = rec.CFrame
		Notify("CFrame To", "Teleport instan ke waypoint '" .. tostring(rec.Name) .. "'!", 2)
	end)

	RegisterCmd("speed tween", { "spt", "st", "speedtween" }, "Mengatur kecepatan meluncur Tween", "speed tween [nilai] (spt/st)", function(args)
		local val = tonumber(args[1]) or 150
		States.TweenSpeed = math.clamp(val, 10, 2000)
		Notify("Speed Tween", "Kecepatan Tween diatur ke: " .. tostring(States.TweenSpeed), 2)
	end)

	RegisterCmd("speed walk", { "spw", "speedwalk" }, "Mengatur kecepatan jalan (WalkSpeed) karakter", "speed walk [nilai] (spw/sp)", function(args)
		local val = tonumber(args[1]) or 16
		local hum = GetHumanoid()
		if hum then
			hum.WalkSpeed = val
		end
		Notify("Speed Walk", "WalkSpeed diatur ke: " .. tostring(val), 2)
	end)

	AetherLib:RegisterCommand("sp", "[Singkatan] Speed Walk (angka) atau Set Waypoint (nama)", "sp [nilai_speed / nama_waypoint]", function(args)
		local firstArg = args[1]
		if firstArg and tonumber(firstArg) ~= nil then
			local val = tonumber(firstArg)
			local hum = GetHumanoid()
			if hum then hum.WalkSpeed = val end
			Notify("Speed Walk (sp)", "WalkSpeed diatur ke: " .. tostring(val), 2)
		else
			local wpName = table.concat(args, " ")
			SaveNamedWaypoint(wpName)
		end
	end, true, "speed walk")

	-- =================================================================
	-- 12 & 13. JUMPPOWER & GRAVITY
	-- =================================================================
	RegisterCmd("jumppower", { "jpp", "jp" }, "Mengatur kekuatan lompatan karakter", "jumppower [nilai] (jpp/jp)", function(args)
		local val = tonumber(args[1]) or 50
		local hum = GetHumanoid()
		if hum then
			hum.UseJumpPower = true
			hum.JumpPower = val
		end
		Notify("JumpPower", "JumpPower diatur ke: " .. tostring(val), 2)
	end)

	RegisterCmd("gravity", { "grav", "gv" }, "Mengatur gravitasi dunia game", "gravity [nilai] (grav/gv)", function(args)
		local val = tonumber(args[1]) or 196.2
		Workspace.Gravity = val
		Notify("Gravity", "Gravitasi diatur ke: " .. tostring(val), 2)
	end)

	-- =================================================================
	-- 14, 15, 16, 17, 18, 25. CUACA & WAKTU (SIANG, MALAM, SUBUH, PAGI, SUBUH2, SORE/SUNSET)
	-- =================================================================
	local function ClearCustomLightingEffects()
		for _, child in ipairs(Lighting:GetChildren()) do
			if child.Name == "AetherCmd_Atmosphere" or child.Name == "AetherCmd_SunRays" or child.Name == "AetherCmd_ColorCorrection" or child.Name == "AetherCmd_Bloom" then
				pcall(function() child:Destroy() end)
			end
		end
	end

	RegisterCmd("siang", { "sng", "sg" }, "Mengubah waktu menjadi siang hari yang cerah", "siang (sng/sg)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 13.5
		Lighting.Brightness = 2.5
		Lighting.Ambient = Color3.fromRGB(150, 155, 165)
		Lighting.OutdoorAmbient = Color3.fromRGB(175, 180, 190)
		Lighting.FogStart = 500
		Lighting.FogEnd = 100000
		Lighting.FogColor = Color3.fromRGB(200, 225, 255)
		Notify("Suasana Siang", "Waktu diubah menjadi Siang cerah!", 2)
	end)

	RegisterCmd("malam", { "mlm", "mm" }, "Mengubah waktu menjadi suasana malam", "malam (mlm/mm)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 0
		Lighting.Brightness = 0.6
		Lighting.Ambient = Color3.fromRGB(30, 35, 55)
		Lighting.OutdoorAmbient = Color3.fromRGB(40, 48, 75)
		Lighting.FogStart = 60
		Lighting.FogEnd = 900
		Lighting.FogColor = Color3.fromRGB(18, 22, 38)
		Notify("Suasana Malam", "Waktu diubah menjadi Malam!", 2)
	end)

	RegisterCmd("subuh", { "sbh", "sh" }, "Suasana subuh dengan kabut tebal dingin dan langit fajar gelap", "subuh (sbh/sh)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 5.15
		Lighting.Brightness = 0.85
		Lighting.Ambient = Color3.fromRGB(48, 58, 82)
		Lighting.OutdoorAmbient = Color3.fromRGB(58, 70, 98)
		Lighting.FogStart = 8
		Lighting.FogEnd = 95
		Lighting.FogColor = Color3.fromRGB(62, 74, 102)

		pcall(function()
			local atm = Instance.new("Atmosphere")
			atm.Name = "AetherCmd_Atmosphere"
			atm.Density = 0.62
			atm.Offset = 0.15
			atm.Color = Color3.fromRGB(70, 84, 115)
			atm.Decay = Color3.fromRGB(45, 55, 80)
			atm.Glare = 0.1
			atm.Haze = 2.2
			atm.Parent = Lighting
		end)
		Notify("Suasana Subuh", "Suasana subuh dengan kabut tebal diaktifkan!", 2.2)
	end)

	RegisterCmd("pagi", { "pgi", "pg" }, "Suasana pagi sejuk lengkap dengan kabut pagi tipis", "pagi (pgi/pg)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 7.1
		Lighting.Brightness = 1.65
		Lighting.Ambient = Color3.fromRGB(125, 138, 158)
		Lighting.OutdoorAmbient = Color3.fromRGB(145, 160, 180)
		Lighting.FogStart = 20
		Lighting.FogEnd = 185
		Lighting.FogColor = Color3.fromRGB(188, 202, 220)

		pcall(function()
			local atm = Instance.new("Atmosphere")
			atm.Name = "AetherCmd_Atmosphere"
			atm.Density = 0.44
			atm.Offset = 0.1
			atm.Color = Color3.fromRGB(195, 210, 230)
			atm.Decay = Color3.fromRGB(150, 170, 195)
			atm.Haze = 1.6
			atm.Parent = Lighting
		end)
		Notify("Suasana Pagi", "Suasana pagi berkabut diaktifkan!", 2)
	end)

	RegisterCmd("subuh2", { "sbh2", "sb2" }, "Suasana subuh dengan sinar matahari fajar yang menyinari (SunRays)", "subuh2 (sbh2/sb2)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 6.25
		Lighting.Brightness = 2.1
		Lighting.Ambient = Color3.fromRGB(115, 95, 85)
		Lighting.OutdoorAmbient = Color3.fromRGB(165, 130, 105)
		Lighting.FogStart = 35
		Lighting.FogEnd = 280
		Lighting.FogColor = Color3.fromRGB(215, 165, 125)

		pcall(function()
			local sr = Instance.new("SunRaysEffect")
			sr.Name = "AetherCmd_SunRays"
			sr.Intensity = 0.42
			sr.Spread = 0.88
			sr.Enabled = true
			sr.Parent = Lighting

			local cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "AetherCmd_ColorCorrection"
			cc.Brightness = 0.04
			cc.Contrast = 0.12
			cc.Saturation = 0.18
			cc.TintColor = Color3.fromRGB(255, 228, 195)
			cc.Parent = Lighting

			local atm = Instance.new("Atmosphere")
			atm.Name = "AetherCmd_Atmosphere"
			atm.Density = 0.36
			atm.Color = Color3.fromRGB(235, 185, 140)
			atm.Decay = Color3.fromRGB(190, 130, 90)
			atm.Glare = 0.55
			atm.Haze = 1.4
			atm.Parent = Lighting
		end)
		Notify("Suasana Subuh 2", "Suasana subuh dengan pancaran sinar matahari aktif!", 2.2)
	end)

	RegisterCmd("sore", { "sunset", "sre", "snt" }, "Suasana sore / sunset jingga keemasan", "sore / sunset (sre/snt)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 17.65
		Lighting.Brightness = 1.9
		Lighting.Ambient = Color3.fromRGB(135, 85, 68)
