	-- 10 Fitur Baru Tambahan:
	-- (1) ESP Player & (2) UnESP Player
	local function ClearPlayerESP()
		States.EspPlayerActive = false
		for plr, data in pairs(PlayerEspObjects) do
			if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
			if data.Billboard then pcall(function() data.Billboard:Destroy() end) end
			PlayerEspObjects[plr] = nil
		end
	end

	RegisterCmd("esp player", { "espp", "ep", "esp" }, "Menampilkan highlight & nama seluruh pemain di server", "esp player (espp/ep)", function()
		States.EspPlayerActive = true
		task.spawn(function()
			while States.EspPlayerActive do
				local myRoot = GetRootPart()
				local myPos = myRoot and myRoot.Position or Vector3.zero
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer and plr.Character then
						local char = plr.Character
						local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
						if hrp then
							local data = PlayerEspObjects[plr]
							if not data or not data.Highlight or not data.Highlight.Parent then
								local hl = Instance.new("Highlight")
								hl.Name = "AetherPlayerESP_HL"
								hl.Adornee = char
								hl.FillColor = Color3.fromRGB(0, 230, 140)
								hl.FillTransparency = 0.65
								hl.OutlineColor = Color3.fromRGB(255, 255, 255)
								hl.Parent = char

								local bb = Instance.new("BillboardGui")
								bb.Name = "AetherPlayerESP_BB"
								bb.Adornee = hrp
								bb.Size = UDim2.new(0, 140, 0, 30)
								bb.StudsOffset = Vector3.new(0, 3.2, 0)
								bb.AlwaysOnTop = true
								bb.Parent = hrp

								local lbl = Instance.new("TextLabel")
								lbl.BackgroundTransparency = 1
								lbl.Size = UDim2.new(1, 0, 1, 0)
								lbl.Font = Enum.Font.GothamBold
								lbl.TextColor3 = Color3.fromRGB(100, 255, 160)
								lbl.TextStrokeTransparency = 0.2
								lbl.TextSize = 11
								lbl.Parent = bb

								data = { Highlight = hl, Billboard = bb, Label = lbl }
								PlayerEspObjects[plr] = data
							end
							if data.Label then
								local dist = math.floor((hrp.Position - myPos).Magnitude)
								data.Label.Text = string.format("%s [%d Studs]", tostring(plr.DisplayName or plr.Name), dist)
							end
						end
					end
				end
				task.wait(0.4)
			end
		end)
		Notify("ESP Player", "ESP semua pemain diaktifkan!", 2)
	end)

