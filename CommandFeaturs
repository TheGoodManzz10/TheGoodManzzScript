	local function StopSnowEffect()
		States.SnowActive = false
		if SnowScreenFrame and SnowScreenFrame.Parent then
			pcall(function() SnowScreenFrame:Destroy() end)
		end
		SnowScreenFrame = nil

		if SnowCapFolder and SnowCapFolder.Parent then
			pcall(function() SnowCapFolder:Destroy() end)
		end
		SnowCapFolder = nil

		for part in pairs(CoveredSnowParts) do
			if part and part.Parent then
				pcall(function()
					part:SetAttribute("AetherSnowCovered", nil)
				end)
			end
			CoveredSnowParts[part] = nil
		end
	end

	-- Membuat lapisan part putih salju tipis (0.08 stud) tepat di atas permukaan BasePart (1x per part, anti-lag!)
	local function CreateThinSnowCapOnPart(part)
		if not States.SnowActive or not SnowCapFolder or not SnowCapFolder.Parent then
			return false
		end
		if not part or not part.Parent or not part:IsA("BasePart") then
			return false
		end
		if CoveredSnowParts[part] or part:GetAttribute("AetherSnowCovered") == true then
			return false
		end
		if part.Name == "AetherSnowCap" or part.Name == "AetherWaterPuddle" or part.Name == "AetherAirWalkPad" then
			return false
		end
		if part.Transparency >= 0.92 or part.Size.X < 1.2 or part.Size.Z < 1.2 then
			return false
		end
		if SnowCapFolder and part:IsDescendantOf(SnowCapFolder) then
			return false
		end
		if RainPuddleFolder and part:IsDescendantOf(RainPuddleFolder) then
			return false
		end
		if IsCharacterPart(part) then
			return false
		end

		-- Hanya buat di atas part yang permukaannya menghadap ke atas (UpVector.Y > 0.65)
		if part.CFrame.UpVector.Y < 0.65 then
			return false
		end

		-- Tandai part ini sudah tertutup salju agar TIDAK PERNAH muncul lagi di atasnya (Anti-Lag!)
		CoveredSnowParts[part] = true
		pcall(function()
			part:SetAttribute("AetherSnowCovered", true)
		end)

		local snowCap = Instance.new("Part")
		snowCap.Name = "AetherSnowCap"
		snowCap.Anchored = true
		snowCap.CanCollide = false
		snowCap.CanQuery = false
		snowCap.CanTouch = false
		snowCap.CastShadow = false
		snowCap.Material = Enum.Material.Sand
		snowCap.Color = Color3.fromRGB(248, 252, 255)

		-- Tipis & pas menutupi seluruh permukaan atas part tersebut
		local thickness = 0.08
		snowCap.Size = Vector3.new(part.Size.X, thickness, part.Size.Z)
		snowCap.CFrame = part.CFrame * CFrame.new(0, (part.Size.Y * 0.5) + (thickness * 0.5), 0)
		snowCap.Parent = SnowCapFolder
		return true
	end

	RegisterCmd("salju", { "slj", "s" }, "Muncul salju di layar & lapisan part putih salju tipis di atas permukaan semua part (1x per part, anti-lag!)", "salju (slj/s)", function()
