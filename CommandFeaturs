	local function StopAirWalk()
		States.AirWalkActive = false
		States.AirWalkY = nil
		if AirWalkPart and AirWalkPart.Parent then
			pcall(function() AirWalkPart:Destroy() end)
		end
		AirWalkPart = nil
	end

	RegisterCmd("air walk", { "awk", "aw", "airwalk" }, "Berjalan di udara pada ketinggian tetap di bawah kaki karakter", "air walk (awk/aw)", function()
		StopAirWalk()
		local root = GetRootPart()
		local hum = GetHumanoid()
		if not root then
			Notify("Air Walk", "Karakter tidak ditemukan!", 2)
			return
		end

		States.AirWalkActive = true
		local hipOffset = (hum and hum.HipHeight and hum.HipHeight > 0) and (hum.HipHeight + 1.5) or 3.35
		States.AirWalkY = root.Position.Y - hipOffset

		local pad = Instance.new("Part")
		pad.Name = "AetherAirWalkPad"
		pad.Anchored = true
		pad.CanCollide = true
		pad.Size = Vector3.new(14, 0.6, 14)
		pad.Material = Enum.Material.ForceField
		pad.Color = Color3.fromRGB(90, 210, 255)
		pad.Transparency = 0.55
		pad.CFrame = CFrame.new(root.Position.X, States.AirWalkY, root.Position.Z)
		pad.Parent = Workspace
		AirWalkPart = pad

		task.spawn(function()
			while States.AirWalkActive and pad and pad.Parent do
				local r = GetRootPart()
				if r and States.AirWalkY then
					pad.CFrame = CFrame.new(r.Position.X, States.AirWalkY, r.Position.Z)
				end
				RunService.Heartbeat:Wait()
			end
		end)

		Notify("Air Walk Aktif", "Air Walk aktif! Kamu sekarang bisa berjalan di udara.", 2.2)
	end)

	RegisterCmd("unair walk", { "uak", "uw", "unairwalk" }, "Menonaktifkan Air Walk dan menghapus pijakan udara", "unair walk (uak/uw)", function()
		StopAirWalk()
