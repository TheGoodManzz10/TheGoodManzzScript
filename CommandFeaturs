	RegisterCmd("sore", { "sunset", "sre", "snt" }, "Suasana sore / sunset jingga keemasan", "sore / sunset (sre/snt)", function()
		ClearCustomLightingEffects()
		Lighting.ClockTime = 17.65
		Lighting.Brightness = 1.9
		Lighting.Ambient = Color3.fromRGB(135, 85, 68)
		Lighting.OutdoorAmbient = Color3.fromRGB(185, 105, 78)
		Lighting.FogStart = 45
		Lighting.FogEnd = 420
		Lighting.FogColor = Color3.fromRGB(230, 125, 82)

		pcall(function()
			local sr = Instance.new("SunRaysEffect")
			sr.Name = "AetherCmd_SunRays"
			sr.Intensity = 0.35
			sr.Spread = 0.75
			sr.Enabled = true
			sr.Parent = Lighting

			local cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "AetherCmd_ColorCorrection"
			cc.TintColor = Color3.fromRGB(255, 205, 175)
			cc.Saturation = 0.22
			cc.Contrast = 0.1
			cc.Parent = Lighting
		end)
		Notify("Suasana Sore / Sunset", "Langit sore sunset keemasan diaktifkan!", 2)
	end)

	-- =================================================================
	-- 19 & 20. EFEK API [NILAI RADIUS] & UNEFEK API
	-- =================================================================
	local function ClearFireEffects()
		States.FireEffectActive = false
		for _, inst in ipairs(FireInstances) do
			if inst and inst.Parent then
				pcall(function() inst:Destroy() end)
			end
		end
		FireInstances = {}
	end

	RegisterCmd("efek api", { "efkp", "ei", "efekapi" }, "Memunculkan cahaya api & kobaran api di sekitar karakter sesuai radius", "efek api [nilai radius] (efkp/ei)", function(args)
		ClearFireEffects()
		local radius = math.clamp(tonumber(args[1]) or 25, 5, 60)
		local root = GetRootPart()
		if not root then
			Notify("Efek Api", "Karakter tidak ditemukan!", 2)
			return
		end

		States.FireEffectActive = true

		-- 1. Cahaya Api Utama pada Karakter (PointLight dengan Range = radius)
		local mainLight = Instance.new("PointLight")
		mainLight.Name = "AetherFirePointLight"
		mainLight.Color = Color3.fromRGB(255, 130, 35)
		mainLight.Range = radius
		mainLight.Brightness = 3.8
		mainLight.Shadows = true
		mainLight.Parent = root
		table.insert(FireInstances, mainLight)

		-- 2. Kobaran Api Tengah pada Karakter
		local centerFire = Instance.new("Fire")
		centerFire.Name = "AetherCenterFire"
		centerFire.Color = Color3.fromRGB(255, 140, 30)
		centerFire.SecondaryColor = Color3.fromRGB(255, 45, 10)
		centerFire.Size = math.clamp(radius * 0.35, 4, 22)
		centerFire.Heat = 12
		centerFire.Parent = root
		table.insert(FireInstances, centerFire)

		-- 3. Cincin Partikel & Cahaya Api Mengelilingi Karakter pada Jarak Radius
		local ringCount = 6
		local ringAttachments = {}
		local ringRadius = math.clamp(radius * 0.45, 4, 25)
		for i = 1, ringCount do
			local att = Instance.new("Attachment")
			att.Name = "AetherFireRingAtt_" .. tostring(i)
			local angle = (i / ringCount) * math.pi * 2
			att.Position = Vector3.new(math.cos(angle) * ringRadius, -1.5, math.sin(angle) * ringRadius)
			att.Parent = root

			local f = Instance.new("Fire")
			f.Color = Color3.fromRGB(255, 150, 40)
			f.SecondaryColor = Color3.fromRGB(255, 60, 15)
			f.Size = math.clamp(radius * 0.25, 3, 14)
			f.Heat = 9
			f.Parent = att

			local pl = Instance.new("PointLight")
			pl.Color = Color3.fromRGB(255, 120, 30)
			pl.Range = math.clamp(radius * 0.65, 8, 40)
			pl.Brightness = 2.0
			pl.Parent = att

			table.insert(FireInstances, att)
			table.insert(ringAttachments, { Attachment = att, BaseAngle = angle })
		end

		-- Animasi putaran cincin api & kedipan cahaya api alami
		task.spawn(function()
			local t0 = os.clock()
			while States.FireEffectActive and root and root.Parent and mainLight.Parent do
				local elapsed = os.clock() - t0
				mainLight.Brightness = 3.5 + math.sin(elapsed * 9) * 0.55
				for _, item in ipairs(ringAttachments) do
					if item.Attachment and item.Attachment.Parent then
						local a = item.BaseAngle + elapsed * 1.8
						item.Attachment.Position = Vector3.new(math.cos(a) * ringRadius, -1.5, math.sin(a) * ringRadius)
					end
				end
				task.wait(0.04)
			end
		end)

		Notify("Efek Api Aktif", "Cahaya & cincin api menyala (Radius: " .. tostring(radius) .. ")!", 2.2)
	end)

