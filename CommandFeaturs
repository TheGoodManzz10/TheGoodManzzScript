	local function EnsureWeatherScreenGui()
		if WeatherScreenGui and WeatherScreenGui.Parent then
			return WeatherScreenGui
		end
		local sg = Instance.new("ScreenGui")
		sg.Name = "AetherWeatherOverlayGui"
		sg.IgnoreGuiInset = true
		sg.ResetOnSpawn = false
		sg.DisplayOrder = 5
		pcall(function() sg.Parent = CoreGui end)
		if not sg.Parent and LocalPlayer then
			pcall(function() sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
		end
		WeatherScreenGui = sg
		return sg
	end

	-- =================================================================
	-- 21 & 22. SALJU (LAYAR + ATAS PART ANTI-LAG) & UNSALJU
	-- =================================================================
	local function StopSnowEffect()
		States.SnowActive = false
		if SnowScreenFrame and SnowScreenFrame.Parent then
			pcall(function() SnowScreenFrame:Destroy() end)
		end
		SnowScreenFrame = nil

		-- Bersihkan semua lapisan salju di atas part & reset penanda agar bisa dipakai lagi nanti
		if SnowCapFolder and SnowCapFolder.Parent then
			pcall(function() SnowCapFolder:Destroy() end)
		end
		SnowCapFolder = nil

		for part in pairs(CoveredSnowParts) do
			if part and part.Parent then
				pcall(function()
					part:SetAttribute("AetherSnowCovered", nil)
				end)
			end
			CoveredSnowParts[part] = nil
		end
	end

	RegisterCmd("salju", { "slj", "s" }, "Muncul salju di layar & salju di atas part/block yang terkena (1x per part agar anti-lag)", "salju (slj/s)", function()
		if States.SnowActive then
			Notify("Salju", "Efek salju sudah aktif!", 1.8)
			return
		end
		States.SnowActive = true

		local sg = EnsureWeatherScreenGui()
		local sFrame = Instance.new("Frame")
		sFrame.Name = "SnowScreenContainer"
		sFrame.Size = UDim2.new(1, 0, 1, 0)
		sFrame.BackgroundTransparency = 1
		sFrame.Parent = sg
		SnowScreenFrame = sFrame

		if not SnowCapFolder or not SnowCapFolder.Parent then
			SnowCapFolder = Instance.new("Folder")
			SnowCapFolder.Name = "AetherSnowCaps_AntiLag"
			SnowCapFolder.Parent = Workspace
		end

		-- Buat butiran salju layar yang bergerak turun secara halus
		local flakes = {}
		for i = 1, 42 do
			local f = Instance.new("Frame")
			local sz = math.random(3, 7)
			f.Size = UDim2.new(0, sz, 0, sz)
			f.Position = UDim2.new(math.random(), 0, math.random(), 0)
			f.BackgroundColor3 = Color3.fromRGB(245, 250, 255)
			f.BackgroundTransparency = math.random(15, 45) / 100
			f.BorderSizePixel = 0
			f.Parent = sFrame
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = f
			table.insert(flakes, {
				UI = f,
				X = math.random(),
				Y = math.random(),
				SpeedY = math.random(12, 28) / 100,
				DriftX = (math.random(-15, 15) / 100)
			})
		end

		-- Loop animasi salju layar
		task.spawn(function()
			local lastTick = os.clock()
			while States.SnowActive and sFrame and sFrame.Parent do
				local now = os.clock()
				local dt = math.min(now - lastTick, 0.1)
				lastTick = now
				for _, fl in ipairs(flakes) do
					fl.Y = fl.Y + fl.SpeedY * dt
					fl.X = (fl.X + fl.DriftX * dt * 0.25) % 1
					if fl.Y > 1.04 then
						fl.Y = -0.04
						fl.X = math.random()
					end
					if fl.UI and fl.UI.Parent then
						fl.UI.Position = UDim2.new(fl.X, 0, fl.Y, 0)
					end
				end
				task.wait(0.03)
			end
		end)

		-- Loop Penumpukan Salju di Atas Part/Block (ANTI-LAG: Part yang sudah terkena salju TIDAK BISA muncul lagi di atasnya!)
		task.spawn(function()
			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude

			while States.SnowActive and SnowCapFolder and SnowCapFolder.Parent do
				local root = GetRootPart()
				if root then
					local char = LocalPlayer.Character
					rayParams.FilterDescendantsInstances = { char, SnowCapFolder }

					-- Jatuhkan beberapa titik salju per siklus di sekitar karakter
					for _ = 1, 5 do
						if not States.SnowActive then break end
						local offsetX = math.random(-65, 65)
						local offsetZ = math.random(-65, 65)
						local origin = root.Position + Vector3.new(offsetX, 60, offsetZ)
						local hit = Workspace:Raycast(origin, Vector3.new(0, -140, 0), rayParams)

						if hit and hit.Instance and hit.Instance:IsA("BasePart") then
							local hitPart = hit.Instance
							-- Cek apakah part ini SUDAH pernah terkena salju (Anti-Lag 100%!)
							local alreadySnowed = CoveredSnowParts[hitPart] or (hitPart:GetAttribute("AetherSnowCovered") == true)
							if not alreadySnowed and hitPart.Name ~= "AetherSnowCap" and hitPart.Transparency < 0.95 then
								-- Tandai part ini sudah terkena salju agar TIDAK PERNAH muncul lagi di atasnya!
								CoveredSnowParts[hitPart] = true
								pcall(function()
									hitPart:SetAttribute("AetherSnowCovered", true)
								end)

								local snowCap = Instance.new("Part")
								snowCap.Name = "AetherSnowCap"
								snowCap.Anchored = true
								snowCap.CanCollide = false
								snowCap.CanQuery = false
								snowCap.CanTouch = false
								snowCap.CastShadow = false
								snowCap.Material = Enum.Material.Sand
								snowCap.Color = Color3.fromRGB(242, 248, 255)

								-- Sesuaikan ukuran lapisan salju tepat di permukaan atas part/block tersebut
								local capX = math.clamp(hitPart.Size.X, 1.5, 45)
								local capZ = math.clamp(hitPart.Size.Z, 1.5, 45)
								snowCap.Size = Vector3.new(capX, 0.22, capZ)
								snowCap.CFrame = hitPart.CFrame * CFrame.new(0, (hitPart.Size.Y * 0.5) + 0.11, 0)
								snowCap.Parent = SnowCapFolder
							end
						end
					end
				end
				task.wait(0.35)
			end
		end)

		Notify("Salju Aktif", "Salju layar & lapisan salju di atas part (Anti-Lag 1x per part) aktif!", 2.5)
	end)

