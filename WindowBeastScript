local MusicService = {
    CurrentSound = nil,
    IsPlaying = false,
    IsLooped = true,
    SelectedID = "142376088"
}

local MusicList = {
    ["Raining Tacos"] = "142376088",
    ["Phonc - Interworld"] = "6943807203",
    ["Never Gonna Give You Up"] = "9048375328",
    ["Elevator Music"] = "1848354536"
}

-- Buat grup khusus musik secara otomatis di dalam tab Settings
local MusicGroup = Window:AddGroup("Musik Background / Music Player", "lucide-music")

if not MusicService.CurrentSound then
    MusicService.CurrentSound = Instance.new("Sound")
    MusicService.CurrentSound.Name = "LibraryBackgroundMusic"
    MusicService.CurrentSound.Looped = MusicService.IsLooped
    MusicService.CurrentSound.Volume = 0.5
    MusicService.CurrentSound.Parent = game:GetService("SoundService")
end

local SongNames = {}
for name, _ in pairs(MusicList) do
    table.insert(SongNames, name)
end

-- 1. Dropdown Pilih Lagu
local MusicDropdown = MusicGroup:AddDropdown("Select Music / Pilih Musik", SongNames, "Raining Tacos", function(selected)
    if MusicList[selected] then
        MusicService.SelectedID = MusicList[selected]
        Library:Notify({ Title = "Music Selected / Musik Dipilih", Content = selected, Type = "Success", Duration = 2 })
        
        if MusicService.IsPlaying then
            MusicService.CurrentSound.SoundId = "rbxassetid://" .. MusicService.SelectedID
            MusicService.CurrentSound:Play()
        end
    end
end)

-- 2. Input Custom ID (Otomatis Tersimpan ke List Dropdown)
MusicGroup:AddInput("Custom Music ID", "Masukkan ID Roblox / Enter ID...", function(text)
    if text and text ~= "" and tonumber(text) then
        local cleanID = tostring(tonumber(text))
        local customName = "Custom (" .. cleanID .. ")"
        
        MusicList[customName] = cleanID
        MusicService.SelectedID = cleanID
        
        if MusicDropdown and MusicDropdown.UpdateValues then
            local UpdatedNames = {}
            for name, _ in pairs(MusicList) do
                table.insert(UpdatedNames, name)
            end
            MusicDropdown:UpdateValues(UpdatedNames, customName)
        end

        Library:Notify({ Title = "Custom ID Saved / ID Tersimpan", Content = customName, Type = "Success", Duration = 2 })
        
        if MusicService.IsPlaying then
            MusicService.CurrentSound.SoundId = "rbxassetid://" .. MusicService.SelectedID
            MusicService.CurrentSound:Play()
        end
    else
        Library:Notify({ Title = "Invalid ID / ID Tidak Valid", Content = "Please enter numbers only / Harap masukkan angka saja!", Type = "Error", Duration = 2 })
    end
end)

-- 3. Toggle Play / Stop Music
MusicGroup:AddToggle("Play Music / Putar Musik", "lucide-music", false, function(state)
    MusicService.IsPlaying = state
    
    if MusicService.IsPlaying then
        MusicService.CurrentSound.SoundId = "rbxassetid://" .. MusicService.SelectedID
        MusicService.CurrentSound.Looped = MusicService.IsLooped
        MusicService.CurrentSound:Play()
        Library:Notify({ Title = "Music / Musik", Content = "Playing / Lagu Diputar!", Type = "Success", Duration = 2 })
    else
        MusicService.CurrentSound:Stop()
        Library:Notify({ Title = "Music / Musik", Content = "Stopped / Lagu Dimatikan", Type = "Warning", Duration = 2 })
    end
end)

-- 4. Toggle Loop Music (On/Off)
MusicGroup:AddToggle("Loop Music / Ulangi Musik", "lucide-repeat", true, function(state)
    MusicService.IsLooped = state
    if MusicService.CurrentSound then
