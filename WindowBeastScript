    local function startExecution()
        playRayfieldExecution(titleText, text1, text2, text3, flashText, function()
            TweenService:Create(Main, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 240, 0, 270)
            }):Play()

            Library:Notify({
                Title = titleText,
                Content = L("Executed"),
                Type = "Success",
                Duration = 3
            })
        end)
    end

    if keySystemEnabled then
        showKeySystemUI(keySettings, startExecution)
    else
        startExecution()
    end

    local isMinimized = false
    local normalHeight = 300

    MinBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            normalHeight = Main.AbsoluteSize.Y
            Container.Visible = false
            SettingsContainer.Visible = false
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, Main.AbsoluteSize.X, 0, 36)
            }):Play()
        else
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, Main.AbsoluteSize.X, 0, normalHeight)
            }):Play()
            task.delay(0.2, function()
                Container.Visible = not showingSettings
                SettingsContainer.Visible = showingSettings
            end)
        end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        local closeTween = TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 240, 0, 0)
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            ScreenGui:Destroy()
        end)
    end)

    function Window:AddButton(text, icon, callback)
        return createButton(Container, text, icon, callback)
    end

    function Window:AddToggle(text, icon, default, callback)
        return createToggle(Container, text, icon, default, callback)
    end

    function Window:AddSlider(text, icon, min, max, default, callback)
        return createSlider(Container, text, icon, min, max, default, callback)
    end

    function Window:AddGroup(groupName, icon, defaultCollapsed)
        return buildGroupInContainer(Container, groupName, icon, defaultCollapsed)
    end

    Window.AddSection = Window.AddGroup

    return Window
end

return Library
