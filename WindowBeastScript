            BigText.TextSize = 72
            BigText.TextWrapped = true
            BigText.ZIndex = 1000000
            BigText.Parent = Flash

            task.spawn(function()
                for i = 1, #targetFlashText do
                    BigText.Text = string.sub(targetFlashText, 1, i)
                    task.wait(1)
                end
            end)

            local Underline = Instance.new("Frame")
            Underline.Name = "TextUnderline"
            Underline.Size = UDim2.new(0, 0, 0, 4)
            Underline.Position = UDim2.new(0.5, 0, 1, 10)
