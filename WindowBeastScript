-- PENYIMPANAN DATA KEY & KONTROL WAKTU
local keySaveFileName = "DarkGradient_KeySave.json"

local function saveKeyData(keyVal, durationHours)
    if not writefile then return end
    durationHours = tonumber(durationHours) or 24
    local expireTimestamp = os.time() + (durationHours * 3600)
    Library.CurrentKeyExpire = expireTimestamp
    local data = {
        Key = keyVal,
        Expire = expireTimestamp
    }
    pcall(function()
        writefile(keySaveFileName, HttpService:JSONEncode(data))
    end)
end

local function isKeySaveValid(allAllowedKeys)
    if not (readfile and isfile and isfile(keySaveFileName)) then return false end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(keySaveFileName))
    end)
    if success and type(result) == "table" and result.Expire and result.Key then
        if os.time() < tonumber(result.Expire) then
            for _, k in ipairs(allAllowedKeys) do
                if tostring(result.Key) == tostring(k) then
                    Library.CurrentKeyExpire = tonumber(result.Expire)
                    return true
                end
            end
        end
    end
    return false
end

