            Lbl.TextSize = 12
            Lbl.Font = Enum.Font.GothamBold
            Lbl.TextXAlignment = Enum.TextXAlignment.Center
            Lbl.Parent = LblFrame

            task.defer(updateGroupSize)
            return Lbl
        end

        task.defer(updateGroupSize)
        return Group
    end

