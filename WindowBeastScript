            task.wait(0.05)
            local targetWidth = math.max(BigText.TextBounds.X + 20, 180)

            TweenService:Create(Underline, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, targetWidth, 0, 4)
            }):Play()

            task.delay(10.0, function()
                local fadeTween = TweenService:Create(Flash, TweenInfo.new(0.5), {BackgroundTransparency = 1})
                TweenService:Create(BigText, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
