            BigText.Position = UDim2.new(0, 20, 0.5, -60)
            BigText.BackgroundTransparency = 1
            BigText.Text = ""
            BigText.TextColor3 = Color3.fromRGB(15, 15, 15)
            BigText.Font = Enum.Font.PermanentMarker
            BigText.TextSize = 72
            BigText.TextWrapped = true
            BigText.ZIndex = 1000000
            BigText.Parent = Flash

            task.spawn(function()
                for i = 1, #targetFlashText do
                    BigText.Text = string.sub(targetFlashText, 1, i)
                    task.wait(1)
                end
            end)

            local Underline = Instance.new("Frame")
            Underline.Name = "TextUnderline"
            Underline.Size = UDim2.new(0, 0, 0, 4)
            Underline.Position = UDim2.new(0.5, 0, 1, 10)
            Underline.AnchorPoint = Vector2.new(0.5, 0)
            Underline.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            Underline.BorderSizePixel = 0
            Underline.ZIndex = 1000001
            Underline.Parent = BigText

            local UnderlineCorner = Instance.new("UICorner")
            UnderlineCorner.CornerRadius = UDim.new(1, 0)
            UnderlineCorner.Parent = Underline

            task.wait(0.05)
            local targetWidth = math.max(BigText.TextBounds.X + 20, 180)

            TweenService:Create(Underline, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, targetWidth, 0, 4)
            }):Play()

            task.delay(10.0, function()
                local fadeTween = TweenService:Create(Flash, TweenInfo.new(0.5), {BackgroundTransparency = 1})
                TweenService:Create(BigText, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
                fadeTween:Play()
                fadeTween.Completed:Connect(function()
                    Flash:Destroy()
                    if onComplete then onComplete() end
                end)
            end)
        end
    end)
end

