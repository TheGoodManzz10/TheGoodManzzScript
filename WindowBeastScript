        local function updateGroupSize()
            local contentHeight = ContentLayout.AbsoluteContentSize.Y
            ContentHolder.Size = UDim2.new(1, -12, 0, contentHeight)
            local targetHeight = isCollapsed and 32 or (34 + contentHeight + 6)
            
            TweenService:Create(GroupFrame, TweenInfo.new(0.35, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetHeight)
            }):Play()
        end

        ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateGroupSize)

        GroupHeader.MouseButton1Click:Connect(function()
            isCollapsed = not isCollapsed
            ArrowLbl.Text = isCollapsed and "▼" or "▲"
            updateGroupSize()
        end)

        local Group = {}

        function Group:AddButton(text, icon, callback)
            local btn = createButton(ContentHolder, text, icon, callback)
            task.defer(updateGroupSize)
            return btn
        end

        function Group:AddToggle(text, icon, default, callback)
            local tog = createToggle(ContentHolder, text, icon, default, callback)
            task.defer(updateGroupSize)
            return tog
        end

        function Group:AddSlider(text, icon, min, max, default, callback)
            local sld = createSlider(ContentHolder, text, icon, min, max, default, callback)
            task.defer(updateGroupSize)
            return sld
        end

        function Group:AddLabel(text)
            local LblFrame = Instance.new("Frame")
            LblFrame.Size = UDim2.new(1, 0, 0, 28)
            LblFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
            LblFrame.Parent = ContentHolder

