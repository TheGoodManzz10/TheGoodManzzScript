    local function checkKey()
        local entered = KeyInput.Text
        local isValid = false
        local isSecret = false

        for _, sk in ipairs(secretKeys) do
            if entered == tostring(sk) then
                isValid = true
                isSecret = true
                break
            end
        end

        if not isValid then
            for _, k in ipairs(validKeys) do
                if entered == tostring(k) then
                    isValid = true
                    break
                end
            end
        end

        if isValid then
            local saveDuration = isSecret and 876000 or durationHours
            saveKeyData(entered, saveDuration)

            Library:Notify({
                Title = L("KeyTitle"),
                Content = L("KeyValid"),
                Type = "Success",
                Duration = 2
            })
            
            TweenService:Create(KeyFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 280, 0, 0),
                BackgroundTransparency = 1
            }):Play()

            task.wait(0.35)
            KeyFrame:Destroy()

            if onSuccess then onSuccess() end
        else
            Library:Notify({
                Title = L("KeyTitle"),
                Content = L("KeyInvalid"),
                Type = "Error",
                Duration = 3
            })
            TextStroke.Color = Color3.fromRGB(231, 76, 60)
            task.delay(1.5, function()
                TextStroke.Color = Color3.fromRGB(255, 255, 255)
            end)
        end
    end

    SubmitBtn.MouseButton1Click:Connect(checkKey)
end

