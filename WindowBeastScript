local function getIconId(icon)
    if not icon or type(icon) ~= "string" or icon == "" then return nil end
    if Library.Icons[icon] then
        return Library.Icons[icon]
    elseif not icon:find("rbxassetid://") and tonumber(icon) then
        return "rbxassetid://" .. icon
    end
    return icon
end

