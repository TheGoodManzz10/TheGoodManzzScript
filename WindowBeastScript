function Library:CreateWindow(config)
    config = config or {}
    local titleText = config.Name or "Dark Hub"
    local authorText = config.Author or "GoodManzz"
    local mainLogo = getIconId(config.Logo or "Logo")

    local text1 = config.Text1 or ("by:" .. authorText)
    local text2 = config.Text2 or "Injeksi Game"
    local text3 = config.Text3 or "Menyiapkan Ui"
    local flashText = config.FlashText or "GOODMANZ"

    -- KONFIGURASI KEY SYSTEM DARI LUAR
    local KeySystemConfig = config.KeySystem or {}
    local isKeySystemEnabled = KeySystemConfig.Enabled or false
    local validKeys = KeySystemConfig.Keys or { { Key = "GoodManzz2026", DurationDays = 365, DurationText = "Permanen" } }
    local keyGetUrl = KeySystemConfig.KeyURL or "https://discord.gg/yourlink"
    local saveFileName = "WindowBeastKey.json"

    local currentActiveKey = "Tidak ada"
    local currentKeyDurationText = "Tidak ada"
    local currentKeyExpiresTimestamp = 0

    local Window = {}

    -- HELPER UTAMA SAVE/READ KEY SYSTEM
    local function parseDurationSeconds(keyData)
        if keyData.DurationSeconds then return keyData.DurationSeconds end
        if keyData.DurationDays then return keyData.DurationDays * 86400 end
        return 86400 -- Default 1 Hari
    end

    local function checkSavedKeyValid()
        if readfile and isfile and isfile(saveFileName) then
            local success, content = pcall(function() return HttpService:JSONDecode(readfile(saveFileName)) end)
            if success and content and content.Key and content.Expires then
                if os.time() < content.Expires then
                    for _, k in ipairs(validKeys) do
                        if k.Key == content.Key then
                            currentActiveKey = content.Key
                            currentKeyDurationText = content.DurationText or "Aktif"
                            currentKeyExpiresTimestamp = content.Expires
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    local function saveKeyLocally(keyStr, durationSec, durText)
        if writefile then
            local expiresTime = os.time() + durationSec
            local saveData = {
                Key = keyStr,
                Expires = expiresTime,
                DurationText = durText
            }
            pcall(function() writefile(saveFileName, HttpService:JSONEncode(saveData)) end)
            currentActiveKey = keyStr
            currentKeyDurationText = durText
            currentKeyExpiresTimestamp = expiresTime
        end
    end

    -- ==========================================
    -- SISTEM KEY UI (AUTO SAVE & EXPIRE CHECK)
    -- ==========================================
    if isKeySystemEnabled then
        local isAlreadyValid = checkSavedKeyValid()

