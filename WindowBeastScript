end

local registeredTranslatables = {}
local function registerTranslation(element, key, prop)
    prop = prop or "Text"
    table.insert(registeredTranslatables, {Element = element, Key = key, Property = prop})
    element[prop] = L(key)
end

local function updateAllTranslations()
    for _, item in ipairs(registeredTranslatables) do
        if item.Element and item.Element.Parent then
            item.Element[item.Property] = L(item.Key)
        end
    end
end

