            for _, obj in ipairs(ScreenGui:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    obj.Font = enumFont
                end
            end
        end)
    end

    local ResizeGrip = Instance.new("Frame")
    ResizeGrip.Name = "ResizeGrip"
    ResizeGrip.Size = UDim2.new(0, 14, 0, 14)
    ResizeGrip.Position = UDim2.new(1, -14, 1, -14)
    ResizeGrip.BackgroundTransparency = 1
    ResizeGrip.Parent = Main

    local GripIcon = Instance.new("TextLabel")
    GripIcon.Size = UDim2.new(1, 0, 1, 0)
    GripIcon.BackgroundTransparency = 1
    GripIcon.Text = "◢"
    GripIcon.TextColor3 = Color3.fromRGB(150, 150, 160)
    GripIcon.TextSize = 10
    GripIcon.Font = Enum.Font.GothamBold
    GripIcon.Parent = ResizeGrip

    makeResizable(Main, ResizeGrip, 200, 150)

    function Window:EnableScroll(state)
        state = (state == nil) and true or state
        Container.ScrollingEnabled = state
        if not state then
            Container.CanvasPosition = Vector2.new(0, 0)
        end
    end

    function Window:SetScroll(state)
        Window:EnableScroll(state)
    end

    playRayfieldExecution(titleText, text1, text2, text3, flashText, function()
        TweenService:Create(Main, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 240, 0, 270)
        }):Play()

        Library:Notify({
            Title = titleText,
            Content = L("Executed"),
            Type = "Success",
            Duration = 3
        })
    end)

    local isMinimized = false
    local normalHeight = 270

    MinBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            normalHeight = Main.AbsoluteSize.Y
            Container.Visible = false
            SettingsContainer.Visible = false
            MinBtn.Image = Library.Icons["lucide-chevron-down"]
            
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, Main.AbsoluteSize.X, 0, 36)
            }):Play()
        else
            MinBtn.Image = Library.Icons["lucide-chevron-up"]
            
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, Main.AbsoluteSize.X, 0, normalHeight)
            }):Play()
            task.delay(0.2, function()
                Container.Visible = not showingSettings
                SettingsContainer.Visible = showingSettings
            end)
        end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        local closeTween = TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 240, 0, 0)
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            ScreenGui:Destroy()
        end)
    end)

    function Window:AddButton(text, icon, callback)
        return createButton(Container, text, icon, callback)
    end

    function Window:AddToggle(text, icon, default, callback)
        return createToggle(Container, text, icon, default, callback)
    end

    function Window:AddSlider(text, icon, min, max, default, callback)
        return createSlider(Container, text, icon, min, max, default, callback)
    end

    function Window:AddGroup(groupNameKey, icon, defaultCollapsed)
        return buildGroupInContainer(Container, groupNameKey, icon, defaultCollapsed)
    end

    Window.AddSection = Window.AddGroup

    return Window
end

return Library
