local function updateGlobalThemeColor(color)
    currentThemeColor = color
    isRgbThemeActive = false
    
    if mainWindowRef then
        if mainGradientRef then mainGradientRef.Enabled = false end
        mainWindowRef.BackgroundColor3 = color
    end

    for _, obj in ipairs(ScreenGui:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("ScrollingFrame") then
            if obj.Name ~= "NotifHolder" and obj.Name ~= "NotifCard" and obj.Name ~= "FloatingContainer" and obj.Name ~= "SpinOuterIcon" and obj.Name ~= "FloatingLogoBtn" and obj.Name ~= "ResizeGrip" and obj.Name ~= "KeyFrame" then
