    AuthorLbl.TextSize = 11
    AuthorLbl.TextXAlignment = Enum.TextXAlignment.Left
    AuthorLbl.Parent = Card

    local duration = 10.0
    local elapsed = 0
    local rotation = 0

    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        local progress = math.clamp(elapsed / duration, 0, 1)
        
        local speed = 120 + (progress ^ 3.5) * 4500 
        rotation = rotation + (speed * dt)
        RingGradient.Rotation = rotation % 360

        local dotCount = (math.floor(elapsed * 3) % 4) + 1
        local dots = string.rep(".", dotCount)

        if elapsed < 4.0 then
            AuthorLbl.Text = txt1
        elseif elapsed < 7.0 then
            AuthorLbl.Text = txt2 .. " " .. dots
        else
            AuthorLbl.Text = txt3 .. " " .. dots
        end

        if elapsed >= duration then
            conn:Disconnect()
            Card:Destroy()

            local Flash = Instance.new("Frame")
            Flash.Size = UDim2.new(1, 0, 1, 0)
            Flash.Position = UDim2.new(0, 0, 0, 0)
