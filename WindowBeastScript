    Instance.new("UICorner", SaveCustomBtn).CornerRadius = UDim.new(0, 6)

    SaveCustomBtn.MouseButton1Click:Connect(function()
        local customId = CustomTextBox.Text
        if customId ~= "" and tonumber(customId) then
            selectedSongId = customId
            NowPlayingLbl.Text = "Lagu Aktif: Custom (" .. customId .. ")"
            playSelectedMusic()
            Library:Notify({ Title = "Musik", Content = "ID Lagu " .. customId .. " disimpan & diputar!", Type = "Success" })
        else
            Library:Notify({ Title = "Musik", Content = "ID Lagu tidak valid!", Type = "Error" })
        end
    end)

    -- ==========================================
    -- PENGATURAN LAINNYA (Dengan Icon Lucide Pilihan)
    -- ==========================================
    local TimerGroup = buildGroupInContainer(SettingsContainer, L("KeyTimerTitle"), "lucide-key", false)
    local TimerLabel = TimerGroup:AddLabel("Calculating...")

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            if Library.CurrentKeyExpire then
                local diff = Library.CurrentKeyExpire - os.time()
                if diff > 800000 * 3600 then
                    TimerLabel.Text = "Infinity / Permanen"
                    TimerLabel.TextColor3 = Color3.fromRGB(155, 89, 182)
                elseif diff <= 0 then
                    TimerLabel.Text = "Expired / Kadaluarsa"
                    TimerLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
                else
                    local hours = math.floor(diff / 3600)
                    local mins = math.floor((diff % 3600) / 60)
                    local secs = math.floor(diff % 60)
                    TimerLabel.Text = string.format("%02d Jam %02d Mnt %02d Detik", hours, mins, secs)
                    TimerLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
                end
            else
                TimerLabel.Text = L("NoKeyActive")
                TimerLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
            end
            task.wait(1)
        end
    end)

    local TransGroup = buildGroupInContainer(SettingsContainer, L("UITrans"), "lucide-sliders", false)
    TransGroup:AddSlider(L("BGTrans"), nil, 1, 100, 1, function(val)
        Main.BackgroundTransparency = val / 100
    end)

