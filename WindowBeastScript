    local function performScriptbloxSearch(query)
        for _, child in ipairs(ResultsHolder:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        if query == "" then return end
        Library:Notify({ Title = "Scriptblox", Content = "Mencari: " .. query .. "...", Type = "Info" })

        task.spawn(function()
            pcall(function()
                local url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query)
                local response = game:HttpGet(url)
                local data = HttpService:JSONDecode(response)

                if data and data.result and data.result.scripts and #data.result.scripts > 0 then
                    for i, item in ipairs(data.result.scripts) do
                        if i > scriptbloxLimit then break end

                        local scriptTitle = item.title or "No Title"
                        local rawScript = item.script or ""

                        local Card = Instance.new("Frame")
                        Card.Size = UDim2.new(1, 0, 0, 50)
                        Card.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
                        Card.Parent = ResultsHolder
                        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)

                        local TitleLbl = Instance.new("TextLabel")
                        TitleLbl.Size = UDim2.new(1, -12, 0, 20)
                        TitleLbl.Position = UDim2.new(0, 6, 0, 4)
                        TitleLbl.BackgroundTransparency = 1
                        TitleLbl.Text = scriptTitle
                        TitleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        TitleLbl.TextSize = 10
                        TitleLbl.Font = Enum.Font.GothamBold
                        TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
                        TitleLbl.TextTruncate = Enum.TextTruncate.AtEnd
                        TitleLbl.Parent = Card

                        local ExecBtn = Instance.new("TextButton")
                        ExecBtn.Size = UDim2.new(0.48, -4, 0, 20)
                        ExecBtn.Position = UDim2.new(0, 6, 0, 25)
                        ExecBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                        ExecBtn.Text = "Execute"
                        ExecBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        ExecBtn.TextSize = 10
                        ExecBtn.Font = Enum.Font.GothamBold
                        ExecBtn.Parent = Card
                        Instance.new("UICorner", ExecBtn).CornerRadius = UDim.new(0, 4)

                        local CopyBtn = Instance.new("TextButton")
                        CopyBtn.Size = UDim2.new(0.48, -4, 0, 20)
                        CopyBtn.Position = UDim2.new(0.52, 0, 0, 25)
                        CopyBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
                        CopyBtn.Text = "Copy Script"
                        CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        CopyBtn.TextSize = 10
                        CopyBtn.Font = Enum.Font.GothamBold
                        CopyBtn.Parent = Card
                        Instance.new("UICorner", CopyBtn).CornerRadius = UDim.new(0, 4)

                        ExecBtn.MouseButton1Click:Connect(function()
                            Library:Notify({ Title = "Scriptblox", Content = "Menjalankan: " .. scriptTitle, Type = "Info" })
                            task.spawn(function()
                                pcall(function() loadstring(rawScript)() end)
                            end)
                        end)

                        CopyBtn.MouseButton1Click:Connect(function()
                            if setclipboard then
                                setclipboard(rawScript)
                                Library:Notify({ Title = "Scriptblox", Content = "Script disalin ke Clipboard!", Type = "Success" })
                            else
                                Library:Notify({ Title = "Scriptblox", Content = "Executor tidak mendukung setclipboard", Type = "Error" })
                            end
                        end)
                    end
                else
                    Library:Notify({ Title = "Scriptblox", Content = "Script tidak ditemukan!", Type = "Warning" })
                end
            end)
        end)
    end

