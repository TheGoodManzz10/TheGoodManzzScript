    end
    
    local statusEng = state and "Enabled" or "Disabled"
    local statusIndo = state and "Aktif" or "Nonaktif"
    Library:Notify({ Title = "Loop Music / Ulangi Musik", Content = statusEng .. " / " .. statusIndo, Type = "Info", Duration = 2 })
end)

