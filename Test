		PerfText.TextSize = 10
		PerfText.TextXAlignment = Enum.TextXAlignment.Left
		PerfText.ZIndex = 151

		local lastUpdate = os.clock()
		local frameCount = 0

		TrackConnection(RunService.RenderStepped:Connect(function()
			frameCount = frameCount + 1
			local now = os.clock()
			if now - lastUpdate >= 1 then
