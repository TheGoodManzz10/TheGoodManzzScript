		function TabObj:AddTabStepSlider(sliderName, min, max, step, default, callback)
			step = (step and step > 0) and step or 1
			min = min or 0
			max = max or 100
			default = math.clamp(default or min, min, max)

			local Frame = Instance.new("Frame")
			Frame.Parent = TabContent
			Frame.BackgroundColor3 = Color3.fromRGB(26, 26, 38)
			Frame.Size = UDim2.new(1, 0, 0, 48)
			Frame.ZIndex = 22

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 6)
			Corner.Parent = Frame

			local Label = Instance.new("TextLabel")
			Label.Parent = Frame
			Label.BackgroundTransparency = 1
			Label.Position = UDim2.new(0, 10, 0, 4)
			Label.Size = UDim2.new(1, -20, 0, 16)
			Label.Font = Enum.Font.Gotham
			Label.Text = sliderName .. " : " .. tostring(default)
			Label.TextColor3 = Color3.fromRGB(240, 240, 250)
			Label.TextSize = 11
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = 23

			local SliderBar = Instance.new("Frame")
			SliderBar.Parent = Frame
			SliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
			SliderBar.Position = UDim2.new(0, 10, 0, 28)
			SliderBar.Size = UDim2.new(1, -20, 0, 5)
			SliderBar.ZIndex = 23

			local BarCorner = Instance.new("UICorner")
			BarCorner.CornerRadius = UDim.new(1, 0)
			BarCorner.Parent = SliderBar

			local range = (max - min) == 0 and 1 or (max - min)
			local initialRatio = (default - min) / range

			local Fill = Instance.new("Frame")
			Fill.Parent = SliderBar
			Fill.BackgroundColor3 = currentTextThemeColor
			Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
			Fill.ZIndex = 24

			local FillCorner = Instance.new("UICorner")
			FillCorner.CornerRadius = UDim.new(1, 0)
			FillCorner.Parent = Fill

			local Knob = Instance.new("Frame")
			Knob.Parent = SliderBar
			Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Knob.Position = UDim2.new(initialRatio, -7, 0.5, -7)
			Knob.Size = UDim2.new(0, 14, 0, 14)
			Knob.ZIndex = 25

			local KnobCorner = Instance.new("UICorner")
			KnobCorner.CornerRadius = UDim.new(1, 0)
			KnobCorner.Parent = Knob

			OnThemeChanged(function(col)
				Fill.BackgroundColor3 = col
			end)

			local sliding = false
			local function update(input)
				local barWidth = math.max(SliderBar.AbsoluteSize.X, 1)
				local rawPos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / barWidth, 0, 1)
				local rawVal = min + (range * rawPos)
				local steppedVal = math.floor((rawVal / step) + 0.5) * step
				steppedVal = math.clamp(steppedVal, min, max)
				local finalRatio = (steppedVal - min) / range
				Fill.Size = UDim2.new(finalRatio, 0, 1, 0)
				Knob.Position = UDim2.new(finalRatio, -7, 0.5, -7)
				Label.Text = sliderName .. " : " .. tostring(steppedVal)
				if callback then
					pcall(callback, steppedVal)
				end
			end

			TrackConnection(Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end))
			TrackConnection(SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					update(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					update(input)
				end
			end))
		end

