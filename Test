function AetherLib:Unload()
	for _, conn in ipairs(AetherLib.Connections) do
		if conn and conn.Connected then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	AetherLib.Connections = {}

	for _, inst in ipairs(AetherLib.Instances) do
		if inst then
			pcall(function()
				inst:Destroy()
			end)
		end
	end
	AetherLib.Instances = {}
	AetherLib.RegisteredCommands = {}
end

return AetherLib
