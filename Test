function AetherLib:Unload()
    for _, conn in ipairs(AetherLib.Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    AetherLib.Connections = {}

    for _, inst in ipairs(AetherLib.Instances) do
        if inst then inst:Destroy() end
    end
    AetherLib.Instances = {}
end

return AetherLib
