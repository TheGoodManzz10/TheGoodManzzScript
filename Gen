		Label.Text = name .. " : " .. tostring(default)
		Label.TextColor3 = currentTextThemeColor
		Label.TextSize = 12
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.ZIndex = 10

		local SliderBar = Instance.new("Frame")
		SliderBar.Parent = SliderFrame
		SliderBar.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		SliderBar.Position = UDim2.new(0, 12, 0, 32)
		SliderBar.Size = UDim2.new(1, -24, 0, 5)
		SliderBar.ZIndex = 10

		local BarCorner = Instance.new("UICorner")
		BarCorner.CornerRadius = UDim.new(1, 0)
		BarCorner.Parent = SliderBar

		local range = (max - min) == 0 and 1 or (max - min)
		local initialRatio = (default - min) / range

		local Fill = Instance.new("Frame")
		Fill.Parent = SliderBar
		Fill.BackgroundColor3 = currentAccentColor
		Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
		Fill.ZIndex = 11

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(1, 0)
		FillCorner.Parent = Fill

		local Knob = Instance.new("Frame")
		Knob.Parent = SliderBar
		Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		Knob.Position = UDim2.new(initialRatio, -8, 0.5, -8)
		Knob.Size = UDim2.new(0, 16, 0, 16)
		Knob.ZIndex = 12

		local KnobCorner = Instance.new("UICorner")
		KnobCorner.CornerRadius = UDim.new(1, 0)
		KnobCorner.Parent = Knob

		OnAccentChanged(function(col)
			Fill.BackgroundColor3 = col
		end)

		local sliding = false
		local function update(input)
			local barWidth = math.max(SliderBar.AbsoluteSize.X, 1)
			local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / barWidth, 0, 1)
			local val = math.floor(min + ((max - min) * pos))
			Fill.Size = UDim2.new(pos, 0, 1, 0)
			Knob.Position = UDim2.new(pos, -8, 0.5, -8)
			Label.Text = name .. " : " .. tostring(val)
			if callback then
				pcall(callback, val)
			end
		end

		TrackConnection(Knob.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
			end
		end))
		TrackConnection(SliderBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				update(input)
			end
		end))
		TrackConnection(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end))
		TrackConnection(UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update(input)
			end
		end))
	end

