			SLabel.TextColor3 = currentTextThemeColor
			SLabel.TextSize = 10
			SLabel.TextXAlignment = Enum.TextXAlignment.Left
			SLabel.ZIndex = 10

			local SBar = Instance.new("Frame")
			SBar.Parent = PickerFrame
			SBar.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
			SBar.Position = UDim2.new(0, 45, 0, posY + 5)
			SBar.Size = UDim2.new(1, -60, 0, 6)
			SBar.ZIndex = 10

			local SBarCorner = Instance.new("UICorner")
			SBarCorner.CornerRadius = UDim.new(1, 0)
			SBarCorner.Parent = SBar

			local SFill = Instance.new("Frame")
			SFill.Parent = SBar
			SFill.BackgroundColor3 = channelName == "R" and Color3.fromRGB(255, 50, 50)
				or (channelName == "G" and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(50, 100, 255))
			SFill.Size = UDim2.new(initVal / 255, 0, 1, 0)
			SFill.ZIndex = 11

			local SFillCorner = Instance.new("UICorner")
			SFillCorner.CornerRadius = UDim.new(1, 0)
			SFillCorner.Parent = SFill

			local sliding = false
			local function updateChannel(input)
				local barWidth = math.max(SBar.AbsoluteSize.X, 1)
				local pos = math.clamp((input.Position.X - SBar.AbsolutePosition.X) / barWidth, 0, 1)
				local val = math.floor(pos * 255)
				SFill.Size = UDim2.new(pos, 0, 1, 0)
				onUpdate(val)
			end

			TrackConnection(SBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					updateChannel(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateChannel(input)
				end
			end))
		end

		CreateMiniSlider(28, "R", r, function(val)
			r = val
			local newCol = Color3.fromRGB(r, g, b)
			PreviewBox.BackgroundColor3 = newCol
			if callback then
				pcall(callback, newCol)
			end
		end)
		CreateMiniSlider(48, "G", g, function(val)
			g = val
			local newCol = Color3.fromRGB(r, g, b)
			PreviewBox.BackgroundColor3 = newCol
			if callback then
				pcall(callback, newCol)
			end
		end)
		CreateMiniSlider(68, "B", b, function(val)
			b = val
			local newCol = Color3.fromRGB(r, g, b)
			PreviewBox.BackgroundColor3 = newCol
			if callback then
				pcall(callback, newCol)
			end
		end)
	end

