			checked = newState
			CheckBoxBtn.Text = checked and "✓" or ""
			local goalBg = checked and currentAccentColor or Color3.fromRGB(26, 26, 36)
			local goalStroke = checked and currentAccentColor or Color3.fromRGB(75, 75, 95)
			TweenService:Create(CheckBoxBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				BackgroundColor3 = goalBg
			}):Play()
			TweenService:Create(CBStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Color = goalStroke
			}):Play()
			if triggerCb and callback then
				pcall(callback, checked)
			end
		end

		TrackConnection(CheckBoxBtn.MouseButton1Click:Connect(function()
			SetState(not checked, true)
		end))

