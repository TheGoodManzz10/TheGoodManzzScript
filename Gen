-- Fitur Baru v15.5: Curves (Khusus UI ke-3 Aether Nova)
function Elements:Curves(radius)
    radius = radius or 24
    if StarlightCorner then
        TweenService:Create(StarlightCorner, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            CornerRadius = UDim.new(0, radius)
        }):Play()
    end
    if NTBCorner then
        TweenService:Create(NTBCorner, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            CornerRadius = UDim.new(0, math.floor(radius * 0.5))
        }):Play()
    end
end

	return Elements
end

function AetherLib:Unload()
	for _, conn in ipairs(AetherLib.Connections) do
		if conn and conn.Connected then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	AetherLib.Connections = {}

	for _, inst in ipairs(AetherLib.Instances) do
		if inst then
			pcall(function()
				inst:Destroy()
			end)
		end
	end
	AetherLib.Instances = {}
	AetherLib.RegisteredCommands = {}
end

return AetherLib
