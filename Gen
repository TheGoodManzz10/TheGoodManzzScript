	-- REGISTRASI DAN EKSEKUSI PERINTAH
	-------------------------------------------------------------------
	function AetherLib:RegisterCommand(name, description, syntax, callback)
		name = string.lower(name)
		AetherLib.RegisteredCommands[name] = {
			Desc = description or "Tidak ada deskripsi",
			Syntax = syntax or name,
			Callback = callback
		}
		RefreshCommandList()
	end

	function Elements:AddCommand(name, description, syntax, callback)
		AetherLib:RegisterCommand(name, description, syntax, callback)
	end

	TrackConnection(CmdBar.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			local text = CmdBar.Text
			if text:sub(1, 1) == ";" then
				text = text:sub(2)
			end
			if text ~= "" then
				local parts = {}
				for word in text:gmatch("%S+") do
					table.insert(parts, word)
				end
				local cmdName = string.lower(parts[1] or "")
				table.remove(parts, 1)

				if AetherLib.RegisteredCommands[cmdName] then
					local success, err = pcall(function()
						AetherLib.RegisteredCommands[cmdName].Callback(parts)
					end)
					if success then
						Elements:AddNotification("Command", "Mengeksekusi: ;" .. cmdName, 2)
					else
						Elements:AddNotification("Command Error", tostring(err), 3)
					end
				else
					Elements:AddNotification("Command", "Perintah ';" .. cmdName .. "' tidak ditemukan!", 2)
				end
				CmdBar.Text = ""
			end
		end
	end))

