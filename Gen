			local Preview = Instance.new("Frame")
			Preview.Parent = Frame
			Preview.BackgroundColor3 = defaultColor
			Preview.Position = UDim2.new(1, -36, 0, 6)
			Preview.Size = UDim2.new(0, 26, 0, 18)
			Preview.ZIndex = 24

			local PCorner = Instance.new("UICorner")
			PCorner.CornerRadius = UDim.new(0, 4)
			PCorner.Parent = Preview

			local r = math.floor(defaultColor.R * 255)
			local g = math.floor(defaultColor.G * 255)
			local b = math.floor(defaultColor.B * 255)

			local function MakeMiniSlider(posY, chan, val, onUpd)
				local SLbl = Instance.new("TextLabel")
				SLbl.Parent = Frame
				SLbl.BackgroundTransparency = 1
				SLbl.Position = UDim2.new(0, 10, 0, posY)
				SLbl.Size = UDim2.new(0, 20, 0, 14)
				SLbl.Font = currentFontRegular
				SLbl.Text = chan
				SLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
				SLbl.TextSize = 9
				SLbl.ZIndex = 24

				local SBar = Instance.new("Frame")
				SBar.Parent = Frame
				SBar.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
				SBar.Position = UDim2.new(0, 32, 0, posY + 4)
				SBar.Size = UDim2.new(1, -44, 0, 6)
				SBar.ZIndex = 24

				local SBC = Instance.new("UICorner")
				SBC.CornerRadius = UDim.new(1, 0)
				SBC.Parent = SBar

				local SFill = Instance.new("Frame")
				SFill.Parent = SBar
				SFill.BackgroundColor3 = chan == "R" and Color3.fromRGB(255, 50, 50)
					or (chan == "G" and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(50, 100, 255))
				SFill.Size = UDim2.new(val / 255, 0, 1, 0)
				SFill.ZIndex = 25

				local SFC = Instance.new("UICorner")
				SFC.CornerRadius = UDim.new(1, 0)
				SFC.Parent = SFill

				local sliding = false
				local function updateChannel(input)
					local barWidth = math.max(SBar.AbsoluteSize.X, 1)
					local pos = math.clamp((input.Position.X - SBar.AbsolutePosition.X) / barWidth, 0, 1)
					local v = math.floor(pos * 255)
					SFill.Size = UDim2.new(pos, 0, 1, 0)
					onUpd(v)
				end

				TrackConnection(SBar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = true
						updateChannel(input)
					end
				end))
				TrackConnection(UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = false
					end
				end))
				TrackConnection(UserInputService.InputChanged:Connect(function(input)
					if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						updateChannel(input)
					end
				end))
			end

			MakeMiniSlider(28, "R", r, function(v)
				r = v
				local c = Color3.fromRGB(r, g, b)
				Preview.BackgroundColor3 = c
				if callback then
					pcall(callback, c)
				end
			end)
			MakeMiniSlider(46, "G", g, function(v)
				g = v
				local c = Color3.fromRGB(r, g, b)
				Preview.BackgroundColor3 = c
				if callback then
					pcall(callback, c)
				end
			end)
			MakeMiniSlider(64, "B", b, function(v)
				b = v
				local c = Color3.fromRGB(r, g, b)
				Preview.BackgroundColor3 = c
				if callback then
					pcall(callback, c)
				end
			end)
		end

