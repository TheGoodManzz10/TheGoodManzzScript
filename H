    function window:ApplyThemeLive()
        for i = #self.ThemedObjects, 1, -1 do
            local entry = self.ThemedObjects[i]
            if entry.Instance and entry.Instance.Parent then
                local targetVal = self.Theme[entry.Role]
                if targetVal ~= nil then
                    pcall(function()
                        entry.Instance[entry.Property] = targetVal
                    end)
                end
            else
                table.remove(self.ThemedObjects, i)
            end
        end
        for _, fn in ipairs(self.ThemeRefreshCallbacks) do
            pcall(fn)
        end
        if self.BgImageLabel then
            local resolvedBg = Env.GetCustomAsset(self.Theme.BgAsset)
            self.BgImageLabel.Image = resolvedBg or ""
            self.BgImageLabel.ImageTransparency = self.Theme.BgOpacity or 0.85
            self.BgImageLabel.Visible = (resolvedBg ~= nil and resolvedBg ~= "")
        end
