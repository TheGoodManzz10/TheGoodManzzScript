            Util.Tween(activePill, Util.TweenBackOut, {
                Position = UDim2.fromOffset(4, math.max(12, relY)),
            })
        end

        self:TrackConnection(tabBtn.MouseButton1Click:Connect(function()
            tabObj:Activate()
        end))

        table.insert(self.Tabs, tabObj)
        if #self.Tabs == 1 then
            task.defer(function()
                tabObj:Activate()
            end)
        end

        return tabObj
    end

