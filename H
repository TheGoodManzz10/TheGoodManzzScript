    -- FAB Edge-Snapping & Dragging Logic
    do
        local draggingFab = false
        local fabStartInput = Vector2.zero
        local fabStartPos = Vector2.zero
        local movedDistance = 0

        local function SnapFabToNearestEdge()
            local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
            local absCenter = fabButton.AbsolutePosition + (fabButton.AbsoluteSize * 0.5)
            local padding = 18
            local targetX = (absCenter.X < vp.X * 0.5) and padding or (vp.X - fabSize - padding)
            local clampedY = math.clamp(absCenter.Y, fabSize * 0.5 + padding, vp.Y - fabSize * 0.5 - padding)

            Util.Tween(fabButton, Util.TweenBackOut, {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.fromOffset(targetX, clampedY),
            })
        end

        window:TrackConnection(fabButton.InputBegan:Connect(function(input: InputObject)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingFab = true
                movedDistance = 0
                fabStartInput = Vector2.new(input.Position.X, input.Position.Y)
                fabStartPos = Vector2.new(fabButton.AbsolutePosition.X, fabButton.AbsolutePosition.Y + fabButton.AbsoluteSize.Y * 0.5)
                Util.Tween(fabButton, Util.TweenQuadOutFast, { BackgroundTransparency = 0.02 })
            end
        end))

        window:TrackConnection(UserInputService.InputChanged:Connect(function(input: InputObject)
            if draggingFab and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local curr = Vector2.new(input.Position.X, input.Position.Y)
                local delta = curr - fabStartInput
                movedDistance = delta.Magnitude
                fabButton.AnchorPoint = Vector2.new(0, 0.5)
                fabButton.Position = UDim2.fromOffset(fabStartPos.X + delta.X, fabStartPos.Y + delta.Y)
            end
        end))

        window:TrackConnection(UserInputService.InputEnded:Connect(function(input: InputObject)
            if draggingFab and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                draggingFab = false
                Util.Tween(fabButton, Util.TweenQuadOutFast, { BackgroundTransparency = fabIdleTrans })
                if movedDistance < 6 then
                    window:ToggleVisibility()
                else
                    SnapFabToNearestEdge()
                end
            end
        end))
    end

    function window:ToggleVisibility(forceState: boolean?)
        if forceState ~= nil then
            self.IsVisible = forceState
        else
            self.IsVisible = not self.IsVisible
        end

        if self.IsVisible then
            mainWin.Visible = true
            winScale.Scale = 0.92
            mainWin.BackgroundTransparency = 0.4
            Util.Tween(winScale, Util.TweenBackOut, { Scale = 1 })
            Util.Tween(mainWin, Util.TweenQuadOutMed, { BackgroundTransparency = 0.05 })
            if fabAutoHide and fabEnabled then
                fabButton.Visible = false
            end
        else
            local tw = Util.Tween(winScale, Util.TweenQuadOutFast, { Scale = 0.92 })
            Util.Tween(mainWin, Util.TweenQuadOutFast, { BackgroundTransparency = 1 })
            if fabEnabled then
                fabButton.Visible = true
            end
            task.delay(0.18, function()
                if not self.IsVisible and mainWin and mainWin.Parent then
                    mainWin.Visible = false
                end
            end)
            return tw
        end
    end

