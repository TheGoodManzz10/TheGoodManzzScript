function IconEngine:Resolve(iconInput: any): { Image: string, ImageRectSize: Vector2, ImageRectOffset: Vector2 }
    if not iconInput or iconInput == "" then
        return {
            Image = "",
            ImageRectSize = Vector2.zero,
            ImageRectOffset = Vector2.zero,
        }
    end

    if typeof(iconInput) == "number" then
        return {
            Image = "rbxassetid://" .. tostring(iconInput),
            ImageRectSize = Vector2.zero,
            ImageRectOffset = Vector2.zero,
        }
    end

    if typeof(iconInput) == "string" then
        local trimmed = string.lower(string.gsub(iconInput, "^%s*(.-)%s*$", "%1"))
        if string.sub(trimmed, 1, 13) == "rbxassetid://" or string.sub(trimmed, 1, 6) == "rbx://" then
            return {
                Image = iconInput,
                ImageRectSize = Vector2.zero,
                ImageRectOffset = Vector2.zero,
            }
        end
        if tonumber(trimmed) then
            return {
                Image = "rbxassetid://" .. trimmed,
                ImageRectSize = Vector2.zero,
                ImageRectOffset = Vector2.zero,
            }
        end
        local mapped = self.Registry[trimmed]
        if mapped then
            return {
                Image = mapped.Image,
                ImageRectSize = mapped.ImageRectSize or Vector2.zero,
                ImageRectOffset = mapped.ImageRectOffset or Vector2.zero,
            }
        end
        local customAsset = Env.GetCustomAsset(iconInput)
        if customAsset then
            return {
                Image = customAsset,
                ImageRectSize = Vector2.zero,
                ImageRectOffset = Vector2.zero,
            }
        end
    end

    return {
        Image = "rbxassetid://10734966248",
        ImageRectSize = Vector2.zero,
        ImageRectOffset = Vector2.zero,
    }
end

function IconEngine:ApplyToImageLabel(imageLabel: ImageLabel | ImageButton, iconInput: any)
    local resolved = self:Resolve(iconInput)
    imageLabel.Image = resolved.Image
    imageLabel.ImageRectSize = resolved.ImageRectSize
    imageLabel.ImageRectOffset = resolved.ImageRectOffset
    imageLabel.Visible = (resolved.Image ~= "")
end

