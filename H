            Util.Tween(tabBtn, Util.TweenQuadOutFast, {
                BackgroundColor3 = window.Theme.SurfaceAlt,
                BackgroundTransparency = 0.25,
            })
            Util.Tween(tabTitle, Util.TweenQuadOutFast, { TextColor3 = window.Theme.TextPrimary })
            Util.Tween(tabIcon, Util.TweenQuadOutFast, { ImageColor3 = window.Theme.Accent })

            -- Move Active Pill Indicator with Back/Out Tween
