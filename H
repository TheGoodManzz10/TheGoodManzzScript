-- Safe Executor Environment Wrappers (pcall protected)
local Env = {}

function Env.GetGuiParent(): Instance
    local ok, res = pcall(function()
        if gethui then
            return gethui()
        end
        return CoreGui
    end)
    if ok and res then
        return res
    end
    return LocalPlayer and LocalPlayer:WaitForChild("PlayerGui") or CoreGui
end

function Env.WriteFile(path: string, content: string): boolean
    if typeof(writefile) == "function" then
        local ok = pcall(writefile, path, content)
        return ok
    end
    return false
end

function Env.ReadFile(path: string): (boolean, string?)
    if typeof(readfile) == "function" then
        local ok, data = pcall(readfile, path)
        if ok then
            return true, data
        end
    end
    return false, nil
end

function Env.IsFile(path: string): boolean
    if typeof(isfile) == "function" then
        local ok, res = pcall(isfile, path)
        return ok and res == true
    end
    return false
end

function Env.IsFolder(path: string): boolean
    if typeof(isfolder) == "function" then
        local ok, res = pcall(isfolder, path)
        return ok and res == true
    end
    return false
end

function Env.MakeFolder(path: string): boolean
    if typeof(makefolder) == "function" then
        local ok = pcall(makefolder, path)
        return ok
    end
    return false
end

function Env.GetCustomAsset(path: string): string?
    if not path or path == "" then
        return nil
    end
    if string.sub(path, 1, 13) == "rbxassetid://" or string.sub(path, 1, 6) == "rbx://" then
        return path
    end
    local assetFn = getcustomasset or getsynasset
    if typeof(assetFn) == "function" and Env.IsFile(path) then
        local ok, assetId = pcall(assetFn, path)
        if ok and typeof(assetId) == "string" then
            return assetId
        end
    end
    -- Fallback check using readfile verification
    if Env.IsFile(path) then
        local okRead, _ = Env.ReadFile(path)
        if okRead and typeof(assetFn) == "function" then
            local ok2, assetId2 = pcall(assetFn, path)
            if ok2 then
                return assetId2
            end
        end
    end
    return nil
end

function Env.SetClipboard(text: string): boolean
    local clipFn = setclipboard or toclipboard or set_clipboard
    if typeof(clipFn) == "function" then
        local ok = pcall(clipFn, tostring(text))
        return ok
    end
    return false
end

function Env.GetExecutorName(): string
    if typeof(identifyexecutor) == "function" then
        local ok, name, ver = pcall(identifyexecutor)
        if ok and name then
            return tostring(name) .. (ver and (" " .. tostring(ver)) or "")
        end
    elseif typeof(getexecutorname) == "function" then
        local ok, name = pcall(getexecutorname)
        if ok and name then
            return tostring(name)
        end
    end
    return "Standard Luau VM"
end

