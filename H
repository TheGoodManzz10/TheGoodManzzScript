-- [6] BUILT-IN BACKGROUND AUDIO PLAYER (MUSIC CONTROLLER ENGINE)
-- ============================================================================
local AudioController = {}
AudioController.__index = AudioController

function AudioController.new(parentContainer: Instance)
    local self = setmetatable({}, AudioController)
    self.TrackTitle = "No Track Loaded"
    self.CurrentSource = ""
    self.IsPlaying = false
    self.IsPaused = false
    self.LoopEnabled = true
    self.Volume = 0.5

    local soundParent = SoundService
    pcall(function()
        if parentContainer then
            soundParent = parentContainer
        end
    end)

    self.Sound = Util.Create("Sound", {
        Name = "Silentx_AudioEngine",
        Volume = self.Volume,
        Looped = self.LoopEnabled,
        Parent = soundParent,
    })

    return self
end

function AudioController:ResolveAudioAsset(source: string): string?
    if not source or source == "" then
        return nil
    end
    if tonumber(source) then
        return "rbxassetid://" .. tostring(source)
    end
    if string.sub(source, 1, 13) == "rbxassetid://" or string.sub(source, 1, 6) == "rbx://" then
        return source
    end
    return Env.GetCustomAsset(source)
end

function AudioController:LoadTrack(source: string, title: string?): boolean
    local resolved = self:ResolveAudioAsset(source)
    if not resolved then
        return false
    end
    self.CurrentSource = resolved
    self.TrackTitle = title or tostring(source)
    self.Sound.SoundId = resolved
    return true
end

function AudioController:Play(source: string?, title: string?)
    if source and source ~= "" then
        self:LoadTrack(source, title)
    end
    if self.Sound.SoundId ~= "" then
        self.Sound:Play()
        self.IsPlaying = true
        self.IsPaused = false
    end
end

function AudioController:Pause()
    if self.Sound.IsPlaying then
        self.Sound:Pause()
        self.IsPlaying = false
        self.IsPaused = true
    end
end

function AudioController:Resume()
    if self.IsPaused or not self.Sound.IsPlaying then
        self.Sound:Resume()
        self.IsPlaying = true
        self.IsPaused = false
    end
end

function AudioController:Stop()
    self.Sound:Stop()
    self.IsPlaying = false
    self.IsPaused = false
end

function AudioController:SetVolume(volPercent: number)
    local clamped = math.clamp(volPercent, 0, 100)
    self.Volume = clamped / 100
    self.Sound.Volume = self.Volume
end

function AudioController:SetLoop(state: boolean)
    self.LoopEnabled = state
    self.Sound.Looped = state
end

function AudioController:GetPlaybackStatus(): (string, number, number)
    local pos = self.Sound.TimePosition or 0
    local len = self.Sound.TimeLength or 0
    local status = "Stopped"
    if self.Sound.IsPlaying then
        status = "Playing"
    elseif self.IsPaused then
        status = "Paused"
    end
    return status, pos, len
end

function AudioController:Destroy()
    if self.Sound then
        pcall(function()
            self.Sound:Stop()
            self.Sound:Destroy()
        end)
        self.Sound = nil
    end
end

