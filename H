local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(folderName: string?, fileName: string?)
    local self = setmetatable({}, ConfigManager)
    self.Folder = folderName or "Silentx_Workspace"
    self.FilePath = self.Folder .. "/" .. (fileName or "Silentx_Config_v1.json")

    if not Env.IsFolder(self.Folder) then
        Env.MakeFolder(self.Folder)
    end
    return self
end

function ConfigManager:Save(dataTable: { [string]: any }): boolean
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(dataTable)
    end)
    if ok and encoded then
        return Env.WriteFile(self.FilePath, encoded)
    end
    return false
end

function ConfigManager:Load(): { [string]: any }?
    if not Env.IsFile(self.FilePath) then
        return nil
    end
    local okRead, content = Env.ReadFile(self.FilePath)
    if okRead and content and #content > 0 then
        local okDecode, decoded = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if okDecode and typeof(decoded) == "table" then
            return decoded
        end
    end
    return nil
end

