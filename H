    accordion.Window = self.Window
    accordion.Expanded = (config.DefaultOpen == true)

    local card = self:CreateCardFrame(42, "AccordionComponent")
    card.ClipsDescendants = true

    local header = Util.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 42),
