    self.Window:RegisterThemedObject(hexBox, "SurfaceAlt", "BackgroundColor3")
    self.Window:RegisterThemedObject(hexBox, "TextPrimary", "TextColor3")

    local bigSwatch = Util.Create("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 36),
        Size = UDim2.fromOffset(98, 90),
        BackgroundColor3 = defaultColor,
        BorderSizePixel = 0,
        Parent = pickerBody,
    })
    Util.AddCorner(bigSwatch, 8)
    Util.AddStroke(bigSwatch, self.Window.Theme.Border, 1, 0.3)

    local function RefreshColor(silent: boolean?)
        local col = Color3.fromHSV(h, s, v)
        comp.Value = col
        local hex = ColorToHex(col)
        svCanvas.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        previewBtn.BackgroundColor3 = col
        bigSwatch.BackgroundColor3 = col
        hexBox.Text = hex
        if not silent and typeof(config.Callback) == "function" then
            task.spawn(config.Callback, col, hex)
        end
    end

    function comp:SetValue(newColor: Color3, silent: boolean?)
        h, s, v = newColor:ToHSV()
        RefreshColor(silent)
    end

    local draggingSV = false
    local draggingHue = false

    comp:BindConnection(svCanvas.InputBegan, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            local relX = math.clamp((input.Position.X - svCanvas.AbsolutePosition.X) / math.max(1, svCanvas.AbsoluteSize.X), 0, 1)
            local relY = math.clamp((input.Position.Y - svCanvas.AbsolutePosition.Y) / math.max(1, svCanvas.AbsoluteSize.Y), 0, 1)
            s = relX
            v = 1 - relY
            RefreshColor(false)
        end
    end)

    comp:BindConnection(hueBar.InputBegan, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            local relX = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / math.max(1, hueBar.AbsoluteSize.X), 0, 1)
            h = relX
            RefreshColor(false)
        end
    end)

    comp:BindConnection(UserInputService.InputChanged, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSV then
                local relX = math.clamp((input.Position.X - svCanvas.AbsolutePosition.X) / math.max(1, svCanvas.AbsoluteSize.X), 0, 1)
                local relY = math.clamp((input.Position.Y - svCanvas.AbsolutePosition.Y) / math.max(1, svCanvas.AbsoluteSize.Y), 0, 1)
                s = relX
                v = 1 - relY
                RefreshColor(false)
            elseif draggingHue then
                local relX = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / math.max(1, hueBar.AbsoluteSize.X), 0, 1)
                h = relX
                RefreshColor(false)
            end
        end
    end)

    comp:BindConnection(UserInputService.InputEnded, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
            draggingHue = false
        end
    end)

    comp:BindConnection(hexBox.FocusLost, function()
        local parsed = HexToColor(hexBox.Text)
        comp:SetValue(parsed, false)
    end)

    comp:BindConnection(previewBtn.MouseButton1Click, function()
        comp.IsOpen = not comp.IsOpen
        Util.Tween(card, Util.TweenQuadOutMed, {
            Size = UDim2.new(1, 0, 0, comp.IsOpen and openHeight or closedHeight),
        })
    end)

    return comp
end

