    })

    self:AttachIconAndTitle(header, config.Title or "Section Group", nil, config.Icon or "layers")

    local chevron = Util.Create("ImageLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        ImageColor3 = self.Window.Theme.TextSecondary,
        Rotation = accordion.Expanded and 180 or 0,
        Parent = header,
    })
    IconEngine:ApplyToImageLabel(chevron, "chevron-down")
    self.Window:RegisterThemedObject(chevron, "TextSecondary", "ImageColor3")

    local toggleBtn = Util.Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 4,
        Parent = header,
    })

    local innerContainer = Util.Create("Frame", {
        Position = UDim2.new(0, 10, 0, 46),
        Size = UDim2.new(1, -20, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = card,
    })
    accordion.Container = innerContainer

    local listLayout = Util.Create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = innerContainer,
    })

    local function RefreshHeight()
        local targetH = accordion.Expanded and (46 + listLayout.AbsoluteContentSize.Y + 12) or 42
        Util.Tween(card, Util.TweenQuadOutMed, { Size = UDim2.new(1, 0, 0, targetH) })
        Util.Tween(chevron, Util.TweenQuadOutFast, { Rotation = accordion.Expanded and 180 or 0 })
    end

    self.Window:TrackConnection(listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if accordion.Expanded then
            RefreshHeight()
        end
    end))

    self.Window:TrackConnection(toggleBtn.MouseButton1Click:Connect(function()
        accordion.Expanded = not accordion.Expanded
        RefreshHeight()
    end))

    task.defer(RefreshHeight)
    return accordion
end

