-- [4] UTILITY & TWEEN ENGINE (QUAD/OUT & BACK/OUT MICRO-INTERACTIONS)
-- ============================================================================
local Util = {}

Util.TweenQuadOutFast = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Util.TweenQuadOutMed  = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Util.TweenBackOut     = TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

function Util.Tween(instance: Instance, tweenInfo: TweenInfo, props: { [string]: any }): Tween
    local tw = TweenService:Create(instance, tweenInfo, props)
    tw:Play()
    return tw
end

function Util.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
    local inst = Instance.new(className)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then
                inst[k] = v
            end
        end
    end
    if children then
        for _, child in ipairs(children) do
            child.Parent = inst
        end
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

function Util.AddCorner(parent: Instance, radius: number?): UICorner
    return Util.Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8),
        Parent = parent,
    })
end

function Util.AddStroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
    return Util.Create("UIStroke", {
        Color = color or Color3.fromRGB(62, 68, 82),
        Thickness = thickness or 1,
        Transparency = transparency or 0.35,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

function Util.AddPadding(parent: Instance, top: number?, bottom: number?, left: number?, right: number?): UIPadding
    return Util.Create("UIPadding", {
        PaddingTop = UDim.new(0, top or 8),
        PaddingBottom = UDim.new(0, bottom or 8),
        PaddingLeft = UDim.new(0, left or 10),
        PaddingRight = UDim.new(0, right or 10),
        Parent = parent,
    })
end

function Util.FormatTime(seconds: number): string
    seconds = math.max(0, math.floor(seconds or 0))
    local mins = math.floor(seconds / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d", mins, secs)
end

function Util.Ripple(button: GuiObject, accentColor: Color3)
    task.spawn(function()
        local mousePos = UserInputService:GetMouseLocation()
        local inset = GuiService:GetGuiInset()
        local relX = mousePos.X - button.AbsolutePosition.X
        local relY = (mousePos.Y - inset.Y) - button.AbsolutePosition.Y

        local ripple = Util.Create("Frame", {
            Name = "RippleEffect",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(relX, relY),
            Size = UDim2.fromOffset(0, 0),
            BackgroundColor3 = accentColor,
            BackgroundTransparency = 0.65,
            BorderSizePixel = 0,
            ZIndex = button.ZIndex + 2,
            Parent = button,
        })
        Util.AddCorner(ripple, 999)

        local maxSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.2
        local tw = Util.Tween(ripple, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(maxSize, maxSize),
            BackgroundTransparency = 1,
        })
        tw.Completed:Wait()
        if ripple and ripple.Parent then
            ripple:Destroy()
        end
    end)
end

