        tabObj.Page = pageScroll

        function tabObj:Activate()
            for _, other in ipairs(window.Tabs) do
                other.Page.Visible = false
                Util.Tween(other.Button, Util.TweenQuadOutFast, { BackgroundTransparency = 1 })
                Util.Tween(other.TitleLabel, Util.TweenQuadOutFast, { TextColor3 = window.Theme.TextSecondary })
                Util.Tween(other.IconLabel, Util.TweenQuadOutFast, { ImageColor3 = window.Theme.TextSecondary })
