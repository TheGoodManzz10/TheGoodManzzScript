local BaseComponent = {}
BaseComponent.__index = BaseComponent

function BaseComponent.new(window: any, parentContainer: GuiObject, componentType: string)
    local self = setmetatable({}, BaseComponent)
    self.Window = window
    self.ParentContainer = parentContainer
    self.Type = componentType
    self.Connections = {}
    self.ThemeBindings = {}
    return self
end

function BaseComponent:BindConnection(signal: RBXScriptSignal, callback: (...any) -> ()): RBXScriptConnection
    local conn = signal:Connect(callback)
    table.insert(self.Connections, conn)
    table.insert(self.Window.Connections, conn)
    return conn
end

function BaseComponent:RegisterThemedInstance(inst: Instance, role: string, property: string)
    self.Window:RegisterThemedObject(inst, role, property)
end

function BaseComponent:Destroy()
    for _, conn in ipairs(self.Connections) do
        if conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(self.Connections)
    if self.Root and self.Root.Parent then
        self.Root:Destroy()
    end
end

