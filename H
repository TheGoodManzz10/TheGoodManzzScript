local Palettes = {}

local function ColorToHex(c: Color3): string
    return string.format("#%02X%02X%02X", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
end

local function HexToColor(hex: string): Color3
    hex = string.gsub(hex, "#", "")
    if #hex == 6 then
        local r = tonumber(string.sub(hex, 1, 2), 16) or 0
        local g = tonumber(string.sub(hex, 3, 4), 16) or 170
        local b = tonumber(string.sub(hex, 5, 6), 16) or 255
        return Color3.fromRGB(r, g, b)
    end
    return Color3.fromRGB(56, 189, 248)
end

-- Generate 100 Curated Accent Colors (Named + Hex + Color3)
Palettes.AccentColors = {}
do
    local baseNames = {
        "Cyber Cyan", "Electric Indigo", "Neon Violet", "Crimson Pulse", "Emerald Matrix",
        "Solar Amber", "Arctic Sky", "Cobalt Core", "Magenta Nova", "Jade Horizon",
        "Titanium Blue", "Plasma Rose", "Obsidian Gold", "Glacier Mint", "Hyper Coral",
        "Nebula Purple", "Quantum Teal", "Photon Lime", "Scarlet Edge", "Sapphire Luxe"
    }
    local variants = { "Prime", "Vivid", "Deep", "Soft", "Radiant" }
    local idx = 1
    for vIdx = 1, 5 do
        for bIdx = 1, 20 do
            local hue = ((bIdx - 1) / 20 + (vIdx - 1) * 0.012) % 1
            local sat = math.clamp(0.85 - (vIdx - 1) * 0.08, 0.45, 0.95)
            local val = math.clamp(0.96 - (vIdx - 1) * 0.06, 0.65, 1.0)
            local col = Color3.fromHSV(hue, sat, val)
            local hex = ColorToHex(col)
            local label = string.format("%03d. %s %s (%s)", idx, baseNames[bIdx], variants[vIdx], hex)
            table.insert(Palettes.AccentColors, {
                Index = idx,
                Name = label,
                Hex = hex,
                Color = col,
            })
            idx += 1
        end
    end
end

