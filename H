                startPos = Vector2.new(
                    mainWin.AbsolutePosition.X + mainWin.AbsoluteSize.X * 0.5,
                    mainWin.AbsolutePosition.Y + mainWin.AbsoluteSize.Y * 0.5
                )
            end
        end))

