-- 3. AddSlider
function ContainerMixin:AddSlider(config: {
    Title: string,
    Description: string?,
    Icon: string?,
    Min: number?,
    Max: number?,
    Default: number?,
    Step: number?,
    Suffix: string?,
    Callback: ((number) -> ())?,
})
    config = config or {}
    local comp = BaseComponent.new(self.Window, self.Container, "Slider")
    local minVal = config.Min or 0
    local maxVal = config.Max or 100
    local stepVal = config.Step or 1
    local suffix = config.Suffix or ""
    local defaultVal = math.clamp(config.Default or minVal, minVal, maxVal)

    local card = self:CreateCardFrame(56, "SliderComponent")
    comp.Root = card
    comp.Value = defaultVal

    local titleLbl, _ = self:AttachIconAndTitle(card, config.Title or "Slider", nil, config.Icon)
    titleLbl.Position = UDim2.new(0, (config.Icon and 38 or 12), 0, 6)
    titleLbl.Size = UDim2.new(1, -110, 0, 20)

    local valLabel = Util.Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 6),
        Size = UDim2.fromOffset(90, 20),
        BackgroundTransparency = 1,
        Font = self.Window.Theme.Font,
        Text = tostring(defaultVal) .. suffix,
        TextColor3 = self.Window.Theme.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = card,
    })
    self.Window:RegisterThemedObject(valLabel, "Accent", "TextColor3")
    self.Window:RegisterThemedObject(valLabel, "Font", "Font")

    local barBg = Util.Create("Frame", {
        Position = UDim2.new(0, 12, 0, 34),
        Size = UDim2.new(1, -24, 0, 8),
        BackgroundColor3 = self.Window.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Parent = card,
    })
    Util.AddCorner(barBg, 999)
    self.Window:RegisterThemedObject(barBg, "SurfaceAlt", "BackgroundColor3")

    local initialAlpha = (maxVal > minVal) and ((defaultVal - minVal) / (maxVal - minVal)) or 0
    local fillBar = Util.Create("Frame", {
        Size = UDim2.new(initialAlpha, 0, 1, 0),
        BackgroundColor3 = self.Window.Theme.Accent,
        BorderSizePixel = 0,
        Parent = barBg,
    })
    Util.AddCorner(fillBar, 999)
    self.Window:RegisterThemedObject(fillBar, "Accent", "BackgroundColor3")

    local thumb = Util.Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(initialAlpha, 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.fromRGB(250, 252, 255),
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = barBg,
    })
    Util.AddCorner(thumb, 999)
    local thumbStroke = Util.AddStroke(thumb, self.Window.Theme.Accent, 2, 0)
    self.Window:RegisterThemedObject(thumbStroke, "Accent", "Color")

    local function RoundStep(val: number): number
        local stepped = math.round((val - minVal) / stepVal) * stepVal + minVal
        local decimals = 0
        local sStr = tostring(stepVal)
        local dot = string.find(sStr, "%.")
        if dot then
            decimals = #sStr - dot
        end
        local mult = 10 ^ decimals
        return math.clamp(math.round(stepped * mult) / mult, minVal, maxVal)
    end

    function comp:SetValue(newVal: number, silent: boolean?)
        local clamped = RoundStep(newVal)
        comp.Value = clamped
        local alpha = (maxVal > minVal) and ((clamped - minVal) / (maxVal - minVal)) or 0
        valLabel.Text = tostring(clamped) .. suffix
        Util.Tween(fillBar, Util.TweenQuadOutFast, { Size = UDim2.new(alpha, 0, 1, 0) })
        Util.Tween(thumb, Util.TweenQuadOutFast, { Position = UDim2.new(alpha, 0, 0.5, 0) })
        if not silent and typeof(config.Callback) == "function" then
            task.spawn(config.Callback, clamped)
        end
    end

    local dragging = false
    local function UpdateFromInput(inputPos: Vector2)
        local absPos = barBg.AbsolutePosition.X
        local absSize = math.max(1, barBg.AbsoluteSize.X)
        local alpha = math.clamp((inputPos.X - absPos) / absSize, 0, 1)
        local rawVal = minVal + (maxVal - minVal) * alpha
        comp:SetValue(rawVal)
    end

    comp:BindConnection(barBg.InputBegan, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Util.Tween(thumb, Util.TweenBackOut, { Size = UDim2.fromOffset(18, 18) })
            UpdateFromInput(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    comp:BindConnection(UserInputService.InputChanged, function(input: InputObject)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromInput(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    comp:BindConnection(UserInputService.InputEnded, function(input: InputObject)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            Util.Tween(thumb, Util.TweenBackOut, { Size = UDim2.fromOffset(14, 14) })
        end
    end)

    return comp
end

-- 4. AddDropdown (Single-select, Multi-select, Search Filter, Auto-close outside click)
function ContainerMixin:AddDropdown(config: {
    Title: string,
    Description: string?,
    Icon: string?,
    Options: { any }?,
    Multi: boolean?,
    Default: any?,
    Searchable: boolean?,
    MaxHeight: number?,
    Callback: ((any) -> ())?,
})
    config = config or {}
    local comp = BaseComponent.new(self.Window, self.Container, "Dropdown")
    local options = config.Options or {}
    local isMulti = (config.Multi == true)
    local isSearchable = (config.Searchable ~= false)
    local maxListHeight = config.MaxHeight or 175

    local closedHeight = 42
    local card = self:CreateCardFrame(closedHeight, "DropdownComponent")
    comp.Root = card
    comp.IsOpen = false
    comp.Options = options

    if isMulti then
        comp.Value = {}
        if typeof(config.Default) == "table" then
            for _, v in ipairs(config.Default) do
                comp.Value[tostring(v)] = true
            end
        end
    else
        comp.Value = config.Default or (options[1] and tostring(options[1]) or "None")
    end

    local headerFrame = Util.Create("Frame", {
        Size = UDim2.new(1, 0, 0, closedHeight),
        BackgroundTransparency = 1,
        Parent = card,
    })

    local titleLbl, _ = self:AttachIconAndTitle(headerFrame, config.Title or "Dropdown", nil, config.Icon)
    titleLbl.Size = UDim2.new(0.48, 0, 1, 0)

    local selectedLabel = Util.Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -34, 0.5, 0),
        Size = UDim2.new(0.45, 0, 0, 22),
        BackgroundTransparency = 1,
        Font = self.Window.Theme.Font,
        Text = "",
        TextColor3 = self.Window.Theme.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = headerFrame,
    })
    self.Window:RegisterThemedObject(selectedLabel, "Accent", "TextColor3")
    self.Window:RegisterThemedObject(selectedLabel, "Font", "Font")

    local chevron = Util.Create("ImageLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        ImageColor3 = self.Window.Theme.TextSecondary,
        Parent = headerFrame,
    })
    IconEngine:ApplyToImageLabel(chevron, "chevron-down")
    self.Window:RegisterThemedObject(chevron, "TextSecondary", "ImageColor3")

    local headerBtn = Util.Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 4,
        Parent = headerFrame,
    })

    local bodyContainer = Util.Create("Frame", {
        Position = UDim2.new(0, 10, 0, closedHeight + 2),
        Size = UDim2.new(1, -20, 0, maxListHeight),
        BackgroundTransparency = 1,
        Parent = card,
    })

    local searchHeight = isSearchable and 30 or 0
    local searchBox: TextBox? = nil

    if isSearchable then
        local searchFrame = Util.Create("Frame", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = self.Window.Theme.SurfaceAlt,
            BorderSizePixel = 0,
            Parent = bodyContainer,
        })
        Util.AddCorner(searchFrame, 6)
        Util.AddStroke(searchFrame, self.Window.Theme.Border, 1, 0.4)
        self.Window:RegisterThemedObject(searchFrame, "SurfaceAlt", "BackgroundColor3")

        local sIcon = Util.Create("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 8, 0.5, 0),
            Size = UDim2.fromOffset(13, 13),
            BackgroundTransparency = 1,
            ImageColor3 = self.Window.Theme.TextSecondary,
            Parent = searchFrame,
        })
        IconEngine:ApplyToImageLabel(sIcon, "search")

        searchBox = Util.Create("TextBox", {
            Position = UDim2.new(0, 26, 0, 0),
            Size = UDim2.new(1, -32, 1, 0),
            BackgroundTransparency = 1,
            Font = self.Window.Theme.Font,
            PlaceholderText = "Search filter...",
            PlaceholderColor3 = self.Window.Theme.TextSecondary,
            Text = "",
            TextColor3 = self.Window.Theme.TextPrimary,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            Parent = searchFrame,
        })
        self.Window:RegisterThemedObject(searchBox, "TextPrimary", "TextColor3")
        self.Window:RegisterThemedObject(searchBox, "Font", "Font")
    end

    local listScroll = Util.Create("ScrollingFrame", {
        Position = UDim2.new(0, 0, 0, searchHeight),
        Size = UDim2.new(1, 0, 0, maxListHeight - searchHeight - 6),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.Window.Theme.Accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = bodyContainer,
    })
    self.Window:RegisterThemedObject(listScroll, "Accent", "ScrollBarImageColor3")

    Util.Create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = listScroll,
    })

    local function UpdateDisplayLabel()
        if isMulti then
            local chosen = {}
            for k, v in pairs(comp.Value) do
                if v then
                    table.insert(chosen, k)
                end
            end
            table.sort(chosen)
            selectedLabel.Text = (#chosen > 0) and table.concat(chosen, ", ") or "None"
        else
            selectedLabel.Text = tostring(comp.Value or "None")
        end
    end

    local itemButtons = {}

    local function RebuildList(filterText: string?)
        for _, child in ipairs(listScroll:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end
        table.clear(itemButtons)

        local query = string.lower(filterText or "")
        for idx, opt in ipairs(comp.Options) do
            local optName = typeof(opt) == "table" and (opt.Name or tostring(opt)) or tostring(opt)
            if query == "" or string.find(string.lower(optName), query, 1, true) then
                local isSelected = isMulti and (comp.Value[optName] == true) or (tostring(comp.Value) == optName)

                local itemBtn = Util.Create("TextButton", {
                    LayoutOrder = idx,
                    Size = UDim2.new(1, -6, 0, 26),
                    BackgroundColor3 = isSelected and self.Window.Theme.Accent or self.Window.Theme.SurfaceAlt,
                    BackgroundTransparency = isSelected and 0.82 or 0.25,
                    BorderSizePixel = 0,
                    Text = "",
                    Parent = listScroll,
                })
                Util.AddCorner(itemBtn, 6)

                local itemText = Util.Create("TextLabel", {
                    Position = UDim2.new(0, 10, 0, 0),
                    Size = UDim2.new(1, -30, 1, 0),
                    BackgroundTransparency = 1,
                    Font = self.Window.Theme.Font,
                    Text = optName,
                    TextColor3 = isSelected and self.Window.Theme.Accent or self.Window.Theme.TextPrimary,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Parent = itemBtn,
                })

                if typeof(opt) == "table" and opt.Color then
                    local swatch = Util.Create("Frame", {
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -8, 0.5, 0),
                        Size = UDim2.fromOffset(14, 14),
                        BackgroundColor3 = opt.Color,
                        BorderSizePixel = 0,
                        Parent = itemBtn,
                    })
                    Util.AddCorner(swatch, 4)
                end

                comp:BindConnection(itemBtn.MouseButton1Click, function()
                    if isMulti then
                        comp.Value[optName] = not comp.Value[optName]
                        UpdateDisplayLabel()
                        RebuildList(searchBox and searchBox.Text or "")
                        if typeof(config.Callback) == "function" then
                            task.spawn(config.Callback, comp.Value)
                        end
                    else
                        comp.Value = optName
                        UpdateDisplayLabel()
                        comp:SetOpen(false)
                        if typeof(config.Callback) == "function" then
                            task.spawn(config.Callback, optName, opt)
                        end
                    end
                end)

                table.insert(itemButtons, { Button = itemBtn, Label = itemText, Name = optName })
            end
        end
    end

    function comp:SetOpen(state: boolean)
        comp.IsOpen = state
        local targetHeight = state and (closedHeight + maxListHeight + 8) or closedHeight
        Util.Tween(card, Util.TweenQuadOutMed, { Size = UDim2.new(1, 0, 0, targetHeight) })
        Util.Tween(chevron, Util.TweenQuadOutFast, { Rotation = state and 180 or 0 })
        if state then
            RebuildList(searchBox and searchBox.Text or "")
        end
    end

    function comp:SetValue(newVal: any, silent: boolean?)
        if isMulti and typeof(newVal) == "table" then
            comp.Value = newVal
        else
            comp.Value = tostring(newVal)
        end
        UpdateDisplayLabel()
        if comp.IsOpen then
            RebuildList(searchBox and searchBox.Text or "")
        end
        if not silent and typeof(config.Callback) == "function" then
            task.spawn(config.Callback, comp.Value)
        end
    end

    function comp:SetOptions(newOptions: { any })
        comp.Options = newOptions or {}
        RebuildList(searchBox and searchBox.Text or "")
    end

    comp:BindConnection(headerBtn.MouseButton1Click, function()
        comp:SetOpen(not comp.IsOpen)
    end)

    if searchBox then
        comp:BindConnection(searchBox:GetPropertyChangedSignal("Text"), function()
            RebuildList(searchBox.Text)
        end)
    end

    -- Auto-close when clicking outside the dropdown card
    comp:BindConnection(UserInputService.InputBegan, function(input: InputObject)
        if comp.IsOpen and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            local absPos = card.AbsolutePosition
            local absSize = card.AbsoluteSize
            local inside = (pos.X >= absPos.X and pos.X <= absPos.X + absSize.X and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y)
            if not inside then
                comp:SetOpen(false)
            end
        end
    end)

    UpdateDisplayLabel()
    return comp
end

