    })
    Util.AddCorner(modeBtn, 5)
    self.Window:RegisterThemedObject(modeBtn, "SurfaceAlt", "BackgroundColor3")
    self.Window:RegisterThemedObject(modeBtn, "TextSecondary", "TextColor3")
    self.Window:RegisterThemedObject(modeBtn, "Font", "Font")

    local keyBtn = Util.Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(74, 24),
        BackgroundColor3 = self.Window.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Font = Enum.Font.RobotoMono,
        Text = "[" .. comp.Key.Name .. "]",
        TextColor3 = self.Window.Theme.Accent,
        TextSize = 11,
        Parent = card,
    })
    Util.AddCorner(keyBtn, 6)
    Util.AddStroke(keyBtn, self.Window.Theme.Border, 1, 0.35)
    self.Window:RegisterThemedObject(keyBtn, "SurfaceAlt", "BackgroundColor3")
    self.Window:RegisterThemedObject(keyBtn, "Accent", "TextColor3")

    comp:BindConnection(modeBtn.MouseButton1Click, function()
        comp.Mode = (comp.Mode == "Toggle") and "Hold" or "Toggle"
        modeBtn.Text = comp.Mode
    end)

    comp:BindConnection(keyBtn.MouseButton1Click, function()
        comp.Binding = true
        keyBtn.Text = "[Press Key]"
    end)

    comp:BindConnection(UserInputService.InputBegan, function(input: InputObject, gameProcessed: boolean)
        if comp.Binding then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                comp.Binding = false
                if input.KeyCode ~= Enum.KeyCode.Escape then
                    comp.Key = input.KeyCode
                end
                keyBtn.Text = "[" .. comp.Key.Name .. "]"
            end
            return
        end

        if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == comp.Key then
            if comp.Mode == "Toggle" then
                comp.Active = not comp.Active
                if typeof(config.Callback) == "function" then
                    task.spawn(config.Callback, comp.Active, comp.Key)
                end
            elseif comp.Mode == "Hold" then
                comp.Active = true
                if typeof(config.Callback) == "function" then
                    task.spawn(config.Callback, true, comp.Key)
                end
            end
        end
    end)

    comp:BindConnection(UserInputService.InputEnded, function(input: InputObject)
        if not comp.Binding and comp.Mode == "Hold" and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == comp.Key then
            comp.Active = false
            if typeof(config.Callback) == "function" then
                task.spawn(config.Callback, false, comp.Key)
            end
        end
    end)

    return comp
end

