		BgImg.ZIndex = (baseZIndex or 8)

		local BgCorner = Instance.new("UICorner")
		BgCorner.CornerRadius = initCornerUDim
		BgCorner.Parent = BgImg

		-- Pasang VideoFrame + Animated Video Shader di dalam ClipCanvas (Tunggal & Bebas Dupe!)
