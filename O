	-- ARSITEKTUR UNIVERSAL v5.0.0 (FIXED & STABIL 100%):
	-- - Perhitungan tinggi kontainer deterministik (tidak bergantung pada Visible=true)
	-- - MirrorCall aman mendukung fungsi maupun tabel objek Group/Row
	-- - Sinkronisasi otomatis untuk semua komponen di dalam AddGroup & AddRow
	-------------------------------------------------------------------
	local DynamicRefreshCallbacks = {}
	local isRunningDynamicRefresh = false

	local function RunAllDynamicRefreshes()
		if isRunningDynamicRefresh then return end
		isRunningDynamicRefresh = true
		for _, fn in ipairs(DynamicRefreshCallbacks) do
			pcall(fn)
		end
		isRunningDynamicRefresh = false
	end

	-- Menghitung tinggi aktual seluruh anak GuiObject secara deterministik (bahkan saat UI masih tersembunyi/Visible=false)
	local function ComputeContainerHeight(container, layout)
		if not container then
			return 0
		end
		local pad = (layout and layout.Padding and layout.Padding.Offset) or 6
		local total = 0
		local count = 0
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				count = count + 1
				local h = child.Size.Y.Offset
				if h <= 0 and child.AbsoluteSize.Y > 0 then
					h = child.AbsoluteSize.Y
				end
				total = total + h
			end
		end
		if count > 1 then
			total = total + ((count - 1) * pad)
		end
		if total > 0 then
			return total
		end
		return (layout and layout.AbsoluteContentSize.Y) or 0
	end

	local function BindDynamicContainer(container, layout, onUpdate)
		local hooked = {}
		local function HookChild(child)
			if child and child:IsA("GuiObject") and not hooked[child] then
				hooked[child] = true
				TrackConnection(child:GetPropertyChangedSignal("Size"):Connect(function()
					onUpdate(false)
				end))
				TrackConnection(child:GetPropertyChangedSignal("Visible"):Connect(function()
					onUpdate(false)
				end))
				SafeDefer(function()
					onUpdate(false)
				end)
			end
		end
		for _, ch in ipairs(container:GetChildren()) do
			HookChild(ch)
		end
		TrackConnection(container.ChildAdded:Connect(function(ch)
			HookChild(ch)
			onUpdate(false)
		end))
		TrackConnection(container.ChildRemoved:Connect(function()
			onUpdate(false)
		end))
		if layout then
			TrackConnection(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				onUpdate(false)
			end))
		end
		table.insert(DynamicRefreshCallbacks, function()
			onUpdate(false)
		end)
	end

	-- Pastikan saat MainFrame atau StarlightFrame tampil, semua Group & Row langsung disinkronkan
	TrackConnection(MainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if MainFrame.Visible then
			RunAllDynamicRefreshes()
			SafeDefer(RunAllDynamicRefreshes)
		end
	end))
	TrackConnection(StarlightFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if StarlightFrame.Visible then
			RunAllDynamicRefreshes()
			SafeDefer(RunAllDynamicRefreshes)
		end
	end))

