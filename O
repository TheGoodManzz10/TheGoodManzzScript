				TweenService:Create(Knob, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = goalPos }):Play()
				if callback then
					pcall(callback, isToggled, currentKey)
				end
			end

			TrackConnection(SwitchBg.MouseButton1Click:Connect(function()
				updateToggle(not isToggled)
			end))

