				Stroke.Color = col
				if SnowContainers.IsBgFireActive then Switch.BackgroundColor3 = col end
			end)

			TrackConnection(Switch.MouseButton1Click:Connect(function()
				SnowContainers.SetBgFireActive(not SnowContainers.IsBgFireActive)
				if callback then pcall(callback, SnowContainers.IsBgFireActive, SnowContainers.BgFireSpeed) end
			end))
		end

