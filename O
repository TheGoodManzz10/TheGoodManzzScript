	function ManagedIcons.SamplePalette100(paletteTbl, tVal)
		local n = #paletteTbl
		if n == 0 then return Color3.fromRGB(255, 255, 255) end
		local pos = (tVal % n)
		local i1 = math.floor(pos) + 1
		local i2 = (i1 % n) + 1
		local alpha = pos - math.floor(pos)
		local c1 = paletteTbl[i1] and paletteTbl[i1].Color or Color3.fromRGB(255, 255, 255)
		local c2 = paletteTbl[i2] and paletteTbl[i2].Color or c1
		return c1:Lerp(c2, alpha)
	end

	function ManagedIcons.IsInsideHeaderBar(inst)
		if not inst then return false end
		if inst:GetAttribute("LockWhiteIcon") then return true end
		local p = inst.Parent
		while p and p ~= ScreenGui do
			local pName = tostring(p.Name or "")
			if pName == "TopBar" or pName == "StarlightHeaderV2" or pName == "NovaHorizonHeaderV3" then
				return true
			end
			p = p.Parent
		end
		return false
	end

	function ManagedIcons.EnforceAllHeaderIconsWhite()
		for _, desc in ipairs(ScreenGui:GetDescendants()) do
			if desc:IsA("ImageLabel") and (desc:GetAttribute("LockWhiteIcon") or (desc:GetAttribute("IsAetherIcon") and ManagedIcons.IsInsideHeaderBar(desc))) then
				desc:SetAttribute("LockWhiteIcon", true)
				desc.ImageColor3 = Color3.fromRGB(255, 255, 255)
			end
		end
	end

	function ManagedIcons.ApplyIconColor(newIconCol)
		ManagedIcons.CurrentIconColor = newIconCol
		-- Sesuai permintaan v5.0.0: Saat ganti warna seluruh icon, icon header di SELURUH UI tetap putih bersih (255, 255, 255)!
		for _, desc in ipairs(ScreenGui:GetDescendants()) do
			if desc:IsA("ImageLabel") and desc:GetAttribute("IsAetherIcon") then
				if ManagedIcons.IsInsideHeaderBar(desc) then
					desc:SetAttribute("LockWhiteIcon", true)
					desc.ImageColor3 = Color3.fromRGB(255, 255, 255)
				else
					desc.ImageColor3 = newIconCol
				end
			end
		end
	end

	local function ApplyTextColor(newColor)
		currentTextThemeColor = newColor
		for _, fn in ipairs(TextColorCallbacks) do
			pcall(fn, currentTextThemeColor)
