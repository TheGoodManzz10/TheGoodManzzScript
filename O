			BodyContainer.ScrollBarImageColor3 = col
		end)

		local itemCount = 0
		local maxGroupViewportH = 195
		local activeGroupTween = nil
		local isGroupTweening = false

		local function RefreshGroupSize(animate)
			if not GroupCard or not GroupCard.Parent then
				return
			end
			local contentY = ComputeContainerHeight(BodyContainer, BodyLayout)
			local visibleBodyY = math.min(math.max(contentY, 44), maxGroupViewportH)
			BodyContainer.Size = UDim2.new(1, -16, 0, visibleBodyY)
			BodyContainer.CanvasSize = UDim2.new(0, 0, 0, math.max(contentY + 20, visibleBodyY + 16))
			local targetH = isOpen and (visibleBodyY + 52) or 38

			if animate then
				if activeGroupTween then
					pcall(function() activeGroupTween:Cancel() end)
				end
				isGroupTweening = true
				-- Biarkan BodyContainer tetap Visible selama animasi menutup agar komponen di dalamnya meluncur halus!
				BodyContainer.Visible = true
				TweenService:Create(ArrowIcon, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					Rotation = isOpen and 90 or 0
				}):Play()
				local tw = TweenService:Create(GroupCard, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					Size = UDim2.new(1, 0, 0, targetH)
				})
				activeGroupTween = tw
				tw.Completed:Once(function()
					if activeGroupTween == tw then
						activeGroupTween = nil
						isGroupTweening = false
						if not isOpen then
							BodyContainer.Visible = false
						end
					end
				end)
				tw:Play()
			else
				-- Jangan timpa Tween pembukaan/penutupan yang sedang berjalan!
				if not isGroupTweening then
					BodyContainer.Visible = isOpen
					GroupCard.Size = UDim2.new(1, 0, 0, targetH)
				end
			end
		end

		BindDynamicContainer(BodyContainer, BodyLayout, RefreshGroupSize)

		TrackConnection(HeaderBtn.MouseButton1Click:Connect(function()
			isOpen = not isOpen
			RefreshGroupSize(true)
		end))

		RefreshGroupSize(false)

		local InnerScope = CreateContainerScope(BodyContainer, zBase + 2, function()
			return mirrorGroupObj
		end)
		local GroupObj = {
			Container = BodyContainer,
			Card = GroupCard,
			RefreshSize = RefreshGroupSize
		}

		setmetatable(GroupObj, {
			__index = function(_, methodName)
				if type(InnerScope[methodName]) == "function" then
					return function(_, ...)
						itemCount = itemCount + 1
						CountBadge.Text = tostring(itemCount)
						local res = InnerScope[methodName](InnerScope, ...)
						RefreshGroupSize(false)
						SafeDefer(function()
							RefreshGroupSize(false)
						end)
						return res
					end
				end
				return nil
			end
		})

		return GroupObj
	end

