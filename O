	local function LoadSavedMusicFromDisk()
		if type(isfile) == "function" and type(readfile) == "function" and isfile(savedMusicFileName) then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(readfile(savedMusicFileName))
			end)
			if ok and type(decoded) == "table" then
				for _, item in ipairs(decoded) do
					if type(item) == "table" and item.Val and tostring(item.Val) ~= "" then
						local exists = false
						for _, ex in ipairs(SavedMusicList) do
							if tostring(ex.Val) == tostring(item.Val) then
								exists = true
								break
							end
						end
						if not exists then
							table.insert(SavedMusicList, {
								Name = tostring(item.Name or ("Music: " .. tostring(item.Val))),
								Val = tostring(item.Val)
							})
						end
					end
				end
			end
		end
	end

	local function SaveMusicListToDisk()
		if type(writefile) == "function" then
			local customOnly = {}
			for _, item in ipairs(SavedMusicList) do
				if not item.IsDefault and item.Val and tostring(item.Val) ~= "" then
					table.insert(customOnly, {
						Name = item.Name,
						Val = item.Val
					})
				end
			end
			pcall(function()
				writefile(savedMusicFileName, HttpService:JSONEncode(customOnly))
			end)
		end
	end

	local function RegisterSavedMusic(rawVal, customLabel)
		local cleanVal = tostring(rawVal or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if cleanVal == "" or cleanVal:lower() == "stop" or cleanVal:lower() == "off" or cleanVal:lower() == "none" then
			return false
		end
		for _, item in ipairs(SavedMusicList) do
			if tostring(item.Val) == cleanVal then
				return false
			end
		end
		local shortLabel = customLabel
		if not shortLabel or shortLabel == "" then
			local digits = cleanVal:match("^(%d+)$") or cleanVal:match("rbxassetid://(%d+)") or cleanVal:match("id=(%d+)")
			if digits then
				shortLabel = "Music ID: " .. digits
			else
				shortLabel = "Audio: " .. cleanVal:sub(1, 14)
			end
		end
		table.insert(SavedMusicList, {
			Name = shortLabel,
			Val = cleanVal
		})
		SaveMusicListToDisk()
		for _, fn in ipairs(SavedMusicRefreshers) do
			pcall(fn)
		end
		return true
	end

	LoadSavedMusicFromDisk()

	local function ResolveMusicAsset(rawInput)
		local str = tostring(rawInput or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if str == "" or str:lower() == "stop" or str:lower() == "off" or str:lower() == "none" then
			return "", "Stopped"
		end

		if str:lower():sub(1, 13) == "rbxassetid://" or str:lower():sub(1, 11) == "rbxasset://" then
			return str, "Roblox Audio URI"
		end

		if str:match("^%d+$") then
			return "rbxassetid://" .. str, "Roblox Sound ID (" .. str .. ")"
		end

		if str:lower():find("roblox.com") and str:match("(%d+)") then
			local id = str:match("(%d+)")
			return "rbxassetid://" .. id, "Roblox Link Sound ID (" .. id .. ")"
		end

		local customAssetFn = (type(getcustomasset) == "function" and getcustomasset)
			or (type(getsynasset) == "function" and getsynasset)

		if str:lower():sub(1, 4) == "http" then
			if customAssetFn and type(writefile) == "function" then
				local okDl, audioData = pcall(function()
					return game:HttpGet(str)
				end)
				if okDl and audioData and #audioData > 0 then
					local cacheFile = "AetherLib_v22_Music.mp3"
					local okWrite = pcall(function()
						writefile(cacheFile, audioData)
					end)
					if okWrite then
						local okAsset, customUri = pcall(customAssetFn, cacheFile)
						if okAsset and customUri then
							return tostring(customUri), "Downloaded Audio (" .. cacheFile .. ")"
						end
					end
				end
			end
			return str, "Direct URL"
		end

		if customAssetFn then
			local candidates = { str, str .. ".mp3", str .. ".ogg", str .. ".wav" }
			for _, cand in ipairs(candidates) do
				local exists = true
				if type(isfile) == "function" then
					local okCheck, res = pcall(isfile, cand)
					exists = (okCheck and res == true)
				end
				if exists then
					local okAsset, customUri = pcall(customAssetFn, cand)
					if okAsset and customUri and tostring(customUri) ~= "" then
						return tostring(customUri), "Workspace Audio (" .. cand .. ")"
					end
				end
			end
			local okDirect, directUri = pcall(customAssetFn, str)
			if okDirect and directUri and tostring(directUri) ~= "" then
				return tostring(directUri), "Workspace Audio (" .. str .. ")"
			end
		end

		local anyDigits = str:match("(%d+)")
		if anyDigits then
			return "rbxassetid://" .. anyDigits, "Roblox Sound ID (" .. anyDigits .. ")"
		end

		return str, "Custom Audio"
	end

	local function UpdateMusicStatusUI(statusText)
		for _, lbl in ipairs(MusicStatusLabels) do
