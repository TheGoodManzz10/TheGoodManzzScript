		local existingCorner = targetFrame:FindFirstChildOfClass("UICorner")
		if existingCorner then
			ClipCanvasCorner.CornerRadius = existingCorner.CornerRadius
			BgCorner.CornerRadius = existingCorner.CornerRadius
			VidCorner.CornerRadius = existingCorner.CornerRadius
			ShaderCorner.CornerRadius = existingCorner.CornerRadius
			CinemaCorner.CornerRadius = existingCorner.CornerRadius
			TrackConnection(existingCorner:GetPropertyChangedSignal("CornerRadius"):Connect(function()
				ClipCanvasCorner.CornerRadius = existingCorner.CornerRadius
				BgCorner.CornerRadius = existingCorner.CornerRadius
				VidCorner.CornerRadius = existingCorner.CornerRadius
				ShaderCorner.CornerRadius = existingCorner.CornerRadius
				CinemaCorner.CornerRadius = existingCorner.CornerRadius
			end))
		end

		table.insert(BgImageLabels, {
			Frame = targetFrame,
			ClipCanvas = ClipCanvas,
			Label = BgImg,
			Corner = BgCorner,
			BaseCorner = ClipCanvasCorner
