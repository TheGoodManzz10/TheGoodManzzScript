		ShaderHolder.BorderSizePixel = 0
		ShaderHolder.Position = UDim2.new(0, 0, 0, 0)
		ShaderHolder.Size = UDim2.new(1, 0, 1, 0)
		ShaderHolder.Rotation = 0
		ShaderHolder.ClipsDescendants = true
		ShaderHolder.Visible = V105State.IsBgVideoActive
		ShaderHolder.Active = false
		ShaderHolder.ZIndex = (baseZIndex or 8)

		local ShaderCorner = Instance.new("UICorner")
		ShaderCorner.CornerRadius = initCornerUDim
		ShaderCorner.Parent = ShaderHolder

		local ShaderGrad = Instance.new("UIGradient")
		ShaderGrad.Rotation = 35
		ShaderGrad.Parent = ShaderHolder

		-- Layer Sinema Bergerak 60FPS (CinemaPanLayer) dengan UICorner sendiri & Rotation = 0 agar sudut lengkungan 100% bulat sempurna!
		local CinemaPanImg = Instance.new("ImageLabel")
		CinemaPanImg.Name = "WorkspaceCinemaPanLayer"
		CinemaPanImg.Parent = ShaderHolder
		CinemaPanImg.AnchorPoint = Vector2.new(0.5, 0.5)
		CinemaPanImg.BackgroundTransparency = 1
		CinemaPanImg.Position = UDim2.new(0.5, 0, 0.5, 0)
		CinemaPanImg.Size = UDim2.new(1, 0, 1, 0)
		CinemaPanImg.Rotation = 0
		CinemaPanImg.Image = (currentBgImageUri ~= "" and currentBgImageUri) or Icons["planet-earth"] or "rbxassetid://109328327555253"
