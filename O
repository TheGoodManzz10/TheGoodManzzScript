		-- Helper Pemindai Semua File Video di Workspace (Mendukung Delta, Arceus X, Codex, Fluxus, Krnl, Wave, PC & Mobile)
		function V105State.ScanAllWorkspaceVideoFiles()
			local results = {}
			local seen = {}
			if type(listfiles) == "function" then
				for _, dirArg in ipairs({ "", ".", "workspace", "./" }) do
					local okL, files = pcall(listfiles, dirArg)
					if okL and type(files) == "table" then
						for _, fpath in ipairs(files) do
							local rawPath = tostring(fpath or "")
							local cleanSlash = rawPath:gsub("\\", "/")
							local baseName = cleanSlash:match("([^/]+)$") or cleanSlash
							local low = baseName:lower()
							if low:sub(-5) == ".webm" or low:sub(-4) == ".mp4" or low:sub(-4) == ".mov" or low:sub(-4) == ".mkv" or low:sub(-4) == ".avi" then
								if not seen[low] then
									seen[low] = true
									table.insert(results, { RawPath = rawPath, CleanPath = cleanSlash, BaseName = baseName })
								end
							end
						end
					end
				end
			end
			return results
		end

		function V105State.ResolveVideoAsset(rawInput)
			if type(rawInput) ~= "string" then return "", "Tidak valid", false end
			local trimmed = rawInput:gsub("^%s*(.-)%s*$", "%1")
			if trimmed == "" or trimmed:lower() == "none" or trimmed:lower() == "off" or trimmed:lower() == "reset" or trimmed:lower() == "normal" then
				return "", "Video Dimatikan", false
			end

			local customAssetFn = (type(getcustomasset) == "function" and getcustomasset)
				or (type(getsynasset) == "function" and getsynasset)

			-- Helper mencoba muat file dari workspace (langsung maupun via sanitized cache jika nama file mengandung spasi/path Android)
			local function TryLoadWorkspaceVideoPath(candPath)
				if not customAssetFn or not candPath or candPath == "" then return nil end
				local cleanSlash = tostring(candPath):gsub("\\", "/")
				local baseName = cleanSlash:match("([^/]+)$") or cleanSlash
				local tryVariants = { candPath, cleanSlash, baseName, "workspace/" .. baseName, "./" .. baseName }

				for _, vPath in ipairs(tryVariants) do
					local okDirect, uriDirect = pcall(customAssetFn, vPath)
					if okDirect and type(uriDirect) == "string" and uriDirect ~= "" then
						-- Jika nama file punya spasi/kurung yang sering gagal di VideoFrame Android, salin ke file cache bersih tanpa spasi
						if baseName:find("[^%w%.%_%-]") and type(readfile) == "function" and type(writefile) == "function" then
							local ext = baseName:match("(%.%w+)$") or ".webm"
							local safeCacheName = "AetherBgVideoCache" .. ext:lower()
							local okR, fileBytes = pcall(readfile, vPath)
							if okR and type(fileBytes) == "string" and #fileBytes > 0 then
								pcall(writefile, safeCacheName, fileBytes)
								local okSafe, safeUri = pcall(customAssetFn, safeCacheName)
								if okSafe and type(safeUri) == "string" and safeUri ~= "" then
									return safeUri, "Workspace Video (" .. baseName .. ")"
								end
							end
						end
						return uriDirect, "Workspace Video (" .. baseName .. ")"
					end
				end

				-- Fallback jika getcustomasset gagal pada path penuh tapi readfile berhasil membaca datanya
				if type(readfile) == "function" and type(writefile) == "function" then
					for _, vPath in ipairs(tryVariants) do
						local okR, fileBytes = pcall(readfile, vPath)
						if okR and type(fileBytes) == "string" and #fileBytes > 0 then
							local ext = baseName:match("(%.%w+)$") or ".webm"
							local safeCacheName = "AetherBgVideoCache" .. ext:lower()
							local okW = pcall(writefile, safeCacheName, fileBytes)
							if okW then
								local okSafe, safeUri = pcall(customAssetFn, safeCacheName)
								if okSafe and type(safeUri) == "string" and safeUri ~= "" then
									return safeUri, "Workspace Video (" .. baseName .. ")"
								end
							end
						end
					end
				end
				return nil
			end

			-- 1. Jika input sudah berupa rbxasset:// atau rbxassetid://
			if trimmed:lower():sub(1, 11) == "rbxasset://" then
				return trimmed, "Workspace Asset URI", true
			end
			if trimmed:lower():sub(1, 13) == "rbxassetid://" then
				return trimmed, "Roblox Video Asset", false
			end

			-- 2. Cek apakah input cocok dengan file video di Workspace terlebih dahulu!
			if customAssetFn and not trimmed:match("^%d+$") and trimmed:lower():sub(1, 4) ~= "http" then
				local candidates = { trimmed }
				if not trimmed:find("%.") then
					table.insert(candidates, trimmed .. ".webm")
					table.insert(candidates, trimmed .. ".mp4")
					table.insert(candidates, trimmed .. ".mov")
					table.insert(candidates, trimmed .. ".mkv")
				end
				-- Cocokkan juga dengan hasil scan listfiles workspace (case-insensitive)
				local wsFiles = V105State.ScanAllWorkspaceVideoFiles()
				local lowTrim = (trimmed:gsub("\\", "/"):match("([^/]+)$") or trimmed):lower()
				for _, wf in ipairs(wsFiles) do
					local wfLow = wf.BaseName:lower()
					local wfNoExt = wfLow:gsub("%.%w+$", "")
					if wfLow == lowTrim or wfNoExt == lowTrim or wf.RawPath:lower() == trimmed:lower() then
						table.insert(candidates, 1, wf.RawPath)
						table.insert(candidates, 2, wf.BaseName)
					end
				end

				for _, cand in ipairs(candidates) do
					local wsUri, wsDesc = TryLoadWorkspaceVideoPath(cand)
					if wsUri then
						return wsUri, wsDesc, true
					end
				end
			end

			-- 3. Jika berupa angka murni (ID Asset Video Roblox)
			if trimmed:match("^%d+$") then
				return "rbxassetid://" .. trimmed, "Roblox Video ID (" .. trimmed .. ")", false
			end

			local idFromUrl = trimmed:match("roblox%.com/library/(%d+)") or trimmed:match("roblox%.com/asset/%?id=(%d+)") or trimmed:match("create%.roblox%.com/store/asset/(%d+)")
			if idFromUrl then
				return "rbxassetid://" .. idFromUrl, "Roblox Video ID (" .. idFromUrl .. ")", false
			end

			-- 4. Jika berupa URL HTTP langsung (.webm / .mp4), unduh ke workspace lalu muat via getcustomasset
			if trimmed:lower():sub(1, 4) == "http" then
				if customAssetFn and type(writefile) == "function" then
					local ext = ".webm"
					if trimmed:lower():find("%.mp4") then ext = ".mp4" end
					local cacheFile = "AetherLib_CustomBgVideo" .. ext
					local okDl = pcall(function()
						local data = game:HttpGet(trimmed)
						if data and #data > 0 then writefile(cacheFile, data) end
					end)
					if okDl then
						local okAsset, assetUri = pcall(customAssetFn, cacheFile)
						if okAsset and assetUri and assetUri ~= "" then
							return assetUri, "URL Video -> Workspace (" .. cacheFile .. ")", true
						end
					end
				end
				return trimmed, "Direct Video URL", true
			end

			return "rbxassetid://" .. trimmed, "Custom Video (" .. trimmed .. ")", false
		end

