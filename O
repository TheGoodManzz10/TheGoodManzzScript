				Stroke.Color = col
				B2.BackgroundColor3 = col
				Fill.BackgroundColor3 = col
				KStroke.Color = col
				SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.22)
			end)

			local function SetVal(v)
				curVal = math.clamp(math.floor(v), min, max)
				local r = (curVal - min) / range
				Fill.Size = UDim2.new(r, 0, 1, 0)
				Knob.Position = UDim2.new(r, -7, 0.5, -7)
				Lbl.Text = tostring(title or "Slider") .. ": " .. tostring(curVal)
				if onSlide then
					pcall(onSlide, curVal)
				end
			end

			TrackConnection(B1.MouseButton1Click:Connect(function()
				SetVal(defaultVal or min)
				if onBtn1 then pcall(onBtn1, curVal) end
			end))
			TrackConnection(B2.MouseButton1Click:Connect(function()
				if onBtn2 then pcall(onBtn2, curVal) end
			end))

			local sliding = false
			local function updateSlide(input)
				local w = math.max(SliderBar.AbsoluteSize.X, 1)
				local p = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / w, 0, 1)
				SetVal(min + (range * p))
			end
			TrackConnection(Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end))
			TrackConnection(SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					updateSlide(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateSlide(input)
				end
			end))
		end

