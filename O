		if not BgVid then
			BgVid = Instance.new("Frame")
		end
		BgVid.Name = "CustomWallpaperVideo"
		BgVid.Parent = ClipCanvas
		BgVid.BackgroundTransparency = 1
		BgVid.Position = UDim2.new(0, 0, 0, 0)
		BgVid.Size = UDim2.new(1, 0, 1, 0)
		BgVid.Visible = V105State.IsBgVideoActive
		BgVid.Active = false
		BgVid.ZIndex = (baseZIndex or 8) + 1
		pcall(function()
			BgVid.Looped = true
			BgVid.Volume = V105State.VideoVolume or 0
			BgVid.Video = V105State.CurrentBgVideoUri or ""
			if V105State.IsBgVideoActive then
