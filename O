		CinemaPanImg.ScaleType = Enum.ScaleType.Crop
		CinemaPanImg.Active = false
		CinemaPanImg.ZIndex = (baseZIndex or 8)

		local CinemaCorner = Instance.new("UICorner")
		CinemaCorner.CornerRadius = initCornerUDim
		CinemaCorner.Parent = CinemaPanImg

		local waveBeams = {}
		for wIdx = 1, 5 do
			local wBeam = Instance.new("Frame")
			wBeam.Parent = ShaderHolder
			wBeam.BackgroundColor3 = currentAccentColor
			wBeam.BackgroundTransparency = 0.72 + (wIdx * 0.03)
			wBeam.BorderSizePixel = 0
			wBeam.Position = UDim2.new(0.05, 0, 0.08 + (wIdx - 1) * 0.16, 0)
			wBeam.Size = UDim2.new(0.90, 0, 0.08, 0)
			wBeam.Active = false
			wBeam.ZIndex = (baseZIndex or 8)
			local wbc = Instance.new("UICorner"); wbc.CornerRadius = UDim.new(1, 0); wbc.Parent = wBeam
			local wGrad = Instance.new("UIGradient")
			wGrad.Rotation = 90
			wGrad.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.65),
