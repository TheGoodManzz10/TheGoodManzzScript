			ValBox.TextSize = 10
			ValBox.ClearTextOnFocus = false
			ValBox.ZIndex = zBase + 2

			local VBCorner = Instance.new("UICorner")
			VBCorner.CornerRadius = UDim.new(0, 4)
			VBCorner.Parent = ValBox

			local function SetNum(v)
				currentVal = math.clamp(math.floor(v), min, max)
				ValBox.Text = tostring(currentVal)
				Lbl.Text = name .. " : " .. tostring(currentVal)
				if callback then
					pcall(callback, currentVal)
				end
			end

			local function MakePadBtn(txt, scaleX, scaleW, delta)
				local B = Instance.new("TextButton")
				B.Parent = PadHolder
				B.BackgroundColor3 = (delta > 0) and currentAccentColor or TintWithAccent(Color3.fromRGB(48, 48, 66), currentAccentColor, 0.25)
				B.Position = UDim2.new(scaleX, 1, 0, 0)
				B.Size = UDim2.new(scaleW, -2, 1, 0)
				B.Font = currentFontBold
				B:SetAttribute("IsBoldFont", true)
				B:SetAttribute("IgnoreTextColor", true)
				B.Text = txt
				B.TextColor3 = Color3.fromRGB(255, 255, 255)
				B.TextSize = 10
				B.ZIndex = zBase + 2

				local BC = Instance.new("UICorner")
				BC.CornerRadius = UDim.new(0, 4)
				BC.Parent = B

				OnAccentChanged(function(col)
					B.BackgroundColor3 = (delta > 0) and col or TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.25)
				end)

				TrackConnection(B.MouseButton1Click:Connect(function()
					SetNum(currentVal + delta)
				end))
			end

			MakePadBtn("--", 0.00, 0.18, -(step * 5))
			MakePadBtn("-", 0.18, 0.18, -step)
			MakePadBtn("+", 0.64, 0.18, step)
			MakePadBtn("++", 0.82, 0.18, step * 5)

			OnAccentChanged(function(col)
				Stroke.Color = col
			end)

			TrackConnection(ValBox.FocusLost:Connect(function()
				local n = tonumber(ValBox.Text)
				if n then
					SetNum(n)
				else
					ValBox.Text = tostring(currentVal)
				end
			end))
		end

		-- 4. AddNovaProgressButton: Tombol Eksekusi Beranimasi Loading 0% -> 100%
		function Scope:AddNovaProgressButton(btnText, iconNameArg, durationSec, callback)
			if type(iconNameArg) == "number" then
				callback = durationSec
				durationSec = iconNameArg
				iconNameArg = nil
			elseif type(iconNameArg) == "function" then
				callback = iconNameArg
				durationSec = 1.2
				iconNameArg = nil
			elseif type(durationSec) == "function" then
				callback = durationSec
				durationSec = 1.2
			end
			MirrorCall("AddNovaProgressButton", btnText, iconNameArg, durationSec, callback)
			durationSec = tonumber(durationSec) or 1.2
			local busy = false

			local Btn = Instance.new("TextButton")
			Btn.Parent = TabContent
			Btn.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
			Btn.BackgroundTransparency = 0.15
			Btn.Size = UDim2.new(1, 0, 0, 38)
			Btn.ClipsDescendants = true
			Btn.Font = currentFontRegular
			Btn.Text = btnText
			Btn.TextColor3 = currentTextThemeColor
			Btn.TextSize = 11
			Btn.TextXAlignment = Enum.TextXAlignment.Left
			Btn.ZIndex = zBase

			iconNameArg = ResolveComponentIcon(iconNameArg, btnText, "lucide-rocket")
			local BtnPadding = Instance.new("UIPadding")
			BtnPadding.Parent = Btn
			BtnPadding.PaddingLeft = UDim.new(0, 32)

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 6)
			Corner.Parent = Btn

			local Stroke = Instance.new("UIStroke")
			Stroke.Color = currentAccentColor
			Stroke.Transparency = 0.55
			Stroke.Thickness = 1
			Stroke.Parent = Btn

			local ProgFill = Instance.new("Frame")
			ProgFill.Parent = Btn
			ProgFill.BackgroundColor3 = currentAccentColor
			ProgFill.BackgroundTransparency = 0.55
			ProgFill.Position = UDim2.new(0, -32, 0, 0)
			ProgFill.Size = UDim2.new(0, 0, 1, 0)
			ProgFill.ZIndex = zBase

			OnAccentChanged(function(col)
				Stroke.Color = col
				ProgFill.BackgroundColor3 = col
			end)

			Btn.ClipsDescendants = false
			CreateIcon(iconNameArg, Btn, UDim2.new(0, -22, 0.5, -8), UDim2.new(0, 16, 0, 16), zBase + 1)

			TrackConnection(Btn.MouseButton1Click:Connect(function()
				if busy then
					return
				end
				busy = true
				local origText = btnText
				ProgFill.Size = UDim2.new(0, 0, 1, 0)
				TweenService:Create(ProgFill, TweenInfo.new(durationSec, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 34, 1, 0)
				}):Play()

				task.spawn(function()
					local steps = 10
					for i = 1, steps do
						if Btn and Btn.Parent then
							Btn.Text = origText .. " (" .. math.floor((i / steps) * 100) .. "%)"
						end
						task.wait(durationSec / steps)
					end
					if callback then
						pcall(callback)
					end
					if Btn and Btn.Parent then
						Btn.Text = origText
						TweenService:Create(ProgFill, TweenInfo.new(0.25), { Size = UDim2.new(0, 0, 1, 0) }):Play()
					end
					busy = false
				end)
			end))
		end

