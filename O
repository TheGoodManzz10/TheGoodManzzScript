					}):Play()
				end

				-- Hitung jumlah titik ("." -> ".." -> "...") bertambah 1 setiap detik selama 3 detik dan loop!
				local elapsedSec = os.clock() - introStartClock
				local dotCount
				if elapsedSec >= 0.15 then
					dotCount = (math.floor(elapsedSec) % 3) + 1
				else
					dotCount = ((pct - 1) % 3) + 1
				end
				local animatedDots = string.rep(".", dotCount)

				StatusLbl.Text = stageBaseText .. animatedDots
				PercentLbl.Text = tostring(pct) .. "%"
				TweenService:Create(BarFill, TweenInfo.new(stepDelay, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
					Size = UDim2.new(pct / 100, 0, 1, 0)
				}):Play()
