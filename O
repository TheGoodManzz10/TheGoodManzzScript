			Lbl.TextSize = 11
			Lbl.TextTruncate = Enum.TextTruncate.AtEnd
			Lbl.TextXAlignment = Enum.TextXAlignment.Left
			Lbl.ZIndex = zBase + 1

			local KeyBtn = Instance.new("TextButton")
			KeyBtn.Parent = Frame
			KeyBtn.BackgroundColor3 = Color3.fromRGB(44, 44, 60)
			KeyBtn.Position = UDim2.new(1, -88, 0, 6)
			KeyBtn.Size = UDim2.new(0, 40, 0, 18)
			KeyBtn.Font = currentFontBold
			KeyBtn:SetAttribute("IsBoldFont", true)
			KeyBtn:SetAttribute("IgnoreTextColor", true)
