			BLayout.Parent = Body
			BLayout.SortOrder = Enum.SortOrder.LayoutOrder
			BLayout.Padding = UDim.new(0, 6)

			OnAccentChanged(function(col)
				Body.ScrollBarImageColor3 = col
			end)

			local function RefreshParentScrollCanvas(overrideCardH)
				if parentCon and parentCon:IsA("ScrollingFrame") then
					local totalP = 0
					local countP = 0
					for _, pch in ipairs(parentCon:GetChildren()) do
						if pch:IsA("GuiObject") and pch.Visible then
							countP = countP + 1
							if pch == GCard and overrideCardH then
								totalP = totalP + overrideCardH
							else
								totalP = totalP + pch.Size.Y.Offset
							end
						end
				end
					if countP > 1 then
						totalP = totalP + ((countP - 1) * 8)
					end
					parentCon.CanvasSize = UDim2.new(0, 0, 0, totalP + 32)
				end
			end

			local activeSetGrpTween = nil
			TrackConnection(GCard:GetPropertyChangedSignal("Size"):Connect(function()
				RefreshParentScrollCanvas()
			end))

			local function SyncGSize(anim)
				if not GCard or not GCard.Parent then return end
				local sum = 0
				local cnt = 0
				for _, ch in ipairs(Body:GetChildren()) do
					if ch:IsA("GuiObject") and ch.Visible then
						cnt = cnt + 1
						sum = sum + ch.Size.Y.Offset
					end
				end
				if cnt > 1 then
					sum = sum + ((cnt - 1) * 6)
				end
				local visH = math.min(math.max(sum, 44), 235)
				Body.Size = UDim2.new(1, -16, 0, visH)
				Body.CanvasSize = UDim2.new(0, 0, 0, math.max(sum + 18, visH + 14))
				local targetH = isOpen and (visH + 50) or 36
				if anim then
					if activeSetGrpTween then
						pcall(function() activeSetGrpTween:Cancel() end)
					end
					-- Biarkan Body tetap Visible selama animasi menutup agar isinya meluncur halus ke atas!
					Body.Visible = true
					TweenService:Create(ArrIcon, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						Rotation = isOpen and 90 or 0
					}):Play()
					local tw = TweenService:Create(GCard, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						Size = UDim2.new(1, 0, 0, targetH)
					})
					activeSetGrpTween = tw
					tw.Completed:Once(function()
						if activeSetGrpTween == tw then
							activeSetGrpTween = nil
							if not isOpen then
								Body.Visible = false
							end
							RefreshParentScrollCanvas(targetH)
						end
					end)
					tw:Play()
				else
					if not activeSetGrpTween then
						Body.Visible = isOpen
						GCard.Size = UDim2.new(1, 0, 0, targetH)
						RefreshParentScrollCanvas(targetH)
					end
				end
			end

			TrackConnection(HBtn.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				SyncGSize(true)
			end))

			return Body, SyncGSize
		end

