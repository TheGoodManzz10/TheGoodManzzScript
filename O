	-- BUILD SETTINGS CONTENT v5.0.0:
	-- - Custom Nama di Bawah AetherGen
	-- - 10 Pilihan Gaya Teks (Font)
	-- - 50 Pilihan Warna Teks (25 + 25 Warna Baru)
	-- - 50 Pilihan Tema Aksen Terang (25 + 25 Tema Baru, Mengubah Warna Slider, Glow, dll.)
	-------------------------------------------------------------------
	local Elements = {}

	do
		-- Loop Real-Time 60FPS untuk Animasi Gambar Background (Maju-Mundur, Kiri-Atas-Bawah-Kanan) & 6 Mode RGB!
		local rgbClock = 0
		local lastRgbStep = 0
		TrackConnection(RunService.RenderStepped:Connect(function(dt)
			local rawDt = math.min(dt or 0.016, 0.05)

			-- A. Animasi Gambar Background Smooth (1 Gambar Tunggal Tanpa Dupe, Maju-Mundur & Kiri-Kanan-Atas-Bawah di dalam ClipCanvas!)
			if SnowContainers.IsBgImageAnimActive then
				SnowContainers.BgImageAnimClock = (SnowContainers.BgImageAnimClock or 0) + (rawDt * (SnowContainers.BgImageAnimSpeed or 1.0))
				local bt = SnowContainers.BgImageAnimClock
				local zoomScale = 1.18 + math.sin(bt * 0.90) * 0.055
				local moveX = 0.5 + math.sin(bt * 0.68) * 0.048
				local moveY = 0.5 + math.cos(bt * 0.54) * 0.048

				for _, bItem in ipairs(BgImageLabels) do
					local lbl = bItem.Label
					if lbl and lbl.Parent and bItem.Frame and bItem.Frame.Visible then
						local fallbackImg = (currentBgImageUri ~= "" and currentBgImageUri) or Icons["planet-earth"] or "rbxassetid://109328327555253"
						if lbl.Image == "" then
							lbl.Image = fallbackImg
							lbl.ImageTransparency = currentBgTransparency
						end
						if not V105State.IsBgVideoActive then
							lbl.Visible = true
						end
						lbl.Rotation = 0
						lbl.AnchorPoint = Vector2.new(0.5, 0.5)
						lbl.Position = UDim2.new(moveX, 0, moveY, 0)
						lbl.Size = UDim2.new(zoomScale, 0, zoomScale, 0)
					end
				end
			end

			-- B. Engine 6 Mode RGB (RGB Tema Pelangi, RGB 100 Semua Warna Tema, RGB Teks Pelangi, RGB 100 Semua Warna Teks, RGB Icon, RGB 100 Icon)
			if isRgbActive or ManagedIcons.IsRgbAccent100 or ManagedIcons.IsRgbTextRainbow or ManagedIcons.IsRgbText100 or ManagedIcons.IsRgbIconRainbow or ManagedIcons.IsRgbIcon100 then
				rgbClock = rgbClock + rawDt
				lastRgbStep = lastRgbStep + rawDt
				if lastRgbStep >= 0.03 then
					lastRgbStep = 0
					if isRgbActive then
						local hue = (rgbClock * 0.14) % 1
						ApplyAccentColor(Color3.fromHSV(hue, 0.78, 0.96))
					elseif ManagedIcons.IsRgbAccent100 then
						local c100 = ManagedIcons.SamplePalette100(ManagedIcons.Palette100Accent, rgbClock * 2.2)
						ApplyAccentColor(c100)
					end

					if ManagedIcons.IsRgbTextRainbow then
						local thue = ((rgbClock * 0.16) + 0.25) % 1
						ApplyTextColor(Color3.fromHSV(thue, 0.68, 1.0))
					elseif ManagedIcons.IsRgbText100 then
						local tc100 = ManagedIcons.SamplePalette100(ManagedIcons.Palette100Text, rgbClock * 2.2)
						ApplyTextColor(tc100)
					end

					if ManagedIcons.IsRgbIconRainbow then
						local ihue = ((rgbClock * 0.18) + 0.5) % 1
						ManagedIcons.ApplyIconColor(Color3.fromHSV(ihue, 0.75, 1.0))
					elseif ManagedIcons.IsRgbIcon100 then
						local ic100 = ManagedIcons.SamplePalette100(ManagedIcons.Palette100Accent, rgbClock * 2.4)
						ManagedIcons.ApplyIconColor(ic100)
					end
				end
			end

			-- C. Animasi Efek Api Background (Menyala, Redup & Bergoyang Smooth 60FPS v5.0.0)
			if SnowContainers.IsBgFireActive then
				SnowContainers.BgFireClock = (SnowContainers.BgFireClock or 0) + (rawDt * (SnowContainers.BgFireSpeed or 1.0))
				local ft = SnowContainers.BgFireClock
				for _, fItem in ipairs(SnowContainers.FireBgList or {}) do
					if fItem.Holder and fItem.Holder.Parent and fItem.Holder.Visible and fItem.ParentFrame and fItem.ParentFrame.Visible then
						if fItem.BaseGlow then
							-- Efek Menyala & Redup halus pada bara dasar
							fItem.BaseGlow.BackgroundTransparency = 0.44 + math.sin(ft * 2.1) * 0.12
						end
						if fItem.BaseGrad then
							fItem.BaseGrad.Rotation = 90 + math.sin(ft * 1.4) * 5
						end
						for _, fl in ipairs(fItem.Flames or {}) do
							-- Goyang kiri-kanan halus + menyala/redup + naik perlahan
							fl.CurY = fl.CurY - (fl.RiseSpeed * rawDt * (SnowContainers.BgFireSpeed or 1.0))
							if fl.CurY < 0.22 then
								fl.CurY = 0.96
							end
							local swayX = fl.BaseX + math.sin((ft * fl.SwayFreq) + fl.Phase) * fl.SwayAmp
							local pulse = 0.5 + 0.5 * math.sin((ft * fl.PulseFreq) + fl.Phase)
							local scaleM = 0.85 + pulse * 0.32
							fl.Gui.Position = UDim2.new(swayX, 0, fl.CurY, 0)
							fl.Gui.Size = UDim2.new(0, math.floor(fl.BaseW * scaleM), 0, math.floor(fl.BaseH * scaleM))
							fl.Gui.Rotation = math.sin((ft * fl.SwayFreq) + fl.Phase) * 14
							fl.Gui.ImageTransparency = 0.16 + (1 - pulse) * 0.42
							fl.Gui.ImageColor3 = Color3.fromRGB(255, 85, 15):Lerp(Color3.fromRGB(255, 215, 65), pulse)
						end
					end
				end
			end

			-- D. Animasi Efek Glow Window Kaca Sudut Atas-Kiri (Menembus Bar Seluruh UI & 100% Mengikuti Tema Aksen v5.0.0)
			if SnowContainers.IsWindowGlowActive then
				SnowContainers.WindowGlowClock = (SnowContainers.WindowGlowClock or 0) + rawDt
				local wt = SnowContainers.WindowGlowClock
				local styleMode = SnowContainers.WindowGlowStyle or "Cyber"
				local baseTint = currentAccentColor
				if styleMode == "Warm" then
					baseTint = currentAccentColor:Lerp(Color3.fromRGB(255, 205, 130), 0.55)
				elseif styleMode == "Kristal" then
					baseTint = currentAccentColor:Lerp(Color3.fromRGB(175, 230, 255), 0.55)
				end
				for _, wItem in ipairs(SnowContainers.WindowGlowList or {}) do
					if wItem.Holder and wItem.Holder.Parent and wItem.Holder.Visible and wItem.ParentFrame and wItem.ParentFrame.Visible then
						for _, p in ipairs(wItem.Panes or {}) do
							local wave = 0.5 + 0.5 * math.sin((wt * 1.35) + p.Phase)
							p.Box.BackgroundColor3 = baseTint
							p.Box.BackgroundTransparency = math.clamp((p.BaseTrans or 0.62) + (0.5 - wave) * 0.10, 0.45, 0.92)
							p.Grad.Color = ColorSequence.new({
								ColorSequenceKeypoint.new(0, baseTint:Lerp(Color3.fromRGB(255, 255, 255), 0.22 * wave)),
								ColorSequenceKeypoint.new(0.55, baseTint),
								ColorSequenceKeypoint.new(1, baseTint:Lerp(Color3.fromRGB(14, 16, 26), 0.70))
							})
							if p.HasStroke and p.Stroke then
								p.Stroke.Color = baseTint:Lerp(Color3.fromRGB(255, 255, 255), 0.35 * wave)
								p.Stroke.Transparency = math.clamp((p.BaseStrokeTrans or 0.54) + (0.5 - wave) * 0.16, 0.35, 0.88)
							end
							p.Grad.Rotation = (p.BaseRot or 40) + math.sin((wt * 0.85) + p.Phase) * 8
						end
					end
				end
			end

			-- E. Animasi Kilatan Api yang Mengelilingi Garis-Garis Tepi UI (Orbiting Fire Flash Streak 60FPS v5.0.0)
			if SnowContainers.IsBorderFireActive then
				SnowContainers.BorderFireClock = (SnowContainers.BorderFireClock or 0) + (rawDt * (SnowContainers.BorderFireSpeed or 1.0))
				local bft = SnowContainers.BorderFireClock
				for _, bfItem in ipairs(SnowContainers.BorderFireList or {}) do
					if bfItem.Holder and bfItem.Holder.Parent and bfItem.Holder.Visible and bfItem.ParentFrame and bfItem.ParentFrame.Visible then
						local angle = (bft * 120) % 360
						if bfItem.Grad then
							bfItem.Grad.Rotation = angle
						end
						if bfItem.BloomGrad then
							bfItem.BloomGrad.Rotation = (angle + 8) % 360
						end
						if bfItem.Stroke then
							bfItem.Stroke.Thickness = 2.2 + 0.65 * (0.5 + 0.5 * math.sin(bft * 3.6))
						end
						if bfItem.BloomStroke then
							bfItem.BloomStroke.Thickness = 3.8 + 1.0 * (0.5 + 0.5 * math.sin(bft * 3.6))
							bfItem.BloomStroke.Transparency = 0.28 + 0.22 * (0.5 + 0.5 * math.cos(bft * 3.0))
						end
					end
				end
			end

			-- F. Live Update Sisa Durasi Key di Tab Informasi (HANYA jika Key System diaktifkan!)
			if SnowContainers.IsKeySystemEnabled and SnowContainers.KeyDurationLabels and #SnowContainers.KeyDurationLabels > 0 then
				SnowContainers.KeyDurClock = (SnowContainers.KeyDurClock or 0) + rawDt
				if SnowContainers.KeyDurClock >= 0.5 then
					SnowContainers.KeyDurClock = 0
					local exp = SnowContainers.ActiveKeyExpiryTime or (os.time() + 86400)
					local rem = math.max(0, exp - os.time())
					local d = math.floor(rem / 86400)
					local h = math.floor((rem % 86400) / 3600)
					local m = math.floor((rem % 3600) / 60)
					local s = math.floor(rem % 60)
					local txt = string.format("Sisa Durasi Key Aktif: %d Hari %02d Jam %02d Menit %02d Detik", d, h, m, s)
					for _, kLbl in ipairs(SnowContainers.KeyDurationLabels) do
						if kLbl and kLbl.Parent then
							kLbl.Text = txt
						end
					end
				end
			end
		end))
	end

