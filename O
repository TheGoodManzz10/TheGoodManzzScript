	function V105State.RecalcSidebarCanvas()
		local visibleCount = 0
		for _, ch in ipairs(StarlightSidebar:GetChildren()) do
			if ch:IsA("GuiObject") and ch.Visible then
				visibleCount = visibleCount + 1
			end
		end
		StarlightSidebar.CanvasSize = UDim2.new(0, 0, 0, (visibleCount * 36) + 24)
	end

