		local function ApplyCategoryOpenState(state)
			catObj.IsOpen = (state == true)
			TweenService:Create(ChevronIcon, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Rotation = catObj.IsOpen and 90 or 0
			}):Play()
			TweenService:Create(InfoHolder, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				BackgroundTransparency = catObj.IsOpen and 0.22 or 0.55
			}):Play()
			for _, tBtn in ipairs(catObj.TabButtons) do
				if tBtn and tBtn.Parent then
					tBtn.ClipsDescendants = true
					if catObj.IsOpen then
						tBtn.Visible = true
						tBtn.Size = UDim2.new(1, 0, 0, 0)
						local twOpen = TweenService:Create(tBtn, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
							Size = UDim2.new(1, 0, 0, 32)
						})
						twOpen.Completed:Once(function()
							V105State.RecalcSidebarCanvas()
						end)
						twOpen:Play()
					else
						tBtn.Visible = true
						local twClose = TweenService:Create(tBtn, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
							Size = UDim2.new(1, 0, 0, 0)
						})
						twClose.Completed:Once(function()
							if not catObj.IsOpen then
								tBtn.Visible = false
								tBtn.Size = UDim2.new(1, 0, 0, 32)
							end
							V105State.RecalcSidebarCanvas()
						end)
						twClose:Play()
					end
				end
			end
			V105State.RecalcSidebarCanvas()
		end
		catObj.SetOpen = ApplyCategoryOpenState

		TrackConnection(InfoHolder.MouseButton1Click:Connect(function()
			ApplyCategoryOpenState(not catObj.IsOpen)
		end))

		OnAccentChanged(function(col)
		end)

		V105State.RecalcSidebarCanvas()
		return InfoHolder
	end


