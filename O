						curX = math.clamp(curX + (rot > 0 and -0.025 or 0.025), 0.12, 0.88)
					end
					for fIdx, fItem in ipairs(bolt.ForkSegs) do
						local anchorSeg = bolt.MainSegs[math.min(#bolt.MainSegs, fIdx * 2)]
						local ax = anchorSeg and anchorSeg.Gui.Position.X.Scale or baseX
						local ay = anchorSeg and anchorSeg.Gui.Position.Y.Scale or (fIdx * 0.22)
						fItem.Gui.Position = UDim2.new(math.clamp(ax + ((fIdx % 2 == 0) and 0.03 or -0.03), 0.10, 0.90), 0, ay + 0.03, 0)
