					SnowContainers.SetBgFireActive(true, m.Spd)
					if callback then pcall(callback, true, m.Spd) end
				end))
			end

			table.insert(SnowContainers.FireBgCallbacks, function(state)
				if not Switch or not Switch.Parent then return end
				TweenService:Create(Switch, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					BackgroundColor3 = state and currentAccentColor or Color3.fromRGB(50, 50, 70)
