				if type(getMirrorScopeFn) == "function" then
					mScope = getMirrorScopeFn()
				elseif type(getMirrorScopeFn) == "table" then
					mScope = getMirrorScopeFn
				end
				if type(mScope) == "table" and type(mScope[methodName]) == "function" then
