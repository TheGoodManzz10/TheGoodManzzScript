					newStageIdx = 1
					-- 35 langkah x ~0.085 dtk = ~3.0 detik penuh (1 titik bertambah tiap 1 detik selama 3 detik & loop!)
					stepDelay = 0.085
				elseif pct >= 36 and pct <= 50 then
