			if lc.Holder and lc.Holder.Parent then
				for bIdx, bolt in ipairs(lc.Bolts) do
					local baseX = 0.22 + (((math.floor((seed * 31) + idx * 17 + bIdx * 29)) % 56) / 100)
					local curX = baseX
					for sIdx, segItem in ipairs(bolt.MainSegs) do
						local rot = ((sIdx + bIdx + math.floor(seed * 7)) % 2 == 0) and (14 + (sIdx * 3) % 10) or -(14 + (sIdx * 4) % 10)
