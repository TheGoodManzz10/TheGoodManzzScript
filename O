	local function ApplyUniversalCurve(radiusVal)
		local r = tonumber(radiusVal) or 20
		customStarlightRadius = r
		customNovaRadius = r
		local targetUDim = UDim.new(0, r)
		local headerUDim = UDim.new(0, math.max(12, r - 4))
		local innerUDim = UDim.new(0, math.max(10, math.floor(r * 0.55)))

		-- Set langsung & sinkronkan semua UICorner utama (UI 1, UI 2, UI 3, Settings UI 1, Command List, Detail Command)
		if MainCorner then MainCorner.CornerRadius = targetUDim end
		if TopCorner then TopCorner.CornerRadius = targetUDim end
		if StarlightCorner then StarlightCorner.CornerRadius = targetUDim end
		if StarlightHeaderCorner then StarlightHeaderCorner.CornerRadius = headerUDim end
		if SSHCorner then SSHCorner.CornerRadius = innerUDim end
		if NTBCorner then NTBCorner.CornerRadius = innerUDim end
		if NSPCorner then NSPCorner.CornerRadius = targetUDim end
		if CLCorner then CLCorner.CornerRadius = targetUDim end

		-- Sinkronkan semua layer Glow, Wallpaper Background, StaticBase, ShaderHolder & CinemaPanImg agar 100% melengkung sempurna tanpa sudut kotak!
		for _, gItem in ipairs(GlowCornersToSync) do
			if gItem.C1 then gItem.C1.CornerRadius = targetUDim end
			if gItem.C2 then gItem.C2.CornerRadius = targetUDim end
			if gItem.C3 then gItem.C3.CornerRadius = targetUDim end
		end
		for _, bItem in ipairs(BgImageLabels) do
			if bItem.Corner then bItem.Corner.CornerRadius = targetUDim end
			if bItem.BaseCorner then bItem.BaseCorner.CornerRadius = targetUDim end
		end
		for _, vItem in ipairs(V105State.VideoFrames) do
			if vItem.Corner then vItem.Corner.CornerRadius = targetUDim end
			if vItem.ShaderCorner then vItem.ShaderCorner.CornerRadius = targetUDim end
			if vItem.CinemaCorner then vItem.CinemaCorner.CornerRadius = targetUDim end
		end
	end

