			mbar.BackgroundTransparency = 0.78
			mbar.BorderSizePixel = 0
			mbar.Position = UDim2.new(0.06 + (mIdx - 1) * (0.88 / mBarCount), 2, 0.96, 0)
			mbar.Size = UDim2.new(0.88 / mBarCount, -4, 0.26, 0)
			mbar.Active = false
			mbar.ZIndex = (baseZIndex or 8)
			local mc = Instance.new("UICorner"); mc.CornerRadius = UDim.new(0, 4); mc.Parent = mbar
			table.insert(matrixBars, mbar)
		end

		local BgVid = nil
		pcall(function()
			BgVid = Instance.new("VideoFrame")
