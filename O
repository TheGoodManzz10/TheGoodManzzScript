				rainSplashClock = rainSplashClock + rawDt
				local step = rawDt * SnowContainers.RainSpeedMultiplier
				for _, rc in ipairs(SnowContainers.RainList) do
					if rc.Holder and rc.Holder.Parent and rc.Holder.Visible and rc.ParentFrame and rc.ParentFrame.Visible then
						for _, d in ipairs(rc.Drops) do
							d.Y = d.Y + (d.SpeedY * step)
							d.X = d.X - (d.WindX * step)
							if d.Y > 1.05 then
								d.Y = -0.08
							end
							if d.X < -0.04 then
								d.X = 1.02
							end
							d.Gui.Position = UDim2.new(d.X, 0, d.Y, 0)
						end
						if rc.Splashes then
							for _, sp in ipairs(rc.Splashes) do
								local wave = math.abs(math.sin((rainSplashClock * 3.8) + sp.Phase))
								sp.Gui.Size = UDim2.new(0, math.floor(4 + wave * 6), 0, 2)
								sp.Gui.BackgroundTransparency = 0.55 + (wave * 0.40)
							end
						end
					end
				end
			end

			-- 2. Update Animasi Petir Menyambar Halus & Natural (Soft Distant Lightning)
			if SnowContainers.IsLightningActive then
				SnowContainers.LightningClock = SnowContainers.LightningClock + rawDt
				if SnowContainers.ActiveStrikeTimer > 0 then
					SnowContainers.ActiveStrikeTimer = math.max(0, SnowContainers.ActiveStrikeTimer - rawDt)
					local prog = 1 - (SnowContainers.ActiveStrikeTimer / math.max(0.01, SnowContainers.ActiveStrikeDuration))
					-- Fade-in dan fade-out lembut menggunakan kurva sinus halus (tidak berkedip kasar / tidak bar-bar!)
					local env = math.sin(math.clamp(prog, 0, 1) * math.pi)
					local boltAlpha = math.clamp(1 - (env * 0.68), 0.32, 1)
					local flashAlpha = math.clamp(1 - (env * 0.11), 0.89, 1)

					for _, lc in ipairs(SnowContainers.LightningList) do
						if lc.Holder and lc.Holder.Parent and lc.Holder.Visible and lc.ParentFrame and lc.ParentFrame.Visible then
							if lc.SkyFlash then
								lc.SkyFlash.BackgroundTransparency = flashAlpha
							end
							for _, bolt in ipairs(lc.Bolts) do
								for _, segItem in ipairs(bolt.MainSegs) do
									segItem.Gui.BackgroundTransparency = boltAlpha
									segItem.Stroke.Transparency = math.clamp(boltAlpha + 0.22, 0, 1)
								end
								for _, fItem in ipairs(bolt.ForkSegs) do
									fItem.Gui.BackgroundTransparency = math.clamp(boltAlpha + 0.18, 0, 1)
									fItem.Stroke.Transparency = math.clamp(boltAlpha + 0.32, 0, 1)
								end
							end
						end
					end
					if SnowContainers.ActiveStrikeTimer <= 0 then
						for _, lc in ipairs(SnowContainers.LightningList) do
							if lc.SkyFlash then lc.SkyFlash.BackgroundTransparency = 1 end
							for _, bolt in ipairs(lc.Bolts) do
								for _, segItem in ipairs(bolt.MainSegs) do
									segItem.Gui.BackgroundTransparency = 1
									segItem.Stroke.Transparency = 1
								end
								for _, fItem in ipairs(bolt.ForkSegs) do
									fItem.Gui.BackgroundTransparency = 1
									fItem.Stroke.Transparency = 1
								end
							end
						end
					end
				else
					SnowContainers.NextStrikeCountdown = SnowContainers.NextStrikeCountdown - (rawDt * SnowContainers.LightningFreqMultiplier)
					if SnowContainers.NextStrikeCountdown <= 0 then
						local nextWait = 3.8 + ((math.floor(SnowContainers.LightningClock * 19) % 240) / 100)
						SnowContainers.NextStrikeCountdown = nextWait
						SnowContainers.TriggerLightningStrikeNow()
					end
				end
			end
		end))
	end

