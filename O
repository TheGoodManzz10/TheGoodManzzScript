	local function SelectTabEntry(entry)
		activeTabEntry = entry
		local isNovaNow = (starlightStage == 2)
		local baseX = isNovaNow and 14 or 142
		local baseY = isNovaNow and 96 or 52
		for _, item in ipairs(TabEntries) do
			local isSelected = (item == entry)
			if item.ContentFrame and item.ContentFrame.Parent then
				item.ContentFrame.Visible = isSelected
				if isSelected then
					item.ContentFrame.Position = UDim2.new(0, baseX, 0, baseY + 8)
					TweenService:Create(item.ContentFrame, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						Position = UDim2.new(0, baseX, 0, baseY)
					}):Play()
				end
			end
			if item.SideBtn and item.SideBtn.Parent then
				TweenService:Create(item.SideBtn, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					BackgroundColor3 = isSelected and Color3.fromRGB(38, 38, 56) or Color3.fromRGB(25, 25, 36)
				}):Play()
				local sLbl = item.SideBtn:FindFirstChild("TabLabel")
				if sLbl then
					TweenService:Create(sLbl, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						TextColor3 = isSelected and currentAccentColor or Color3.fromRGB(170, 170, 190)
					}):Play()
				end
			end
			if item.TopBtn and item.TopBtn.Parent then
				TweenService:Create(item.TopBtn, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					BackgroundColor3 = isSelected and currentAccentColor or Color3.fromRGB(30, 30, 44)
				}):Play()
				local tLbl = item.TopBtn:FindFirstChild("TabLabel")
				if tLbl then
