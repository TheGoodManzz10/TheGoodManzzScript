	-- SELALU menampilkan Avatar GoodManz1081 / GoodManzz1081, BUKAN Avatar orang lain yang menjalankan script!
	function V105State.BindCreatorAvatar(headShotImg, bustImg, statusLbl)
		task.defer(function()
			local creatorUid = V105State.CachedCreatorUserId
			local creatorName = V105State.CachedCreatorName or "GoodManz1081"

			if not creatorUid then
				for _, candidate in ipairs({ "GoodManz1081", "GoodManzz1081", "GoodManzz" }) do
					if type(Players.GetUserIdFromNameAsync) == "function" then
						local ok, uid = pcall(function()
							return Players:GetUserIdFromNameAsync(candidate)
						end)
						if ok and type(uid) == "number" and uid > 0 then
							creatorUid = uid
							creatorName = candidate
							V105State.CachedCreatorUserId = uid
							V105State.CachedCreatorName = candidate
							break
						end
					end
				end
			end

			-- Hanya gunakan LocalPlayer.UserId jika pemain itu sendiri adalah GoodManz1081 / GoodManzz1081
			if not creatorUid then
				local lpName = tostring(LocalPlayer and LocalPlayer.Name or "")
				if lpName:lower():find("goodmanz") and LocalPlayer and LocalPlayer.UserId then
					creatorUid = LocalPlayer.UserId
					creatorName = lpName
					V105State.CachedCreatorUserId = creatorUid
					V105State.CachedCreatorName = creatorName
				else
					creatorUid = 1
					creatorName = "GoodManz1081 / GoodManzz1081"
				end
			end

			local headUri = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(creatorUid) .. "&w=420&h=420"
			local bustUri = "rbxthumb://type=AvatarBust&id=" .. tostring(creatorUid) .. "&w=420&h=420"

			pcall(function()
				local hContent = Players:GetUserThumbnailAsync(creatorUid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
				if hContent and tostring(hContent) ~= "" and tostring(hContent) ~= "rbxassetid://0" then
					headUri = tostring(hContent)
				end
			end)
			pcall(function()
				local bContent = Players:GetUserThumbnailAsync(creatorUid, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)
				if bContent and tostring(bContent) ~= "" and tostring(bContent) ~= "rbxassetid://0" then
					bustUri = tostring(bContent)
				end
			end)

			if headShotImg and headShotImg.Parent then
				headShotImg.Image = headUri
				headShotImg:SetAttribute("CreatorUsername", creatorName)
				headShotImg:SetAttribute("CreatorUserId", creatorUid)
			end
			if bustImg and bustImg.Parent then
				bustImg.Image = bustUri
				bustImg:SetAttribute("CreatorUsername", creatorName)
				bustImg:SetAttribute("CreatorUserId", creatorUid)
			end
			if statusLbl and statusLbl.Parent then
				statusLbl.Text = "Avatar Resmi Owner: " .. tostring(creatorName) .. " (GoodManz1081 / GoodManzz1081)"
			end
		end)
	end

