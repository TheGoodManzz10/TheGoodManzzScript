	function Elements:AddNotification(title, message, duration)
		duration = tonumber(duration) or 3
		local tStr = tostring(title or "Notifikasi")
		local mStr = tostring(message or "")
		local low = (tStr .. " " .. mStr):lower()

		local notifIcon = "lucide-bell-ring"
		if low:find("gagal") or low:find("error") or low:find("salah") or low:find("off") or low:find("mati") or low:find("batal") then
			notifIcon = "lucide-alert-triangle"
		elseif low:find("berhasil") or low:find("aktif") or low:find("disimpan") or low:find("siap") or low:find("selesai") or low:find("on") then
			notifIcon = "lucide-check-circle-2"
		elseif low:find("command") or low:find(";") then
			notifIcon = "lucide-terminal"
		end

		-- Bersihkan notifikasi lama jika menumpuk lebih dari 2 agar tetap ringan & bertumpuk rapi di tempat yang sama
		local existingNotifs = NotifHolder:GetChildren()
		if #existingNotifs >= 2 then
			for i = 1, (#existingNotifs - 1) do
				local oldN = existingNotifs[i]
				if oldN and oldN:IsA("GuiObject") then
					pcall(function() oldN:Destroy() end)
				end
			end
		end

		notifStackZCounter = notifStackZCounter + 5
		if notifStackZCounter > 480 then
			notifStackZCounter = 351
		end
		local baseZ = notifStackZCounter

		local NotifGui = Instance.new("Frame")
		NotifGui.Name = "CyberToastNotif"
		NotifGui.Parent = NotifHolder
		NotifGui.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
		NotifGui.BackgroundTransparency = 0.04
		NotifGui.AnchorPoint = Vector2.new(0, 1)
		NotifGui.Position = UDim2.new(0, 0, 1, 0)
		NotifGui.Size = UDim2.new(0, 282, 0, 0)
		NotifGui.ClipsDescendants = true
		NotifGui.ZIndex = baseZ

		local NotifCorner = Instance.new("UICorner")
		NotifCorner.CornerRadius = UDim.new(0, 10)
		NotifCorner.Parent = NotifGui

		local NotifStroke = Instance.new("UIStroke")
		NotifStroke.Color = currentAccentColor
		NotifStroke.Thickness = 1.4
		NotifStroke.Transparency = 0.25
		NotifStroke.Parent = NotifGui

		-- Garis Aksen Bercahaya di Sisi Kiri
		local LeftAccentBar = Instance.new("Frame")
		LeftAccentBar.Parent = NotifGui
		LeftAccentBar.BackgroundColor3 = currentAccentColor
		LeftAccentBar.BorderSizePixel = 0
		LeftAccentBar.Position = UDim2.new(0, 0, 0, 0)
		LeftAccentBar.Size = UDim2.new(0, 4, 1, 0)
		LeftAccentBar.ZIndex = baseZ + 1

		-- Lingkaran Badge Ikon Modern
		local IconBadge = Instance.new("Frame")
		IconBadge.Parent = NotifGui
		IconBadge.BackgroundColor3 = TintWithAccent(Color3.fromRGB(30, 30, 46), currentAccentColor, 0.28)
		IconBadge.Position = UDim2.new(0, 12, 0.5, -17)
		IconBadge.Size = UDim2.new(0, 32, 0, 32)
		IconBadge.ZIndex = baseZ + 1

		local IBCorner = Instance.new("UICorner")
		IBCorner.CornerRadius = UDim.new(0, 8)
		IBCorner.Parent = IconBadge

		CreateIcon(notifIcon, IconBadge, UDim2.new(0.5, -9, 0.5, -9), UDim2.new(0, 18, 0, 18), baseZ + 2)

		local TitleLbl = Instance.new("TextLabel")
		TitleLbl.Parent = NotifGui
		TitleLbl.BackgroundTransparency = 1
		TitleLbl.Position = UDim2.new(0, 52, 0, 8)
		TitleLbl.Size = UDim2.new(1, -80, 0, 16)
		TitleLbl.Font = currentFontBold
		TitleLbl:SetAttribute("IsBoldFont", true)
		TitleLbl:SetAttribute("IgnoreTextColor", true)
		TitleLbl.Text = tStr
		TitleLbl.TextColor3 = currentTextThemeColor
		TitleLbl.TextSize = 11
		TitleLbl.TextTruncate = Enum.TextTruncate.AtEnd
		TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
		TitleLbl.ZIndex = baseZ + 2

		local MsgLbl = Instance.new("TextLabel")
		MsgLbl.Parent = NotifGui
		MsgLbl.BackgroundTransparency = 1
		MsgLbl.Position = UDim2.new(0, 52, 0, 25)
		MsgLbl.Size = UDim2.new(1, -64, 0, 26)
		MsgLbl.Font = currentFontRegular
		MsgLbl.Text = mStr
		MsgLbl.TextColor3 = currentTextThemeColor
		MsgLbl.TextSize = 10
		MsgLbl.TextWrapped = true
		MsgLbl.TextXAlignment = Enum.TextXAlignment.Left
		MsgLbl.TextYAlignment = Enum.TextYAlignment.Top
		MsgLbl.ZIndex = baseZ + 2

		local DismissBtn = Instance.new("TextButton")
		DismissBtn.Parent = NotifGui
		DismissBtn.BackgroundTransparency = 1
		DismissBtn.Position = UDim2.new(1, -24, 0, 6)
		DismissBtn.Size = UDim2.new(0, 18, 0, 18)
		DismissBtn.Font = Enum.Font.GothamBold
		DismissBtn.Text = "X"
		DismissBtn.TextColor3 = Color3.fromRGB(160, 165, 190)
		DismissBtn.TextSize = 10
		DismissBtn.ZIndex = baseZ + 3

		-- Progress Bar Waktu Mundur di Bagian Bawah Kartu Notifikasi
		local TimerBg = Instance.new("Frame")
		TimerBg.Parent = NotifGui
		TimerBg.BackgroundColor3 = Color3.fromRGB(32, 32, 46)
		TimerBg.BorderSizePixel = 0
		TimerBg.Position = UDim2.new(0, 0, 1, -3)
		TimerBg.Size = UDim2.new(1, 0, 0, 3)
		TimerBg.ZIndex = baseZ + 2

		local TimerFill = Instance.new("Frame")
		TimerFill.Parent = TimerBg
		TimerFill.BackgroundColor3 = currentAccentColor
		TimerFill.BorderSizePixel = 0
		TimerFill.Size = UDim2.new(1, 0, 1, 0)
		TimerFill.ZIndex = baseZ + 3

		OnAccentChanged(function(col)
			NotifStroke.Color = col
			LeftAccentBar.BackgroundColor3 = col
			TimerFill.BackgroundColor3 = col
		end)

		local closed = false
		local function CloseNotif()
			if closed or not NotifGui or not NotifGui.Parent then
				return
			end
			closed = true
			local tweenOut = TweenService:Create(NotifGui, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
				Size = UDim2.new(0, 282, 0, 0),
				BackgroundTransparency = 1
			})
			tweenOut:Play()
			tweenOut.Completed:Once(function()
				if NotifGui and NotifGui.Parent then
					NotifGui:Destroy()
				end
			end)
		end

		TrackConnection(DismissBtn.MouseButton1Click:Connect(CloseNotif))

		TweenService:Create(NotifGui, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 282, 0, 60)
		}):Play()

		TweenService:Create(TimerFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
			Size = UDim2.new(0, 0, 1, 0)
		}):Play()

		task.delay(duration, CloseNotif)
	end

	function Elements:PlayHorizonIntro(cb)
		PlayAetherHorizonIntro(cb)
	end
	function AetherLib:PlayHorizonIntro(cb)
		PlayAetherHorizonIntro(cb)
	end
	function AetherLib:MakeNotification(msg, col)
		Elements:AddNotification("AetherLib", tostring(msg or ""), 3)
	end

	RunAllDynamicRefreshes()
	SafeDefer(RunAllDynamicRefreshes)

	return Elements
end

function AetherLib:Unload()
	for _, conn in ipairs(AetherLib.Connections) do
		if conn and conn.Connected then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	AetherLib.Connections = {}

	for _, inst in ipairs(AetherLib.Instances) do
		if inst then
			pcall(function()
				inst:Destroy()
			end)
		end
	end
	AetherLib.Instances = {}
	AetherLib.RegisteredCommands = {}
end

return AetherLib
