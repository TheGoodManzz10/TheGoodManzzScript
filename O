	local function ToggleUI(state)
		if not MainFrame or not MainFrame.Parent then
			return
		end
		if V105State.ActiveMainTween then
			pcall(function() V105State.ActiveMainTween:Cancel() end)
			V105State.ActiveMainTween = nil
		end
		if state then
			if StarlightFrame and StarlightFrame.Parent and StarlightFrame.Visible then
				StarlightFrame.Visible = false
				starlightStage = 0
			end
			isAnimating = true
			if not MainFrame.Visible then
				MainFrame.Size = UDim2.new(0, 300, 0, 0)
				MainFrame.Visible = true
			end
			local tween = TweenService:Create(MainFrame, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Size = UDim2.new(0, 300, 0, 420)
			})
			V105State.ActiveMainTween = tween
			tween:Play()
			tween.Completed:Once(function()
				if V105State.ActiveMainTween == tween then
					V105State.ActiveMainTween = nil
					isAnimating = false
				end
			end)
		else
			isAnimating = true
			local tween = TweenService:Create(MainFrame, TweenInfo.new(0.50, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Size = UDim2.new(0, 300, 0, 0)
			})
			V105State.ActiveMainTween = tween
			tween:Play()
			tween.Completed:Once(function()
				if V105State.ActiveMainTween == tween then
					MainFrame.Visible = false
					V105State.ActiveMainTween = nil
					isAnimating = false
				end
			end)
