			V105State.IsVideoActive = (resolvedUri ~= "")
			V105State.IsBgVideoActive = V105State.IsVideoActive
			V105State.IsWorkspaceVideoActive = (isWsVid == true)

			for _, box in ipairs(V105State.VideoInputBoxes) do
				if box and box.Parent and box.Text ~= V105State.CurrentVideoRaw then
					box.Text = V105State.CurrentVideoRaw
				end
			end

			if V105State.IsBgVideoActive and shouldSave ~= false then
				V105State.RegisterSavedVideo(V105State.CurrentVideoRaw)
			end

			-- Sembunyikan gambar background statis saat Background Video aktif agar tidak menutupi video workspace!
			for _, bItem in ipairs(BgImageLabels) do
				if bItem.Label and bItem.Label.Parent then
					if V105State.IsBgVideoActive then
						bItem.Label.Visible = false
					else
						bItem.Label.Visible = (currentBgImageUri ~= "")
					end
				end
			end

			for _, vItem in ipairs(V105State.VideoFrames) do
				local vf = vItem.Video
				if vf and vf.Parent then
					vf.Visible = V105State.IsBgVideoActive
					pcall(function()
						vf.Video = resolvedUri
						vf.Looped = true
						vf.Volume = V105State.VideoVolume or 0
						if V105State.IsBgVideoActive then
							vf.TimePosition = 0
						end
					end)
					if vItem.ShaderHolder then
						vItem.ShaderHolder.Visible = V105State.IsBgVideoActive
					end
				end
			end

			V105State.WakeAndSyncVideoFrames()

			if V105State.IsBgVideoActive then
				V105State.UpdateVideoStatusUI("Status Background Video: AKTIF Loop (" .. tostring(desc) .. ")")
			else
				V105State.UpdateVideoStatusUI("Status Background Video: NONAKTIF (Background Normal)")
			end
			return V105State.IsBgVideoActive, desc
		end

		V105State.PlayTableVideo = V105State.ApplyCustomVideoBackground

		-- Loop Real-Time 60FPS untuk menjaga Loop Background Video tanpa me-reset decoder video Workspace!
		local lastVidWatchdog = 0
		TrackConnection(RunService.RenderStepped:Connect(function(dt)
			if not V105State.IsBgVideoActive then return end
			dt = math.min(dt or 0.016, 0.05)
			V105State.BgVideoClock = V105State.BgVideoClock + dt
			local t = V105State.BgVideoClock

			local raw = tostring(V105State.CurrentBgVideoRaw or "")
			local c1, c2, c3
			if raw:find("5608297917") then
				c1 = Color3.fromRGB(10, 48, 38)
				c2 = Color3.fromRGB(12, 22, 36)
				c3 = Color3.fromRGB(16, 82, 68)
			elseif raw:find("5608327482") then
				c1 = Color3.fromRGB(56, 16, 62)
				c2 = Color3.fromRGB(18, 14, 38)
				c3 = Color3.fromRGB(78, 22, 54)
			elseif raw:find("5608304953") then
				c1 = Color3.fromRGB(14, 42, 78)
				c2 = Color3.fromRGB(10, 18, 36)
				c3 = Color3.fromRGB(22, 68, 96)
			else
				c1 = TintWithAccent(Color3.fromRGB(16, 20, 38), currentAccentColor, 0.35)
				c2 = Color3.fromRGB(10, 12, 24)
				c3 = TintWithAccent(Color3.fromRGB(22, 26, 48), currentAccentColor, 0.45)
			end

			for _, vItem in ipairs(V105State.VideoFrames) do
				local vf = vItem.Video
				if vf and vf.Parent and vf.Visible and vItem.Frame and vItem.Frame.Visible then
					-- Hanya sembunyikan Cinema Shader jika VideoFrame benar-benar sudah merender frame video bergerak (TimePosition > 0.08)!
					-- Dengan begitu, jika file .mp4/.webm dari Workspace tidak didukung VideoFrame bawaan Android,
					-- Cinema Motion Video Engine 60FPS di ShaderHolder tetap menampilkan video bergerak 100%!
					local nativeReady = false
					pcall(function()
						if vf.IsLoaded and vf.TimeLength and vf.TimeLength > 0 and vf.TimePosition and vf.TimePosition > 0.08 then
							nativeReady = true
						end
					end)
					if vItem.ShaderHolder then
						vItem.ShaderHolder.Visible = not nativeReady
						if not nativeReady then
							if vItem.ShaderGrad then
								vItem.ShaderGrad.Color = ColorSequence.new({
									ColorSequenceKeypoint.new(0, c1),
									ColorSequenceKeypoint.new(0.5, c2),
									ColorSequenceKeypoint.new(1, c3)
								})
								vItem.ShaderGrad.Rotation = (t * 22) % 360
							end
							if vItem.CinemaPanImg then
								local zoom = 1.16 + math.sin(t * 0.85) * 0.05
								local maxPan = 0.045
								local panX = 0.5 + math.sin(t * 0.65) * maxPan
								local panY = 0.5 + math.cos(t * 0.52) * maxPan
								vItem.CinemaPanImg.Position = UDim2.new(panX, 0, panY, 0)
								vItem.CinemaPanImg.Size = UDim2.new(zoom, 0, zoom, 0)
								vItem.CinemaPanImg.Rotation = 0
								if currentBgImageUri ~= "" and vItem.CinemaPanImg.Image ~= currentBgImageUri then
									vItem.CinemaPanImg.Image = currentBgImageUri
								end
							end
							if vItem.WaveBeams then
								for bIdx, beam in ipairs(vItem.WaveBeams) do
									local yPos = 0.07 + (((t * (0.14 + bIdx * 0.03)) + (bIdx * 0.15)) % 0.76)
									local hScale = 0.06 + 0.035 * math.sin(t * 2.4 + bIdx)
									beam.Position = UDim2.new(0.05, 0, yPos, 0)
									beam.Size = UDim2.new(0.90, 0, hScale, 0)
									beam.BackgroundColor3 = currentAccentColor
								end
							end
							if vItem.MatrixBars then
								for mIdx, mbar in ipairs(vItem.MatrixBars) do
									local mWave = 0.10 + 0.38 * math.abs(math.sin((t * 3.2) + (mIdx * 0.7)))
									mbar.Size = UDim2.new(0.88 / #vItem.MatrixBars, -4, mWave, 0)
									mbar.BackgroundColor3 = currentAccentColor
							end
							end
						end
					end
				end
			end

			lastVidWatchdog = lastVidWatchdog + dt
			if lastVidWatchdog >= 1.0 then
				lastVidWatchdog = 0
				for _, vItem in ipairs(V105State.VideoFrames) do
					local vf = vItem.Video
					local isPanelVisible = (vItem.Frame and vItem.Frame.Parent and vItem.Frame.Visible == true)
					if vf and vf.Parent then
						if isPanelVisible and vf.Visible then
							pcall(function()
								vf.Looped = true
								if vf.Video ~= V105State.CurrentBgVideoUri then
									vf.Video = V105State.CurrentBgVideoUri
								end
								local curPos = tonumber(vf.TimePosition) or 0
								local tLen = tonumber(vf.TimeLength) or 0
								if tLen > 0 and curPos >= (tLen - 0.08) then
									vf.TimePosition = 0
									vf.Playing = true
									vf:Play()
								elseif not vf.Playing then
									vf.Playing = true
									vf:Play()
								end
							end)
						else
							pcall(function()
								if vf.Playing then
									vf.Playing = false
									vf:Pause()
								end
							end)
						end
					end
				end
			end
		end))
	end

	local function AttachCustomBackground(targetFrame, cornerRadiusUDim, baseZIndex)
		SnowContainers.BgImageRefs = BgImageLabels
		local initCornerUDim = cornerRadiusUDim or UDim.new(0, 20)

		-- Gunakan CanvasGroup sebagai kontainer tunggal Wallpaper agar 100% melengkung mengikuti UICorner
