		BgImg.Image = currentBgImageUri
		BgImg.ImageTransparency = (currentBgImageUri ~= "") and currentBgTransparency or 1
		BgImg.ScaleType = currentBgScaleType
		BgImg.Visible = (currentBgImageUri ~= "") and (not V105State.IsBgVideoActive)
