		infoTitle = tostring(infoTitle or "Informasi")
		if V105State.SidebarCategoryObjects[infoTitle] then
			return V105State.SidebarCategoryObjects[infoTitle].Button
		end

		-- Sesuai permintaan v5.0.0: Saat UI pertama kali dibuka, semua kategori tab pada UI 2 ditutup (IsOpen = false)!
		local catObj = {
