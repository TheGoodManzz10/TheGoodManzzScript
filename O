	local isLightningRunning = false
	function Elements:LightningEffect()
		if isLightningRunning then
			return
		end
		isLightningRunning = true
		task.spawn(function()
			while ScreenGui and ScreenGui.Parent and MainFrame and MainFrame.Parent and MainStroke do
				TweenService:Create(MainStroke, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {
					Color = Color3.fromRGB(255, 255, 255),
					Transparency = 0
				}):Play()
				task.wait(0.3)
				if not (ScreenGui and ScreenGui.Parent and MainStroke) then
					break
				end
				TweenService:Create(MainStroke, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {
					Color = currentAccentColor,
					Transparency = 0.4
				}):Play()
				task.wait(0.6)
			end
		end)
	end

	function Elements:AddPerformanceOverlay()
		local existing = ScreenGui:FindFirstChild("PerformanceOverlay")
		if existing then
			return existing
		end

		local PerfFrame = Instance.new("Frame")
		PerfFrame.Name = "PerformanceOverlay"
		PerfFrame.Parent = ScreenGui
		PerfFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
		PerfFrame.BackgroundTransparency = 0.25
		PerfFrame.Position = UDim2.new(0, 15, 0, 15)
		PerfFrame.Size = UDim2.new(0, 190, 0, 26)
		PerfFrame.Visible = not isIntroPlaying
		PerfFrame.ZIndex = 150
		PendingPerfOverlay = PerfFrame

		MakeDraggable(PerfFrame, PerfFrame)

		local Corner = Instance.new("UICorner")
