    MainBtn.Parent = Frame
    MainBtn.BackgroundTransparency = 1
    MainBtn.Size = UDim2.new(1, 0, 0, 42)
    MainBtn.Font = Enum.Font.Gotham
    MainBtn.Text = " " .. name .. " : None"
    MainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MainBtn.TextSize = 12
    MainBtn.TextXAlignment = Enum.TextXAlignment.Left
    MainBtn.ZIndex = 10

    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Parent = Frame
    Scroll.BackgroundTransparency = 1
    Scroll.Position = UDim2.new(0, 8, 0, 42)
    Scroll.Size = UDim2.new(1, -16, 0, 90)
    Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    Scroll.ScrollBarThickness = 3
    Scroll.ZIndex = 10

    local List = Instance.new("UIListLayout")
    List.Parent = Scroll
    List.SortOrder = Enum.SortOrder.LayoutOrder
    List.Padding = UDim.new(0, 4)

    local selectedTable = {}
    local open = false

    TrackConnection(MainBtn.MouseButton1Click:Connect(function()
        open = not open
        TweenService:Create(Frame, TweenInfo.new(0.25), {Size = open and UDim2.new(1, 0, 0, 140) or UDim2.new(1, 0, 0, 42)}):Play()
    end))

    for _, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton")
        OptBtn.Parent = Scroll
        OptBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
        OptBtn.Size = UDim2.new(1, 0, 0, 24)
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.Text = "[ ] " .. opt
        OptBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        OptBtn.TextSize = 10
        OptBtn.ZIndex = 11

        local OptCorner = Instance.new("UICorner")
        OptCorner.CornerRadius = UDim.new(0, 4)
        OptCorner.Parent = OptBtn

        TrackConnection(OptBtn.MouseButton1Click:Connect(function()
            selectedTable[opt] = not selectedTable[opt]
            if selectedTable[opt] then
                OptBtn.Text = "[✓] " .. opt
                OptBtn.TextColor3 = Color3.fromRGB(90, 150, 255)
            else
                OptBtn.Text = "[ ] " .. opt
                OptBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end

            local activeList = {}
            for k, v in pairs(selectedTable) do
                if v then table.insert(activeList, k) end
            end
            MainBtn.Text = " " .. name .. " : " .. (#activeList > 0 and table.concat(activeList, ", ") or "None")
            if callback then pcall(callback, selectedTable) end
        end))
    end
end

