-- 1. Menambahkan Command Bar sebagai Komponen Pilihan dalam ScrollContainer
function Elements:AddCommandBar(placeholder)
    local CmdContainer = Instance.new("Frame")
    CmdContainer.Parent = ScrollContainer
    CmdContainer.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
    CmdContainer.Size = UDim2.new(1, 0, 0, 32)
    CmdContainer.ZIndex = 9
    table.insert(AetherLib.Instances, CmdContainer)

    local CmdContainerCorner = Instance.new("UICorner")
    CmdContainerCorner.CornerRadius = UDim.new(0, 6)
    CmdContainerCorner.Parent = CmdContainer

    local PrefixLbl = Instance.new("TextLabel")
    PrefixLbl.Parent = CmdContainer
    PrefixLbl.BackgroundTransparency = 1
    PrefixLbl.Position = UDim2.new(0, 8, 0, 0)
    PrefixLbl.Size = UDim2.new(0, 12, 1, 0)
    PrefixLbl.Font = Enum.Font.Code
    PrefixLbl.Text = ";"
    PrefixLbl.TextColor3 = Color3.fromRGB(90, 150, 255)
    PrefixLbl.TextSize = 13
    PrefixLbl.ZIndex = 10

    local CmdBar = Instance.new("TextBox")
    CmdBar.Parent = CmdContainer
    CmdBar.BackgroundTransparency = 1
    CmdBar.Position = UDim2.new(0, 20, 0, 0)
    CmdBar.Size = UDim2.new(1, -24, 1, 0)
    CmdBar.Font = Enum.Font.Code
    CmdBar.PlaceholderText = placeholder or "fly 50, ws 100..."
    CmdBar.PlaceholderColor3 = Color3.fromRGB(140, 140, 155)
    CmdBar.Text = ""
    CmdBar.TextColor3 = Color3.fromRGB(255, 255, 255)
    CmdBar.TextSize = 11
    CmdBar.TextXAlignment = Enum.TextXAlignment.Left
    CmdBar.ClearTextOnFocus = false
    CmdBar.ZIndex = 10

    -- Event Eksekusi Perintah
    TrackConnection(CmdBar.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local text = CmdBar.Text
            if text:sub(1,1) == ";" then
                text = text:sub(2)
            end
            if text ~= "" then
                local parts = {}
                for word in text:gmatch("%S+") do
                    table.insert(parts, word)
                end
                local cmdName = string.lower(parts[1] or "")
                table.remove(parts, 1)
                
                if AetherLib.RegisteredCommands[cmdName] then
                    local success, err = pcall(function()
                        AetherLib.RegisteredCommands[cmdName].Callback(parts)
                    end)
                    if success then
                        Elements:AddNotification("Command", "Mengeksekusi: ;" .. cmdName, 2)
                    else
                        Elements:AddNotification("Command Error", tostring(err), 3)
                    end
                else
                    Elements:AddNotification("Command", "Perintah ';" .. cmdName .. "' tidak ditemukan!", 2)
                end
                CmdBar.Text = ""
            end
        end
    end))
end

