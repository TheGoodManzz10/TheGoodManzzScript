    -- Fungsi untuk Refresh Daftar Perintah di dalam Modal
    local function RefreshCommandList()
        for _, child in ipairs(CLScroll:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        for cmdName, cmdData in pairs(AetherLib.RegisteredCommands) do
            local ItemBtn = Instance.new("TextButton")
            ItemBtn.Parent = CLScroll
            ItemBtn.BackgroundColor3 = Color3.fromRGB(42, 42, 56)
            ItemBtn.Size = UDim2.new(1, 0, 0, 26)
            ItemBtn.Font = Enum.Font.Code
            ItemBtn.Text = " > ;" .. cmdName .. " (" .. cmdData.Syntax .. ")"
            ItemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ItemBtn.TextSize = 10
            ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
            ItemBtn.ZIndex = 252

            local ItemCorner = Instance.new("UICorner")
            ItemCorner.CornerRadius = UDim.new(0, 5)
            ItemCorner.Parent = ItemBtn

            TrackConnection(ItemBtn.MouseButton1Click:Connect(function()
                DFTitle.Text = "📌 ;" .. cmdName
                DFDesc.Text = "Sintaks: ;" .. cmdData.Syntax .. "\nKegunaan: " .. cmdData.Desc
                DetailFrame.Visible = true
            end))
        end
    end

    TrackConnection(CmdListBtn.MouseButton1Click:Connect(function()
        RefreshCommandList()
        CmdListFrame.Visible = not CmdListFrame.Visible
    end))
end

    -------------------------------------------------------------------
    -- REGISTRASI DAN EKSEKUSI PERINTAH
    -------------------------------------------------------------------
    function AetherLib:RegisterCommand(name, description, syntax, callback)
        name = string.lower(name)
        AetherLib.RegisteredCommands[name] = {
            Desc = description or "Tidak ada deskripsi",
            Syntax = syntax or name,
            Callback = callback
        }
        RefreshCommandList()
    end

    function Elements:AddCommand(name, description, syntax, callback)
        AetherLib:RegisterCommand(name, description, syntax, callback)
    end

    TrackConnection(CmdBar.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local text = CmdBar.Text
            if text:sub(1,1) == ";" then
                text = text:sub(2)
            end

            if text ~= "" then
                local parts = {}
                for word in text:gmatch("%S+") do
                    table.insert(parts, word)
                end

                local cmdName = string.lower(parts[1] or "")
                table.remove(parts, 1)

                if AetherLib.RegisteredCommands[cmdName] then
                    local success, err = pcall(function()
                        AetherLib.RegisteredCommands[cmdName].Callback(parts)
                    end)
                    if success then
                        Elements:AddNotification("Command", "Mengeksekusi: ;" .. cmdName, 2)
                    else
                        Elements:AddNotification("Command Error", tostring(err), 3)
                    end
                else
                    Elements:AddNotification("Command", "Perintah ';" .. cmdName .. "' tidak ditemukan!", 2)
                end
                CmdBar.Text = ""
            end
        end
    end))

    -------------------------------------------------------------------
    -- PROSES SEEDING LOADSTRING PERINTAH EKSTERNAL (v5.2)
    -------------------------------------------------------------------
    local targetURL = customCommandsURL or AetherLib.CommandsURL
    task.spawn(function()
        local success, scriptFunc = pcall(function()
            return loadstring(game:HttpGet(targetURL))()
        end)

        if success and type(scriptFunc) == "function" then
            scriptFunc(AetherLib)
            Elements:AddNotification("AetherLib 5.2", "50+ Perintah eksternal dimuat!", 3)
        else
            Elements:AddNotification("AetherLib Error", "Gagal memuat perintah eksternal!", 3)
        end
    end)

