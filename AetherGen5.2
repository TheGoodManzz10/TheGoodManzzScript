    function Elements:AddColorPicker(name, defaultColor, callback)
        defaultColor = defaultColor or Color3.fromRGB(90, 150, 255)

        local PickerFrame = Instance.new("Frame")
        PickerFrame.Parent = ScrollContainer
        PickerFrame.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
        PickerFrame.Size = UDim2.new(1, 0, 0, 72)
        PickerFrame.ZIndex = 9

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 6)
        Corner.Parent = PickerFrame

        local Label = Instance.new("TextLabel")
        Label.Parent = PickerFrame
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 12, 0, 4)
        Label.Size = UDim2.new(1, -50, 0, 20)
        Label.Font = Enum.Font.Gotham
        Label.Text = name
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 12
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.ZIndex = 10

        local PreviewBox = Instance.new("Frame")
        PreviewBox.Parent = PickerFrame
        PreviewBox.BackgroundColor3 = defaultColor
        PreviewBox.Position = UDim2.new(1, -38, 0, 6)
        PreviewBox.Size = UDim2.new(0, 26, 0, 20)
        PreviewBox.ZIndex = 10

        local PreviewCorner = Instance.new("UICorner")
        PreviewCorner.CornerRadius = UDim.new(0, 4)
        PreviewCorner.Parent = PreviewBox

        local r, g, b = math.floor(defaultColor.R * 255), math.floor(defaultColor.G * 255), math.floor(defaultColor.B * 255)

        local function CreateMiniSlider(posY, channelName, initVal, onUpdate)
            local SLabel = Instance.new("TextLabel")
            SLabel.Parent = PickerFrame
            SLabel.BackgroundTransparency = 1
            SLabel.Position = UDim2.new(0, 12, 0, posY)
            SLabel.Size = UDim2.new(0, 30, 0, 16)
            SLabel.Font = Enum.Font.Gotham
            SLabel.Text = channelName .. ":"
            SLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
            SLabel.TextSize = 10
            SLabel.TextXAlignment = Enum.TextXAlignment.Left
            SLabel.ZIndex = 10

            local SBar = Instance.new("Frame")
            SBar.Parent = PickerFrame
            SBar.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
            SBar.Position = UDim2.new(0, 45, 0, posY + 5)
            SBar.Size = UDim2.new(1, -60, 0, 6)
            SBar.ZIndex = 10

            local SBarCorner = Instance.new("UICorner")
            SBarCorner.CornerRadius = UDim.new(1, 0)
            SBarCorner.Parent = SBar

            local SFill = Instance.new("Frame")
            SFill.Parent = SBar
            SFill.BackgroundColor3 = channelName == "R" and Color3.fromRGB(255, 50, 50) or (channelName == "G" and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(50, 100, 255))
            SFill.Size = UDim2.new(initVal / 255, 0, 1, 0)
            SFill.ZIndex = 11

            local SFillCorner = Instance.new("UICorner")
            SFillCorner.CornerRadius = UDim.new(1, 0)
            SFillCorner.Parent = SFill

            local sliding = false
            TrackConnection(SBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    local pos = math.clamp((input.Position.X - SBar.AbsolutePosition.X) / SBar.AbsoluteSize.X, 0, 1)
                    local val = math.floor(pos * 255)
                    SFill.Size = UDim2.new(pos, 0, 1, 0)
                    onUpdate(val)
                end
            end))

            TrackConnection(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end))

            TrackConnection(UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local pos = math.clamp((input.Position.X - SBar.AbsolutePosition.X) / SBar.AbsoluteSize.X, 0, 1)
                    local val = math.floor(pos * 255)
                    SFill.Size = UDim2.new(pos, 0, 1, 0)
                    onUpdate(val)
                end
            end))
        end

        CreateMiniSlider(28, "R", r, function(val)
            r = val
            local newCol = Color3.fromRGB(r, g, b)
            PreviewBox.BackgroundColor3 = newCol
            if callback then pcall(callback, newCol) end
        end)

        CreateMiniSlider(48, "G", g, function(val)
            g = val
            local newCol = Color3.fromRGB(r, g, b)
            PreviewBox.BackgroundColor3 = newCol
            if callback then pcall(callback, newCol) end
        end)
    end

