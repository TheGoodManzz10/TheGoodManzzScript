    GetStroke.Thickness = 1
    GetStroke.Parent = GetKeyBtn

    -- Footer Info
    local FooterLbl = Instance.new("TextLabel")
    FooterLbl.Parent = KeyFrame
    FooterLbl.BackgroundTransparency = 1
    FooterLbl.Position = UDim2.new(0, 18, 0, 185)
    FooterLbl.Size = UDim2.new(1, -36, 0, 16)
    FooterLbl.Font = Enum.Font.Gotham
    FooterLbl.Text = "AetherGen Architecture © 2026"
    FooterLbl.TextColor3 = Color3.fromRGB(100, 100, 120)
    FooterLbl.TextSize = 9
    FooterLbl.TextXAlignment = Enum.TextXAlignment.Center
    FooterLbl.ZIndex = 501

    -- Validasi Logika Key & Durasi
    local attempts = 0
    local function CheckValidation()
        local input = KeyBox.Text
        local isSecret = false
        local isValidKey = false
        local durationSec = 0

        -- 1. Cek Secret Key (Otomatis Permanen)
        for _, sKey in ipairs(secretKeysList) do
            if input == sKey then
                isSecret = true
                isValidKey = true
                break
            end
        end

        -- 2. Cek Key Biasa Berdasarkan Durasi Masing-masing
        if not isValidKey then
            for _, keyData in ipairs(keysList) do
                if input == keyData.Key then
                    isValidKey = true
                    local d = keyData.Days or 0
                    local h = keyData.Hours or 0
                    local m = keyData.Minutes or 0
                    durationSec = (d * 86400) + (h * 3600) + (m * 60)
                    break
                end
            end
        end

        if isValidKey then
            if animConnection then animConnection:Disconnect() end
            if isSecret then
                StatusLbl.Text = "✨ Secret Key Valid! (Akses Permanen)"
            else
                StatusLbl.Text = "✓ Key Valid! Memuat sistem..."
            end
            StatusLbl.TextColor3 = Color3.fromRGB(52, 211, 153) -- Modern Green
            KBStroke.Color = Color3.fromRGB(52, 211, 153)

            TweenService:Create(KeyFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0)
            }):Play()

            task.delay(0.35, function()
                ScreenGui:Destroy()
                if callback then pcall(callback, isSecret, durationSec) end
            end)
        else
            attempts = attempts + 1
            StatusLbl.Text = string.format("✕ Key Salah! Percobaan ke-%d/%d", attempts, maxAttempts)
            StatusLbl.TextColor3 = Color3.fromRGB(248, 113, 113) -- Modern Red
            KBStroke.Color = Color3.fromRGB(248, 113, 113)

            -- Efek Getar Halus (Shake)
            local origPos = KeyFrame.Position
            for _ = 1, 3 do
                KeyFrame.Position = origPos + UDim2.new(0, -4, 0, 0)
                task.wait(0.04)
                KeyFrame.Position = origPos + UDim2.new(0, 4, 0, 0)
                task.wait(0.04)
            end
            KeyFrame.Position = origPos

            if attempts >= maxAttempts then
                KeyBox.Text = ""
                KeyBox.PlaceholderText = "Locked: Maksimal Percobaan!"
                KeyBox.TextEditable = false
                SubmitBtn.Active = false
                SubmitBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
            end
        end
    end

    SubmitBtn.MouseButton1Click:Connect(CheckValidation)
    KeyBox.FocusLost:Connect(function(enter) if enter then CheckValidation() end end)

    GetKeyBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(getLink)
            GetKeyBtn.Text = "Link Copied!"
            task.delay(1.5, function() GetKeyBtn.Text = "Get Key" end)
        end
    end)
end

    return Elements
end

function AetherLib:Unload()
    for _, conn in ipairs(AetherLib.Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    AetherLib.Connections = {}

    for _, inst in ipairs(AetherLib.Instances) do
        if inst then inst:Destroy() end
    end
    AetherLib.Instances = {}
end

return AetherLib
