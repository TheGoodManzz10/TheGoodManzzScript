    local currentKey = defaultKey
    local listening = false

    local function updateToggle(state)
        isToggled = state
        local goalColor = isToggled and Color3.fromRGB(90, 150, 255) or Color3.fromRGB(60, 60, 75)
        local goalPos = isToggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        TweenService:Create(SwitchBg, TweenInfo.new(0.2), {BackgroundColor3 = goalColor}):Play()
        TweenService:Create(Knob, TweenInfo.new(0.2), {Position = goalPos}):Play()
        if callback then pcall(callback, isToggled, currentKey) end
    end

    TrackConnection(SwitchBg.MouseButton1Click:Connect(function()
        updateToggle(not isToggled)
    end))

    TrackConnection(KeyBtn.MouseButton1Click:Connect(function()
        listening = true
        KeyBtn.Text = "..."
    end))

    TrackConnection(UserInputService.InputBegan:Connect(function(input)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            KeyBtn.Text = tostring(currentKey.Name)
            listening = false
        elseif not listening and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
            updateToggle(not isToggled)
        end
    end))
end

-- 6. AddStepSlider (Slider Berkelip / Step Increment Slider)
function Elements:AddStepSlider(name, min, max, step, default, callback)
    step = step or 1
    min = min or 0
    max = max or 100
    default = math.clamp(default or min, min, max)

    local Frame = Instance.new("Frame")
    Frame.Parent = ScrollContainer
    Frame.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
    Frame.Size = UDim2.new(1, 0, 0, 52)
    Frame.ZIndex = 9

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Parent = Frame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 12, 0, 4)
    Label.Size = UDim2.new(1, -24, 0, 20)
    Label.Font = Enum.Font.Gotham
    Label.Text = name .. " : " .. tostring(default)
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 10

    local SliderBar = Instance.new("Frame")
    SliderBar.Parent = Frame
    SliderBar.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
    SliderBar.Position = UDim2.new(0, 12, 0, 32)
    SliderBar.Size = UDim2.new(1, -24, 0, 5)
    SliderBar.ZIndex = 10

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1, 0)
    BarCorner.Parent = SliderBar

    local range = (max - min) == 0 and 1 or (max - min)
    local initialRatio = (default - min) / range

    local Fill = Instance.new("Frame")
    Fill.Parent = SliderBar
    Fill.BackgroundColor3 = Color3.fromRGB(90, 150, 255)
    Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
    Fill.ZIndex = 11

    local Knob = Instance.new("Frame")
    Knob.Parent = SliderBar
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Position = UDim2.new(initialRatio, -8, 0.5, -8)
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.ZIndex = 12

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local sliding = false
    local function update(input)
        local rawPos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
        local rawVal = min + (range * rawPos)
        local steppedVal = math.floor((rawVal / step) + 0.5) * step
        steppedVal = math.clamp(steppedVal, min, max)

        local finalRatio = (steppedVal - min) / range
        Fill.Size = UDim2.new(finalRatio, 0, 1, 0)
        Knob.Position = UDim2.new(finalRatio, -8, 0.5, -8)
        Label.Text = name .. " : " .. tostring(steppedVal)

        if callback then pcall(callback, steppedVal) end
    end

    TrackConnection(Knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true end
    end))

    TrackConnection(SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            update(input)
        end
    end))

    TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
    end))

    TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
end

