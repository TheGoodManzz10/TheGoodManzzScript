-- 2. AddMultiDropdown (Dropdown Pilihan Ganda / Checkbox Multi Select)
function Elements:AddMultiDropdown(name, options, callback)
    local Frame = Instance.new("Frame")
    Frame.Parent = ScrollContainer
    Frame.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
