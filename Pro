				else
					GCard.Size = UDim2.new(1, 0, 0, targetH)
				end
			end

			TrackConnection(HBtn.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				ArrLbl.Text = isOpen and "v" or ">"
				SyncGSize(true)
			end))

			return Body, SyncGSize
		end

