	local function ResolveBackgroundAsset(rawInput)
		local str = tostring(rawInput or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if str == "" or str:lower() == "none" or str:lower() == "reset" or str:lower() == "off" or str:lower() == "normal" or str:lower() == "tanpa gambar" then
			return "", "Tanpa Gambar (Normal)"
		end

		if Icons[str] then
			return Icons[str], "Icon Preset (" .. str .. ")"
		end

		if str:lower():sub(1, 13) == "rbxassetid://" or str:lower():sub(1, 11) == "rbxthumb://" then
			return str, "Roblox Asset URI"
		end

		if str:match("^%d+$") then
			return "rbxthumb://type=Asset&id=" .. str .. "&w=420&h=420", "Roblox Asset/Decal ID (" .. str .. ")"
		end

		if str:lower():find("roblox.com") and str:match("(%d+)") then
			local extractedId = str:match("(%d+)")
			return "rbxthumb://type=Asset&id=" .. extractedId .. "&w=420&h=420", "Roblox Link ID (" .. extractedId .. ")"
		end

		local customAssetFn = (type(getcustomasset) == "function" and getcustomasset)
			or (type(getsynasset) == "function" and getsynasset)

		if str:lower():sub(1, 4) == "http" then
			if customAssetFn and type(writefile) == "function" then
				local okDl, imgData = pcall(function()
					return game:HttpGet(str)
				end)
				if okDl and imgData and #imgData > 0 then
					local cacheFile = "AetherLib_v21_0_Wallpaper.png"
					local okWrite = pcall(function()
						writefile(cacheFile, imgData)
					end)
					if okWrite then
						local okAsset, customUri = pcall(customAssetFn, cacheFile)
						if okAsset and customUri then
							return customUri, "Downloaded PNG -> Workspace (" .. cacheFile .. ")"
						end
					end
				end
			end
			return str, "Direct URL"
		end

		if customAssetFn then
			local candidates = { str, str .. ".png", str .. ".jpg", str .. ".jpeg" }
			for _, candidate in ipairs(candidates) do
				local exists = true
				if type(isfile) == "function" then
					local okCheck, res = pcall(isfile, candidate)
					exists = (okCheck and res == true)
				end
				if exists then
					local okAsset, customUri = pcall(customAssetFn, candidate)
					if okAsset and customUri and tostring(customUri) ~= "" then
						return tostring(customUri), "Workspace File (" .. candidate .. ")"
					end
				end
			end
			local okDirect, directUri = pcall(customAssetFn, str)
			if okDirect and directUri and tostring(directUri) ~= "" then
				return tostring(directUri), "Workspace Asset (" .. str .. ")"
			end
		end

		local anyDigits = str:match("(%d+)")
		if anyDigits then
			return "rbxthumb://type=Asset&id=" .. anyDigits .. "&w=420&h=420", "Roblox ID (" .. anyDigits .. ")"
		end

		return str, "Custom URI"
	end

	local function ApplyCustomBackground(rawInput, customTrans, customScale, skipAutoSave)
		if customTrans ~= nil then
			currentBgTransparency = math.clamp(tonumber(customTrans) or 0.28, 0, 0.95)
		end
		if customScale ~= nil then
			currentBgScaleType = customScale
		end

		local resolvedUri, sourceDesc = ResolveBackgroundAsset(rawInput)
		currentBgRawInput = tostring(rawInput or "")
		currentBgImageUri = resolvedUri

		for _, box in ipairs(BgInputBoxes) do
			if box and box.Parent and box.Text ~= currentBgRawInput then
				box.Text = currentBgRawInput
			end
		end

		local hasBg = (currentBgImageUri ~= "")
		if hasBg and not skipAutoSave then
			RegisterSavedBackground(currentBgRawInput)
		end

		for _, item in ipairs(BgImageLabels) do
			if item.Label and item.Label.Parent then
				item.Label.Image = currentBgImageUri
				item.Label.ImageTransparency = hasBg and currentBgTransparency or 1
				item.Label.ScaleType = currentBgScaleType
				item.Label.Visible = hasBg
				if item.Corner and item.Frame then
					local fc = item.Frame:FindFirstChildOfClass("UICorner")
					if fc then
						item.Corner.CornerRadius = fc.CornerRadius
					end
				end
			end
		end

		return hasBg, sourceDesc
	end

	local function UpdateBackgroundProperties(newTrans, newScale)
		if newTrans ~= nil then
			currentBgTransparency = math.clamp(tonumber(newTrans) or currentBgTransparency, 0, 0.95)
		end
		if newScale ~= nil then
