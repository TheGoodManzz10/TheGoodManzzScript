	local GlowCornersToSync = {}

	local function AttachSunlightGlow(targetFrame, baseZIndex)
		local existingCorner = targetFrame:FindFirstChildOfClass("UICorner")
		local initRad = existingCorner and existingCorner.CornerRadius or UDim.new(0, 10)

		local SunGlowDiagonal = Instance.new("Frame")
		SunGlowDiagonal.Name = "SunlightGlowDiagonal"
		SunGlowDiagonal.Parent = targetFrame
		SunGlowDiagonal.BackgroundColor3 = currentAccentColor
		SunGlowDiagonal.BorderSizePixel = 0
		SunGlowDiagonal.Size = UDim2.new(1, 0, 1, 0)
		SunGlowDiagonal.Active = false
		SunGlowDiagonal.ZIndex = baseZIndex

		local SGDCorner = Instance.new("UICorner")
		SGDCorner.CornerRadius = initRad
		SGDCorner.Parent = SunGlowDiagonal

		local DiagGrad = Instance.new("UIGradient")
		DiagGrad.Rotation = 42
		DiagGrad.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.54),
			NumberSequenceKeypoint.new(0.32, 0.80),
			NumberSequenceKeypoint.new(0.68, 0.94),
			NumberSequenceKeypoint.new(1, 1.0)
		})
		DiagGrad.Parent = SunGlowDiagonal

		local SunGlowTop = Instance.new("Frame")
		SunGlowTop.Name = "SunlightGlowTop"
		SunGlowTop.Parent = targetFrame
		SunGlowTop.BackgroundColor3 = currentAccentColor
		SunGlowTop.BorderSizePixel = 0
		SunGlowTop.Size = UDim2.new(1, 0, 1, 0)
		SunGlowTop.Active = false
		SunGlowTop.ZIndex = baseZIndex

		local SGTCorner = Instance.new("UICorner")
		SGTCorner.CornerRadius = initRad
		SGTCorner.Parent = SunGlowTop

		local TopGrad = Instance.new("UIGradient")
		TopGrad.Rotation = 90
		TopGrad.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.66),
			NumberSequenceKeypoint.new(0.28, 0.88),
			NumberSequenceKeypoint.new(0.6, 0.97),
			NumberSequenceKeypoint.new(1, 1.0)
		})
		TopGrad.Parent = SunGlowTop

		table.insert(GlowCornersToSync, { Frame = targetFrame, C1 = SGDCorner, C2 = SGTCorner })
		if existingCorner then
			TrackConnection(existingCorner:GetPropertyChangedSignal("CornerRadius"):Connect(function()
				SGDCorner.CornerRadius = existingCorner.CornerRadius
				SGTCorner.CornerRadius = existingCorner.CornerRadius
			end))
		end

		OnAccentChanged(function(col)
			SunGlowDiagonal.BackgroundColor3 = col
			SunGlowTop.BackgroundColor3 = col
		end)
	end

