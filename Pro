			Label.TextColor3 = currentTextThemeColor
			Label.TextSize = 11
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = zBase + 1

			local SliderBar = Instance.new("Frame")
			SliderBar.Parent = RangeFrame
			SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), currentAccentColor, 0.22)
			SliderBar.Position = UDim2.new(0, 10, 0, 30)
			SliderBar.Size = UDim2.new(1, -20, 0, 6)
			SliderBar.ZIndex = zBase + 1

			local BarCorner = Instance.new("UICorner")
			BarCorner.CornerRadius = UDim.new(1, 0)
			BarCorner.Parent = SliderBar

			local range = (max - min) == 0 and 1 or (max - min)
			local minRatio = (defaultMin - min) / range
			local maxRatio = (defaultMax - min) / range

			local Fill = Instance.new("Frame")
			Fill.Parent = SliderBar
			Fill.BackgroundColor3 = currentAccentColor
			Fill.Position = UDim2.new(minRatio, 0, 0, 0)
			Fill.Size = UDim2.new(maxRatio - minRatio, 0, 1, 0)
			Fill.ZIndex = zBase + 2

			local currentMin, currentMax = defaultMin, defaultMax

			local KnobMin = Instance.new("Frame")
			KnobMin.Parent = SliderBar
			KnobMin.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			KnobMin.Position = UDim2.new(minRatio, -7, 0.5, -7)
			KnobMin.Size = UDim2.new(0, 14, 0, 14)
			KnobMin.ZIndex = zBase + 3

			local KnobMinCorner = Instance.new("UICorner")
			KnobMinCorner.CornerRadius = UDim.new(1, 0)
			KnobMinCorner.Parent = KnobMin

			local KMStroke = Instance.new("UIStroke")
			KMStroke.Color = currentAccentColor
			KMStroke.Thickness = 2
			KMStroke.Parent = KnobMin

			local KnobMax = Instance.new("Frame")
			KnobMax.Parent = SliderBar
			KnobMax.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			KnobMax.Position = UDim2.new(maxRatio, -7, 0.5, -7)
			KnobMax.Size = UDim2.new(0, 14, 0, 14)
			KnobMax.ZIndex = zBase + 3

			local KnobMaxCorner = Instance.new("UICorner")
			KnobMaxCorner.CornerRadius = UDim.new(1, 0)
			KnobMaxCorner.Parent = KnobMax

			local KXStroke = Instance.new("UIStroke")
			KXStroke.Color = currentAccentColor
			KXStroke.Thickness = 2
			KXStroke.Parent = KnobMax

			OnAccentChanged(function(col)
				Fill.BackgroundColor3 = col
				KMStroke.Color = col
				KXStroke.Color = col
				SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.22)
			end)

			local slidingMin, slidingMax = false, false

			TrackConnection(KnobMin.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					slidingMin = true
				end
			end))
			TrackConnection(KnobMax.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					slidingMax = true
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					slidingMin, slidingMax = false, false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if (slidingMin or slidingMax) and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local barWidth = math.max(SliderBar.AbsoluteSize.X, 1)
					local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / barWidth, 0, 1)
					if slidingMin then
						local pMin = math.min(pos, (currentMax - min) / range)
						currentMin = math.floor(min + (range * pMin))
						minRatio = (currentMin - min) / range
						KnobMin.Position = UDim2.new(minRatio, -7, 0.5, -7)
					elseif slidingMax then
						local pMax = math.max(pos, (currentMin - min) / range)
						currentMax = math.floor(min + (range * pMax))
						maxRatio = (currentMax - min) / range
						KnobMax.Position = UDim2.new(maxRatio, -7, 0.5, -7)
					end
					Fill.Position = UDim2.new(minRatio, 0, 0, 0)
					Fill.Size = UDim2.new(maxRatio - minRatio, 0, 1, 0)
					Label.Text = name .. " : " .. currentMin .. separatorStr .. currentMax
					if callback then
						pcall(callback, currentMin, currentMax)
					end
				end
			end))
		end

