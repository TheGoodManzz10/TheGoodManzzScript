	local function PlayCustomMusic(rawInput, customVol, customLoop, shouldSave)
		if customVol ~= nil then
			currentMusicVolume = math.clamp(tonumber(customVol) or 0.7, 0, 2)
		end
		if customLoop ~= nil then
			currentMusicLooped = (customLoop == true)
		end

		local inputToUse = (rawInput ~= nil and tostring(rawInput) ~= "") and tostring(rawInput) or currentMusicRawInput
		local resolvedUri, desc = ResolveMusicAsset(inputToUse)
		if resolvedUri == "" then
			StopCustomMusic()
			return false, "Stopped"
		end

		currentMusicRawInput = inputToUse
		for _, box in ipairs(MusicInputBoxes) do
			if box and box.Parent and box.Text ~= currentMusicRawInput then
				box.Text = currentMusicRawInput
			end
		end

		if shouldSave then
			RegisterSavedMusic(currentMusicRawInput)
		end

		local snd = EnsureSoundInstance()
		pcall(function()
			snd:Stop()
			snd.SoundId = resolvedUri
			snd.Volume = currentMusicVolume
			snd.Looped = currentMusicLooped
			snd:Play()
		end)
		isMusicPlaying = true
		UpdateMusicStatusUI("♪ Memutar: " .. tostring(desc))
		return true, desc
	end

