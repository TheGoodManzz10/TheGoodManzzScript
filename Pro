		function Scope:AddTabStepSlider(sliderName, min, max, step, default, callback)
			MirrorCall("AddTabStepSlider", sliderName, min, max, step, default, callback)
			step = (step and step > 0) and step or 1
			min = min or 0
			max = max or 100
			default = math.clamp(default or min, min, max)

			local Frame = Instance.new("Frame")
			Frame.Parent = TabContent
			Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
			Frame.BackgroundTransparency = 0.15
			Frame.Size = UDim2.new(1, 0, 0, 48)
			Frame.ZIndex = zBase

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 6)
			Corner.Parent = Frame

			local CardStroke = Instance.new("UIStroke")
			CardStroke.Color = currentAccentColor
			CardStroke.Transparency = 0.65
			CardStroke.Thickness = 1
			CardStroke.Parent = Frame

			local Label = Instance.new("TextLabel")
			Label.Parent = Frame
			Label.BackgroundTransparency = 1
			Label.Position = UDim2.new(0, 10, 0, 4)
			Label.Size = UDim2.new(1, -64, 0, 18)
			Label.Font = currentFontRegular
			Label.Text = sliderName
			Label.TextColor3 = currentTextThemeColor
			Label.TextSize = 11
			Label.TextTruncate = Enum.TextTruncate.AtEnd
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = zBase + 1

			local ValBadge = Instance.new("TextLabel")
			ValBadge.Parent = Frame
			ValBadge.BackgroundColor3 = TintWithAccent(Color3.fromRGB(36, 36, 50), currentAccentColor, 0.25)
			ValBadge.Position = UDim2.new(1, -50, 0, 5)
			ValBadge.Size = UDim2.new(0, 40, 0, 16)
			ValBadge.Font = currentFontBold
			ValBadge:SetAttribute("IsBoldFont", true)
			ValBadge:SetAttribute("IgnoreTextColor", true)
			ValBadge.Text = tostring(default)
			ValBadge.TextColor3 = currentAccentColor
			ValBadge.TextSize = 10
			ValBadge.ZIndex = zBase + 1

			local VBCorner = Instance.new("UICorner")
			VBCorner.CornerRadius = UDim.new(0, 4)
			VBCorner.Parent = ValBadge

			local SliderBar = Instance.new("Frame")
			SliderBar.Parent = Frame
			SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), currentAccentColor, 0.22)
			SliderBar.Position = UDim2.new(0, 10, 0, 30)
			SliderBar.Size = UDim2.new(1, -20, 0, 6)
			SliderBar.ZIndex = zBase + 1

			local BarCorner = Instance.new("UICorner")
			BarCorner.CornerRadius = UDim.new(1, 0)
			BarCorner.Parent = SliderBar

			local range = (max - min) == 0 and 1 or (max - min)
			local initialRatio = (default - min) / range

			local Fill = Instance.new("Frame")
			Fill.Parent = SliderBar
			Fill.BackgroundColor3 = currentAccentColor
			Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
			Fill.ZIndex = zBase + 2

			local FillCorner = Instance.new("UICorner")
			FillCorner.CornerRadius = UDim.new(1, 0)
			FillCorner.Parent = Fill

			local Knob = Instance.new("Frame")
			Knob.Parent = SliderBar
			Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Knob.Position = UDim2.new(initialRatio, -7, 0.5, -7)
			Knob.Size = UDim2.new(0, 14, 0, 14)
			Knob.ZIndex = zBase + 3

			local KnobCorner = Instance.new("UICorner")
			KnobCorner.CornerRadius = UDim.new(1, 0)
			KnobCorner.Parent = Knob

			local KnobStroke = Instance.new("UIStroke")
			KnobStroke.Color = currentAccentColor
			KnobStroke.Thickness = 2
			KnobStroke.Parent = Knob

			OnAccentChanged(function(col)
				CardStroke.Color = col
				Fill.BackgroundColor3 = col
				KnobStroke.Color = col
				ValBadge.TextColor3 = col
				ValBadge.BackgroundColor3 = TintWithAccent(Color3.fromRGB(36, 36, 50), col, 0.25)
				SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.22)
			end)

			local sliding = false
			local function update(input)
				local barWidth = math.max(SliderBar.AbsoluteSize.X, 1)
				local rawPos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / barWidth, 0, 1)
				local rawVal = min + (range * rawPos)
				local steppedVal = math.floor((rawVal / step) + 0.5) * step
				steppedVal = math.clamp(steppedVal, min, max)
				local finalRatio = (steppedVal - min) / range
				Fill.Size = UDim2.new(finalRatio, 0, 1, 0)
				Knob.Position = UDim2.new(finalRatio, -7, 0.5, -7)
				ValBadge.Text = tostring(steppedVal)
				if callback then
					pcall(callback, steppedVal)
				end
			end

			TrackConnection(Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end))
			TrackConnection(SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					update(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					update(input)
				end
			end))
		end
