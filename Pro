	-- ELEMENTS: ADDTAB (UNTUK UI 2 STARLIGHT & UI 3 AETHER NOVA)
	-------------------------------------------------------------------
	local defaultMainTabObj = nil

	function Elements:AddTab(tabName, iconName)
		local isNovaNow = (starlightStage == 2)
		local TabContent = Instance.new("ScrollingFrame")
		TabContent.Name = tabName .. "_Content"
		TabContent.Parent = StarlightFrame
		TabContent.BackgroundTransparency = 1
		TabContent.Position = isNovaNow and UDim2.new(0, 14, 0, 96) or UDim2.new(0, 142, 0, 52)
		TabContent.Size = isNovaNow and UDim2.new(1, -28, 1, -106) or UDim2.new(1, -150, 1, -60)
		TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
		TabContent.AutomaticCanvasSize = Enum.AutomaticSize.Y
		TabContent.ScrollBarThickness = 3
		TabContent.ScrollBarImageColor3 = currentAccentColor
		TabContent.Visible = false
		TabContent.ZIndex = 22

		OnAccentChanged(function(col)
			TabContent.ScrollBarImageColor3 = col
		end)

		local ContentLayout = Instance.new("UIListLayout")
		ContentLayout.Parent = TabContent
		ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ContentLayout.Padding = UDim.new(0, 6)

		local orderIdx = #StarlightTabs + 1
		local entry = CreateDualTabButtons(tabName, iconName or "lucide-layers", orderIdx, TabContent)

		local TabObj = CreateContainerScope(TabContent, 23, nil)
		TabObj.Entry = entry

		BindDynamicContainer(TabContent, ContentLayout, function()
			if TabContent and TabContent.Parent then
				local h = ComputeContainerHeight(TabContent, ContentLayout)
				TabContent.CanvasSize = UDim2.new(0, 0, 0, h + 24)
			end
		end)

		if #StarlightTabs == 0 then
			SelectTabEntry(entry)
		end

		table.insert(StarlightTabs, TabObj)
		return TabObj
	end

	local function GetAutoMainTab()
		if not defaultMainTabObj then
			defaultMainTabObj = Elements:AddTab("Main", "lucide-layout-dashboard")
		end
		return defaultMainTabObj
	end

	SetupStarlightAndNovaSettingsTab()

	-------------------------------------------------------------------
	-- PASANG SELURUH KOMPONEN KE ELEMENTS (UI 1 + MIRROR KE MAIN TAB UI 2 & 3)
	-------------------------------------------------------------------
	BindDynamicContainer(ScrollContainer, UIListLayout, function()
		if ScrollContainer and ScrollContainer.Parent then
			local h = ComputeContainerHeight(ScrollContainer, UIListLayout)
			ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, h + 24)
		end
	end)
	if SSetContent then
		local sLayout = SSetContent:FindFirstChildOfClass("UIListLayout")
		BindDynamicContainer(SSetContent, sLayout, function()
			if SSetContent and SSetContent.Parent then
				local h = ComputeContainerHeight(SSetContent, sLayout)
				SSetContent.CanvasSize = UDim2.new(0, 0, 0, h + 24)
			end
		end)
	end
	if NSPScroll and NSPLayout then
		BindDynamicContainer(NSPScroll, NSPLayout, function()
			if NSPScroll and NSPScroll.Parent then
				local h = ComputeContainerHeight(NSPScroll, NSPLayout)
				NSPScroll.CanvasSize = UDim2.new(0, 0, 0, h + 24)
			end
		end)
	end

	local MainElementsScope = CreateContainerScope(ScrollContainer, 9, GetAutoMainTab)
	for k, v in pairs(MainElementsScope) do
		if type(v) == "function" and Elements[k] == nil then
			Elements[k] = function(_, ...)
				return v(MainElementsScope, ...)
			end
		end
	end

