	-------------------------------------------------------------------
	local TabEntries = {}
	local activeTabEntry = nil

	local function SelectTabEntry(entry)
		activeTabEntry = entry
		for _, item in ipairs(TabEntries) do
			local isSelected = (item == entry)
			if item.ContentFrame and item.ContentFrame.Parent then
				item.ContentFrame.Visible = isSelected
			end
			if item.SideBtn and item.SideBtn.Parent then
				TweenService:Create(item.SideBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					BackgroundColor3 = isSelected and Color3.fromRGB(38, 38, 56) or Color3.fromRGB(25, 25, 36)
				}):Play()
				local sLbl = item.SideBtn:FindFirstChild("TabLabel")
				if sLbl then
					TweenService:Create(sLbl, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
						TextColor3 = isSelected and currentAccentColor or Color3.fromRGB(170, 170, 190)
					}):Play()
				end
			end
			if item.TopBtn and item.TopBtn.Parent then
				TweenService:Create(item.TopBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					BackgroundColor3 = isSelected and currentAccentColor or Color3.fromRGB(30, 30, 44)
				}):Play()
				local tLbl = item.TopBtn:FindFirstChild("TabLabel")
				if tLbl then
					TweenService:Create(tLbl, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
						TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(185, 185, 205)
					}):Play()
				end
			end
		end
	end

	OnAccentChanged(function(col)
		if activeTabEntry then
			if activeTabEntry.SideBtn and activeTabEntry.SideBtn.Parent then
				local sLbl = activeTabEntry.SideBtn:FindFirstChild("TabLabel")
				if sLbl then
					sLbl.TextColor3 = col
				end
			end
			if activeTabEntry.TopBtn and activeTabEntry.TopBtn.Parent then
				activeTabEntry.TopBtn.BackgroundColor3 = col
			end
		end
	end)

