						TweenService:Create(Frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 38) }):Play()
						if callback then
							pcall(callback, opt)
						end
					end))
				end
			end

			DropdownController:Refresh(options)
			return DropdownController
		end
