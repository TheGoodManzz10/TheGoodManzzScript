	CreateContainerScope = function(TabContent, zBase, getMirrorScopeFn)
		zBase = zBase or 23
		local Scope = { Frame = TabContent }

		local function MirrorCall(methodName, ...)
			if getMirrorScopeFn then
				local mScope = nil
				if type(getMirrorScopeFn) == "function" then
					mScope = getMirrorScopeFn()
				elseif type(getMirrorScopeFn) == "table" then
					mScope = getMirrorScopeFn
				end
				if type(mScope) == "table" and type(mScope[methodName]) == "function" then
					return mScope[methodName](mScope, ...)
				end
			end
			return nil
		end

