			local SliderBar = Instance.new("Frame")
			SliderBar.Parent = Frame
			SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), currentAccentColor, 0.22)
			SliderBar.Position = UDim2.new(0, 10, 0, 30)
			SliderBar.Size = UDim2.new(1, -20, 0, 6)
			SliderBar.ZIndex = zBase + 1

			local BarCorner = Instance.new("UICorner")
			BarCorner.CornerRadius = UDim.new(1, 0)
			BarCorner.Parent = SliderBar

			local range = (max - min) == 0 and 1 or (max - min)
			local initialRatio = (default - min) / range

			local Fill = Instance.new("Frame")
			Fill.Parent = SliderBar
			Fill.BackgroundColor3 = currentAccentColor
			Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
			Fill.ZIndex = zBase + 2

			local FillCorner = Instance.new("UICorner")
			FillCorner.CornerRadius = UDim.new(1, 0)
			FillCorner.Parent = Fill

			local Knob = Instance.new("Frame")
			Knob.Parent = SliderBar
			Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Knob.Position = UDim2.new(initialRatio, -7, 0.5, -7)
			Knob.Size = UDim2.new(0, 14, 0, 14)
			Knob.ZIndex = zBase + 3

			local KnobCorner = Instance.new("UICorner")
			KnobCorner.CornerRadius = UDim.new(1, 0)
			KnobCorner.Parent = Knob

			local KnobStroke = Instance.new("UIStroke")
			KnobStroke.Color = currentAccentColor
			KnobStroke.Thickness = 2
			KnobStroke.Parent = Knob

			OnAccentChanged(function(col)
				CardStroke.Color = col
				ValInput.TextColor3 = col
				ValInput.BackgroundColor3 = TintWithAccent(Color3.fromRGB(38, 38, 54), col, 0.25)
				Fill.BackgroundColor3 = col
				KnobStroke.Color = col
				SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.22)
			end)

			local currentVal = default
			local function SetValue(v, triggerCb)
				currentVal = math.clamp(math.floor(v), min, max)
				local r = (currentVal - min) / range
				Fill.Size = UDim2.new(r, 0, 1, 0)
				Knob.Position = UDim2.new(r, -7, 0.5, -7)
				ValInput.Text = tostring(currentVal)
				if triggerCb and callback then
					pcall(callback, currentVal)
				end
			end

			local sliding = false
			local function updateFromPos(input)
				local w = math.max(SliderBar.AbsoluteSize.X, 1)
				local p = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / w, 0, 1)
				SetValue(min + (range * p), true)
			end

			TrackConnection(Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end))
			TrackConnection(SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					updateFromPos(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromPos(input)
				end
			end))
			TrackConnection(ValInput.FocusLost:Connect(function()
				local n = tonumber(ValInput.Text)
				if n then
					SetValue(n, true)
				else
					ValInput.Text = tostring(currentVal)
				end
			end))
		end

