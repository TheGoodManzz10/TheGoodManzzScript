		-- 3. AddNovaNumberPad: Pengatur Angka Presisi Responsif (-- / - / Input / + / ++)
		function Scope:AddNovaNumberPad(name, min, max, default, step, callback)
			if type(max) == "function" or max == nil then
				callback = max
				default = tonumber(min) or 0
				min = 0
				max = 999999
				step = 1
			end
			MirrorCall("AddNovaNumberPad", name, min, max, default, step, callback)
			min = tonumber(min) or 0
			max = tonumber(max) or 1000
			step = (tonumber(step) and tonumber(step) > 0) and tonumber(step) or 1
			local currentVal = math.clamp(tonumber(default) or min, min, max)

			local Frame = Instance.new("Frame")
			Frame.Parent = TabContent
			Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
