			local function SyncGSize(anim)
				if not GCard or not GCard.Parent then return end
				local sum = 0
				local cnt = 0
				for _, ch in ipairs(Body:GetChildren()) do
					if ch:IsA("GuiObject") and ch.Visible then
						cnt = cnt + 1
						sum = sum + ch.Size.Y.Offset
					end
				end
				if cnt > 1 then
					sum = sum + ((cnt - 1) * 6)
				end
				Body.Size = UDim2.new(1, -16, 0, sum)
				Body.Visible = isOpen
				local targetH = isOpen and (sum + 50) or 36
				if anim then
					TweenService:Create(GCard, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
						Size = UDim2.new(1, 0, 0, targetH)
