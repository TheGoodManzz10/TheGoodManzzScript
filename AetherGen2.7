    -------------------------------------------------------------------
    -- FITUR KHUSUS: CURVE
    -------------------------------------------------------------------
    function Elements:Curve()
        TweenService:Create(MainCorner, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CornerRadius = UDim.new(0, 24)
        }):Play()

        TweenService:Create(TopCorner, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CornerRadius = UDim.new(0, 24)
        }):Play()
    end

    -------------------------------------------------------------------
    -- FITUR KHUSUS: EFEK KILATAN PETIR / CAHAYA (LIGHTNING EFFECT)
    -------------------------------------------------------------------
    function Elements:LightningEffect()
        task.spawn(function()
            while MainFrame and MainStroke do
                TweenService:Create(MainStroke, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {
                    Color = Color3.fromRGB(255, 255, 255),
                    Transparency = 0
                }):Play()
                task.wait(0.25)
                TweenService:Create(MainStroke, TweenInfo.new(0.35, Enum.EasingStyle.Sine), {
                    Color = Color3.fromRGB(90, 150, 255),
                    Transparency = 0.4
                }):Play()
                task.wait(0.6)
            end
        end)
    end

