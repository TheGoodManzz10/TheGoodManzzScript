        local DropBtn = Instance.new("TextButton")
        DropBtn.Parent = DropdownFrame
        DropBtn.BackgroundTransparency = 1
        DropBtn.Size = UDim2.new(1, 0, 0, 42)
        DropBtn.Font = Enum.Font.Gotham
        DropBtn.Text = " " .. name .. " : Select..."
        DropBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DropBtn.TextSize = 12
        DropBtn.TextXAlignment = Enum.TextXAlignment.Left
        DropBtn.ZIndex = 10

        local OptionList = Instance.new("ScrollingFrame")
        OptionList.Parent = DropdownFrame
        OptionList.BackgroundTransparency = 1
        OptionList.Position = UDim2.new(0, 8, 0, 42)
        OptionList.Size = UDim2.new(1, -16, 0, 90)
        OptionList.CanvasSize = UDim2.new(0, 0, 0, 0)
        OptionList.AutomaticCanvasSize = Enum.AutomaticSize.Y
        OptionList.ScrollBarThickness = 3
        OptionList.ZIndex = 10

        local ListLayout = Instance.new("UIListLayout")
        ListLayout.Parent = OptionList
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ListLayout.Padding = UDim.new(0, 4)

        local open = false
        DropBtn.MouseButton1Click:Connect(function()
            open = not open
            local targetSize = open and UDim2.new(1, 0, 0, 140) or UDim2.new(1, 0, 0, 42)
            TweenService:Create(DropdownFrame, TweenInfo.new(0.25), {Size = targetSize}):Play()
        end)

        local DropdownObj = {}
        function DropdownObj:Refresh(newOptions)
            for _, child in ipairs(OptionList:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end

            if not newOptions or #newOptions == 0 then
                newOptions = {"Tidak ada pilihan"}
            end

            for _, optionName in ipairs(newOptions) do
                local ItemBtn = Instance.new("TextButton")
                ItemBtn.Parent = OptionList
                ItemBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
                ItemBtn.Size = UDim2.new(1, 0, 0, 26)
                ItemBtn.Font = Enum.Font.Gotham
                ItemBtn.Text = optionName
                ItemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                ItemBtn.TextSize = 11
                ItemBtn.ZIndex = 11

                local ItemCorner = Instance.new("UICorner")
                ItemCorner.CornerRadius = UDim.new(0, 4)
                ItemCorner.Parent = ItemBtn

                ItemBtn.MouseButton1Click:Connect(function()
                    DropBtn.Text = " " .. name .. " : " .. optionName
                    open = false
                    TweenService:Create(DropdownFrame, TweenInfo.new(0.25), {Size = UDim2.new(1, 0, 0, 42)}):Play()
                    if callback then
                        pcall(callback, optionName)
                    end
                end)
            end
        end

        DropdownObj:Refresh(options)
        return DropdownObj
    end

    function Elements:AddInput(name, placeholder, callback)
        local InputFrame = Instance.new("Frame")
        InputFrame.Parent = ScrollContainer
        InputFrame.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
        InputFrame.Size = UDim2.new(1, 0, 0, 42)
        InputFrame.ZIndex = 9

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 6)
        Corner.Parent = InputFrame

        local Label = Instance.new("TextLabel")
        Label.Parent = InputFrame
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 12, 0, 0)
        Label.Size = UDim2.new(0, 130, 1, 0)
        Label.Font = Enum.Font.Gotham
        Label.Text = name
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 12
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.ZIndex = 10

        local TextBox = Instance.new("TextBox")
        TextBox.Parent = InputFrame
        TextBox.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
        TextBox.Position = UDim2.new(1, -135, 0.5, -13)
        TextBox.Size = UDim2.new(0, 125, 0, 26)
        TextBox.Font = Enum.Font.Gotham
        TextBox.PlaceholderText = placeholder or "Ketik di sini..."
        TextBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
        TextBox.Text = ""
        TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        TextBox.TextSize = 11
        TextBox.ClearTextOnFocus = false
        TextBox.ZIndex = 10

        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 4)
        BoxCorner.Parent = TextBox

        TextBox.FocusLost:Connect(function(enterPressed)
            if callback then
                pcall(callback, TextBox.Text, enterPressed)
            end
        end)
    end

    function Elements:AddParagraph(titleText, contentText)
        local ParaFrame = Instance.new("Frame")
        ParaFrame.Parent = ScrollContainer
        ParaFrame.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
        ParaFrame.Size = UDim2.new(1, 0, 0, 60)
        ParaFrame.ZIndex = 9

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 6)
        Corner.Parent = ParaFrame

        local TitleLabel = Instance.new("TextLabel")
        TitleLabel.Parent = ParaFrame
        TitleLabel.BackgroundTransparency = 1
        TitleLabel.Position = UDim2.new(0, 10, 0, 6)
        TitleLabel.Size = UDim2.new(1, -20, 0, 18)
        TitleLabel.Font = Enum.Font.GothamBold
        TitleLabel.Text = titleText or "Info"
        TitleLabel.TextColor3 = Color3.fromRGB(90, 150, 255)
        TitleLabel.TextSize = 12
        TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
        TitleLabel.ZIndex = 10

        local ContentLabel = Instance.new("TextLabel")
        ContentLabel.Parent = ParaFrame
        ContentLabel.BackgroundTransparency = 1
        ContentLabel.Position = UDim2.new(0, 10, 0, 26)
        ContentLabel.Size = UDim2.new(1, -20, 0, 28)
        ContentLabel.Font = Enum.Font.Gotham
        ContentLabel.Text = contentText or ""
        ContentLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
        ContentLabel.TextSize = 11
        ContentLabel.TextWrapped = true
        ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
        ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
        ContentLabel.ZIndex = 10
    end

    return Elements
end

return AetherLib
