		function Scope:AddPlayerSelector(title, callback)
			local function FetchPlayers()
				local list = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer then
						table.insert(list, p.Name)
					end
				end
				if #list == 0 then
					table.insert(list, "Tidak ada pemain lain")
				end
				return list
			end
			local drop = Scope:AddTabDropdown(title or "Pilih Pemain", FetchPlayers(), callback)
			TrackConnection(Players.PlayerAdded:Connect(function()
				drop:Refresh(FetchPlayers())
			end))
			TrackConnection(Players.PlayerRemoving:Connect(function()
				task.delay(0.1, function()
					drop:Refresh(FetchPlayers())
				end)
			end))
			return drop
		end

