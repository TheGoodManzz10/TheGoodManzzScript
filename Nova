		function Scope:AddProgressBar(name, min, max, default)
			local mBar = MirrorCall("AddProgressBar", name, min, max, default)
			min = min or 0
			max = max or 100
			local range = (max - min) == 0 and 1 or (max - min)
			default = math.clamp(default or min, min, max)

			local BarFrame = Instance.new("Frame")
			BarFrame.Parent = TabContent
			BarFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
