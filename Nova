	local function UpdateAllTabContentPositions(isNovaMode)
		local targetPos = isNovaMode and UDim2.new(0, 14, 0, 96) or UDim2.new(0, 142, 0, 52)
		local targetSize = isNovaMode and UDim2.new(1, -28, 1, -106) or UDim2.new(1, -150, 1, -60)

		if SSetContent and SSetContent.Parent then
			SSetContent.Position = targetPos
			SSetContent.Size = targetSize
		end
		for _, t in ipairs(StarlightTabs) do
			if t.Frame and t.Frame.Parent then
				t.Frame.Position = targetPos
				t.Frame.Size = targetSize
			end
		end
	end

	local function ApplyStarlightStage(stage)
		isAnimating = true
		starlightStage = stage

		if stage == 1 then
			if MainFrame and MainFrame.Parent and MainFrame.Visible then
				MainFrame.Visible = false
			end
			if not StarlightFrame.Visible then
				StarlightFrame.Size = UDim2.new(0, 300, 0, 420)
				StarlightFrame.Position = UDim2.new(1, -320, 0.1, 0)
				StarlightFrame.Visible = true
			end
			HeaderMainIcon.Image = Icons["lucide-star"]
			SHeaderTitle.Text = "STARLIGHT ENGINE v18.5"
			NovaModeBadge.Text = "Starlight UI"
			StarlightSidebarHolder.Visible = true
			NovaTopBarHolder.Visible = false
			UpdateAllTabContentPositions(false)

			TweenService:Create(StarlightCorner, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				CornerRadius = UDim.new(0, 10)
			}):Play()

			local tweenExpand = TweenService:Create(StarlightFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 520, 0, 420),
				Position = UDim2.new(1, -540, 0.1, 0)
			})
			tweenExpand:Play()
			tweenExpand.Completed:Once(function()
				isAnimating = false
			end)

		elseif stage == 2 then
			if MainFrame and MainFrame.Parent and MainFrame.Visible then
				MainFrame.Visible = false
			end
			if not StarlightFrame.Visible then
				StarlightFrame.Size = UDim2.new(0, 300, 0, 420)
				StarlightFrame.Position = UDim2.new(1, -320, 0.1, 0)
				StarlightFrame.Visible = true
			end
			HeaderMainIcon.Image = Icons["lucide-rocket"]
			SHeaderTitle.Text = "AETHER NOVA  •  HORIZON v18.5"
			NovaModeBadge.Text = "Aether Nova"
			StarlightSidebarHolder.Visible = false
			NovaTopBarHolder.Visible = true
			UpdateAllTabContentPositions(true)

			TweenService:Create(StarlightCorner, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				CornerRadius = UDim.new(0, customNovaRadius)
			}):Play()

			local tweenNova = TweenService:Create(StarlightFrame, TweenInfo.new(0.65, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 660, 0, 435),
				Position = UDim2.new(1, -680, 0.08, 0)
			})
			tweenNova:Play()
			tweenNova.Completed:Once(function()
				isAnimating = false
			end)

		else
			starlightStage = 0
			local tweenClose = TweenService:Create(StarlightFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
				Size = UDim2.new(0, 0, 0, 420),
				Position = UDim2.new(1, -18, 0.1, 0)
			})
			tweenClose:Play()
			tweenClose.Completed:Once(function()
				StarlightFrame.Visible = false
				isAnimating = false
			end)
		end
	end

	local function ToggleUI(state)
		if isAnimating or not MainFrame or not MainFrame.Parent then
			return
		end
		if state then
			isAnimating = true
			MainFrame.Size = UDim2.new(0, 300, 0, 0)
			MainFrame.Visible = true
			local tween = TweenService:Create(MainFrame, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 300, 0, 420)
			})
			tween:Play()
			tween.Completed:Once(function()
				isAnimating = false
			end)
		else
			isAnimating = true
			local tween = TweenService:Create(MainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
				Size = UDim2.new(0, 300, 0, 0)
			})
			tween:Play()
			tween.Completed:Once(function()
				MainFrame.Visible = false
				isAnimating = false
			end)
		end
	end

