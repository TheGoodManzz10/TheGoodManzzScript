	CreateUniversalRowBuilder = function(parentContainer, zBase, mirrorRowObj)
		zBase = zBase or 23

		local RowFrame = Instance.new("Frame")
		RowFrame.Name = "UniversalDualRow"
		RowFrame.Parent = parentContainer
		RowFrame.BackgroundTransparency = 1
		RowFrame.Size = UDim2.new(1, 0, 0, 38)
		RowFrame.ZIndex = zBase

		local LeftSlot = Instance.new("Frame")
		LeftSlot.Name = "LeftSlot"
		LeftSlot.Parent = RowFrame
		LeftSlot.BackgroundTransparency = 1
		LeftSlot.Position = UDim2.new(0, 0, 0, 0)
		LeftSlot.Size = UDim2.new(0.488, 0, 1, 0)
		LeftSlot.ZIndex = zBase

		local LeftLayout = Instance.new("UIListLayout")
		LeftLayout.Parent = LeftSlot
		LeftLayout.SortOrder = Enum.SortOrder.LayoutOrder
		LeftLayout.Padding = UDim.new(0, 6)

		local RightSlot = Instance.new("Frame")
		RightSlot.Name = "RightSlot"
		RightSlot.Parent = RowFrame
		RightSlot.BackgroundTransparency = 1
		RightSlot.Position = UDim2.new(0.512, 0, 0, 0)
		RightSlot.Size = UDim2.new(0.488, 0, 1, 0)
		RightSlot.ZIndex = zBase

		local RightLayout = Instance.new("UIListLayout")
		RightLayout.Parent = RightSlot
		RightLayout.SortOrder = Enum.SortOrder.LayoutOrder
		RightLayout.Padding = UDim.new(0, 6)

		local function SyncRowHeight()
			if not RowFrame or not RowFrame.Parent then
				return
			end
			local hL = ComputeContainerHeight(LeftSlot, LeftLayout)
			local hR = ComputeContainerHeight(RightSlot, RightLayout)
			local maxH = math.max(hL, hR, 38)
			if RowFrame.Size.Y.Offset ~= maxH then
				RowFrame.Size = UDim2.new(1, 0, 0, maxH)
			end
		end

		BindDynamicContainer(LeftSlot, LeftLayout, SyncRowHeight)
		BindDynamicContainer(RightSlot, RightLayout, SyncRowHeight)

		local LeftScope = CreateContainerScope(LeftSlot, zBase + 1, function()
			return mirrorRowObj and mirrorRowObj.Left or nil
		end)
		local RightScope = CreateContainerScope(RightSlot, zBase + 1, function()
			return mirrorRowObj and mirrorRowObj.Right or nil
		end)

		local callCounter = 0
		local RowObj = {
			Frame = RowFrame,
			Left = LeftScope,
			Right = RightScope,
			RefreshSize = SyncRowHeight
		}

		-- Metatable Universal: Panggilan komponen ke-1 otomatis masuk ke Kiri, ke-2 ke Kanan (Mendukung SEMUA Komponen!)
		setmetatable(RowObj, {
			__index = function(_, methodName)
				if type(LeftScope[methodName]) == "function" then
					return function(_, ...)
						callCounter = callCounter + 1
						local targetScope = (callCounter % 2 == 1) and LeftScope or RightScope
						local res = targetScope[methodName](targetScope, ...)
						SyncRowHeight()
						SafeDefer(SyncRowHeight)
						return res or RowObj
					end
				end
				return nil
			end
		})

		return RowObj
	end

