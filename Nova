			Label.TextColor3 = currentTextThemeColor
			Label.TextSize = 11
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.ZIndex = zBase + 1

			local OuterBar = Instance.new("Frame")
			OuterBar.Parent = BarFrame
			OuterBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(50, 50, 68), currentAccentColor, 0.2)
			OuterBar.Position = UDim2.new(0, 10, 0, 26)
			OuterBar.Size = UDim2.new(1, -20, 0, 8)
			OuterBar.ZIndex = zBase + 1

			local OuterCorner = Instance.new("UICorner")
			OuterCorner.CornerRadius = UDim.new(1, 0)
			OuterCorner.Parent = OuterBar

			local InnerBar = Instance.new("Frame")
			InnerBar.Parent = OuterBar
			InnerBar.BackgroundColor3 = currentAccentColor
			InnerBar.Size = UDim2.new((default - min) / range, 0, 1, 0)
			InnerBar.ZIndex = zBase + 2

			local InnerCorner = Instance.new("UICorner")
			InnerCorner.CornerRadius = UDim.new(1, 0)
			InnerCorner.Parent = InnerBar

			OnAccentChanged(function(col)
				InnerBar.BackgroundColor3 = col
				OuterBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(50, 50, 68), col, 0.2)
			end)

			local BarObj = {}
			function BarObj:SetValue(val)
				val = math.clamp(val, min, max)
				local ratio = (val - min) / range
				TweenService:Create(InnerBar, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(ratio, 0, 1, 0) }):Play()
				Label.Text = name .. " : " .. tostring(val)
				if mBar and mBar.SetValue then
					pcall(function()
						mBar:SetValue(val)
					end)
				end
			end
			return BarObj
		end

