	function Elements:LightningEffect()
		if isLightningRunning then
			return
		end
		isLightningRunning = true
		task.spawn(function()
			while ScreenGui and ScreenGui.Parent and MainFrame and MainFrame.Parent and MainStroke do
				TweenService:Create(MainStroke, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {
					Color = Color3.fromRGB(255, 255, 255),
