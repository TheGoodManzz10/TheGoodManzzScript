		function Scope:AddNovaProgressButton(btnText, iconNameArg, durationSec, callback)
			if type(iconNameArg) == "number" then
				callback = durationSec
				durationSec = iconNameArg
				iconNameArg = nil
			elseif type(iconNameArg) == "function" then
				callback = iconNameArg
				durationSec = 1.2
				iconNameArg = nil
			elseif type(durationSec) == "function" then
				callback = durationSec
				durationSec = 1.2
			end
			MirrorCall("AddNovaProgressButton", btnText, iconNameArg, durationSec, callback)
			durationSec = tonumber(durationSec) or 1.2
			local busy = false

			local Btn = Instance.new("TextButton")
			Btn.Parent = TabContent
			Btn.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
			Btn.BackgroundTransparency = 0.15
			Btn.Size = UDim2.new(1, 0, 0, 38)
			Btn.ClipsDescendants = true
			Btn.Font = currentFontRegular
			Btn.Text = btnText
			Btn.TextColor3 = currentTextThemeColor
			Btn.TextSize = 11
			Btn.TextXAlignment = Enum.TextXAlignment.Left
			Btn.ZIndex = zBase

			local BtnPadding = Instance.new("UIPadding")
			BtnPadding.Parent = Btn
			BtnPadding.PaddingLeft = iconNameArg and UDim2.new(0, 34) or UDim.new(0, 12)

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 6)
			Corner.Parent = Btn

			local Stroke = Instance.new("UIStroke")
			Stroke.Color = currentAccentColor
			Stroke.Transparency = 0.55
			Stroke.Thickness = 1
			Stroke.Parent = Btn

			local ProgFill = Instance.new("Frame")
			ProgFill.Parent = Btn
			ProgFill.BackgroundColor3 = currentAccentColor
			ProgFill.BackgroundTransparency = 0.55
			ProgFill.Position = UDim2.new(0, -34, 0, 0)
			ProgFill.Size = UDim2.new(0, 0, 1, 0)
			ProgFill.ZIndex = zBase

			OnAccentChanged(function(col)
				Stroke.Color = col
				ProgFill.BackgroundColor3 = col
			end)

			if iconNameArg then
				CreateIcon(iconNameArg, Btn, UDim2.new(0, -24, 0.5, -8), UDim2.new(0, 16, 0, 16), zBase + 1)
			end

			TrackConnection(Btn.MouseButton1Click:Connect(function()
				if busy then
					return
				end
				busy = true
				local origText = btnText
				ProgFill.Size = UDim2.new(0, 0, 1, 0)
				TweenService:Create(ProgFill, TweenInfo.new(durationSec, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.new(1, 34, 1, 0)
				}):Play()

				task.spawn(function()
					local steps = 10
					for i = 1, steps do
						if Btn and Btn.Parent then
							Btn.Text = origText .. " (" .. math.floor((i / steps) * 100) .. "%)"
						end
						task.wait(durationSec / steps)
					end
					if callback then
						pcall(callback)
					end
					if Btn and Btn.Parent then
						Btn.Text = origText
						TweenService:Create(ProgFill, TweenInfo.new(0.25), { Size = UDim2.new(0, 0, 1, 0) }):Play()
					end
					busy = false
				end)
			end))
		end

