			Lbl.TextSize = 11
			Lbl.TextTruncate = Enum.TextTruncate.AtEnd
			Lbl.TextXAlignment = Enum.TextXAlignment.Left
			Lbl.ZIndex = zBase + 1

			local Switch = Instance.new("TextButton")
			Switch.Parent = Frame
			Switch.BackgroundColor3 = isToggled and currentAccentColor or Color3.fromRGB(50, 50, 70)
			Switch.Position = UDim2.new(1, -44, 0, 6)
			Switch.Size = UDim2.new(0, 34, 0, 18)
			Switch.Text = ""
			Switch.ZIndex = zBase + 1

			local SWCorner = Instance.new("UICorner")
			SWCorner.CornerRadius = UDim.new(1, 0)
			SWCorner.Parent = Switch

			local SWKnob = Instance.new("Frame")
			SWKnob.Parent = Switch
			SWKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			SWKnob.Position = isToggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
			SWKnob.Size = UDim2.new(0, 14, 0, 14)
			SWKnob.ZIndex = zBase + 2

			local SWKCorner = Instance.new("UICorner")
			SWKCorner.CornerRadius = UDim.new(1, 0)
			SWKCorner.Parent = SWKnob

			local SliderBar = Instance.new("Frame")
			SliderBar.Parent = Frame
			SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), currentAccentColor, 0.22)
			SliderBar.Position = UDim2.new(0, 10, 0, 36)
			SliderBar.Size = UDim2.new(1, -20, 0, 6)
			SliderBar.ZIndex = zBase + 1

			local BarCorner = Instance.new("UICorner")
			BarCorner.CornerRadius = UDim.new(1, 0)
			BarCorner.Parent = SliderBar

			local range = (max - min) == 0 and 1 or (max - min)
			local initRatio = (currentVal - min) / range

			local Fill = Instance.new("Frame")
			Fill.Parent = SliderBar
			Fill.BackgroundColor3 = currentAccentColor
			Fill.Size = UDim2.new(initRatio, 0, 1, 0)
			Fill.ZIndex = zBase + 2

			local FillCorner = Instance.new("UICorner")
			FillCorner.CornerRadius = UDim.new(1, 0)
			FillCorner.Parent = Fill

			local Knob = Instance.new("Frame")
			Knob.Parent = SliderBar
			Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Knob.Position = UDim2.new(initRatio, -7, 0.5, -7)
			Knob.Size = UDim2.new(0, 14, 0, 14)
			Knob.ZIndex = zBase + 3

			local KCorner = Instance.new("UICorner")
			KCorner.CornerRadius = UDim.new(1, 0)
			KCorner.Parent = Knob

			local KStroke = Instance.new("UIStroke")
			KStroke.Color = currentAccentColor
			KStroke.Thickness = 2
			KStroke.Parent = Knob

			OnAccentChanged(function(col)
				CardStroke.Color = col
				Fill.BackgroundColor3 = col
				KStroke.Color = col
				SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.22)
				if isToggled then
					Switch.BackgroundColor3 = col
				end
			end)

			TrackConnection(Switch.MouseButton1Click:Connect(function()
				isToggled = not isToggled
				TweenService:Create(Switch, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					BackgroundColor3 = isToggled and currentAccentColor or Color3.fromRGB(50, 50, 70)
				}):Play()
				TweenService:Create(SWKnob, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = isToggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
				}):Play()
				if callback then
					pcall(callback, isToggled, currentVal)
				end
			end))

			local sliding = false
			local function updateSlide(input)
				local w = math.max(SliderBar.AbsoluteSize.X, 1)
				local p = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / w, 0, 1)
				currentVal = math.floor(min + (range * p))
				Fill.Size = UDim2.new(p, 0, 1, 0)
				Knob.Position = UDim2.new(p, -7, 0.5, -7)
				Lbl.Text = name .. " (" .. tostring(currentVal) .. ")"
				if callback then
					pcall(callback, isToggled, currentVal)
				end
			end

			TrackConnection(Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end))
			TrackConnection(SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					updateSlide(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateSlide(input)
				end
			end))
		end

