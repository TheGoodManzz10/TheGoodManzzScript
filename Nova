			TrackConnection(KnobMin.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					slidingMin = true
				end
			end))
			TrackConnection(KnobMax.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					slidingMax = true
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					slidingMin, slidingMax = false, false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if (slidingMin or slidingMax) and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local barWidth = math.max(SliderBar.AbsoluteSize.X, 1)
					local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / barWidth, 0, 1)
					if slidingMin then
						local pMin = math.min(pos, (currentMax - min) / range)
						currentMin = math.floor(min + (range * pMin))
						minRatio = (currentMin - min) / range
						KnobMin.Position = UDim2.new(minRatio, -7, 0.5, -7)
					elseif slidingMax then
						local pMax = math.max(pos, (currentMin - min) / range)
						currentMax = math.floor(min + (range * pMax))
						maxRatio = (currentMax - min) / range
						KnobMax.Position = UDim2.new(maxRatio, -7, 0.5, -7)
					end
					Fill.Position = UDim2.new(minRatio, 0, 0, 0)
					Fill.Size = UDim2.new(maxRatio - minRatio, 0, 1, 0)
					Label.Text = name .. " : " .. currentMin .. separatorStr .. currentMax
					if callback then
						pcall(callback, currentMin, currentMax)
					end
				end
			end))
		end

