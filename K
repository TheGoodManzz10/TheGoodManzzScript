			OnAccentChanged(function(col)
				CardStroke.Color = col
				Fill.BackgroundColor3 = col
				KStroke.Color = col
				SliderBar.BackgroundColor3 = TintWithAccent(Color3.fromRGB(48, 48, 66), col, 0.22)
				if isToggled then
					Switch.BackgroundColor3 = col
				end
			end)

			TrackConnection(Switch.MouseButton1Click:Connect(function()
				isToggled = not isToggled
				TweenService:Create(Switch, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					BackgroundColor3 = isToggled and currentAccentColor or Color3.fromRGB(50, 50, 70)
				}):Play()
				TweenService:Create(SWKnob, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = isToggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
				}):Play()
				if callback then
					pcall(callback, isToggled, currentVal)
				end
			end))

			local sliding = false
			local function updateSlide(input)
				local w = math.max(SliderBar.AbsoluteSize.X, 1)
				local p = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / w, 0, 1)
				currentVal = math.floor(min + (range * p))
				Fill.Size = UDim2.new(p, 0, 1, 0)
				Knob.Position = UDim2.new(p, -7, 0.5, -7)
				Lbl.Text = name .. " (" .. tostring(currentVal) .. ")"
				if callback then
					pcall(callback, isToggled, currentVal)
				end
			end

			TrackConnection(Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
				end
			end))
			TrackConnection(SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					updateSlide(input)
				end
			end))
			TrackConnection(UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))
			TrackConnection(UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateSlide(input)
				end
			end))
		end

