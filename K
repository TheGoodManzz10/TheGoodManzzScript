	-- FITUR UNGGULAN v22.0: "BACKGROUND TERLIHAT" (CLEAR GLASS COMPONENT MODE)
	-- Saat aktif, seluruh kartu komponen, grup, tombol, header, & sidebar menjadi kaca transparan
	-- sehingga gambar background di belakangnya terlihat jelas tanpa tertutup komponen!
	local function ApplyBackgroundVisibleMode(enabled, customGlassTrans)
		if enabled ~= nil then
			isBgVisibleMode = (enabled == true)
		end
		if customGlassTrans ~= nil then
			bgVisibleGlassTrans = math.clamp(tonumber(customGlassTrans) or 0.78, 0.35, 0.92)
		end

		for _, fn in ipairs(GlassToggleCallbacks) do
			pcall(fn, isBgVisibleMode)
		end

		-- Sesuaikan transparansi semua kartu & komponen di dalam MainFrame, StarlightFrame, & NormalSettingsPanel
		local containersToGlass = {}
		for _, item in ipairs(BgImageLabels) do
			if item.Frame and item.Frame.Parent then
				table.insert(containersToGlass, item.Frame)
			end
		end

		for _, rootFrame in ipairs(containersToGlass) do
			for _, desc in ipairs(rootFrame:GetDescendants()) do
				if (desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("TextBox")) and desc.Name ~= "CustomWallpaperBg" and desc.Name ~= "CustomWallpaperVideo" and desc.Name ~= "SunlightCoronaCore" and desc.Name ~= "SunlightGlowDiagonal" and desc.Name ~= "SunlightGlowTop" and desc.Name ~= "SnowfallOverlay" and desc.Name ~= "SnowflakeDot" then
					local curT = desc.BackgroundTransparency
					if curT < 0.98 then
						if desc:GetAttribute("OrigBgTrans") == nil then
							desc:SetAttribute("OrigBgTrans", curT)
						end
						local origT = desc:GetAttribute("OrigBgTrans") or curT
						if isBgVisibleMode then
							-- Komponen kartu dibuat transparan kaca agar background terlihat jelas
							desc.BackgroundTransparency = math.max(origT, bgVisibleGlassTrans)
						else
							desc.BackgroundTransparency = origT
						end
					end
				end
			end
		end

		-- Jika mode Background Terlihat aktif dan ada gambar, buat gambar lebih terang/jelas
		local hasBg = (currentBgImageUri ~= "")
		for _, item in ipairs(BgImageLabels) do
			if item.Label and item.Label.Parent then
				local effTrans = isBgVisibleMode and math.min(currentBgTransparency, 0.12) or currentBgTransparency
				item.Label.ImageTransparency = hasBg and effTrans or 1
				item.Label.ScaleType = currentBgScaleType
			end
		end
		SyncSunlightGlowWithBg()
	end

	local function UpdateBackgroundProperties(newTrans, newScale)
		if newTrans ~= nil then
			currentBgTransparency = math.clamp(tonumber(newTrans) or currentBgTransparency, 0, 0.95)
		end
		if newScale ~= nil then
			currentBgScaleType = newScale
		end
		local hasBg = (currentBgImageUri ~= "")
		for _, item in ipairs(BgImageLabels) do
			if item.Label and item.Label.Parent then
