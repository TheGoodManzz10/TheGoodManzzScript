		end

		-- Alias agar kompatibilitas mundur tetap aman & tidak mengubah background UI jadi video
		V105State.ApplyCustomVideoBackground = V105State.PlayTableVideo

		-- Watchdog Loop Tanpa Batas Waktu: Jika video mencapai batas waktu / berhenti, otomatis ulangi (Loop Selamanya!)
		local lastVidCheck = 0
		TrackConnection(RunService.Heartbeat:Connect(function(dt)
			if not V105State.IsVideoActive or V105State.CurrentVideoUri == "" then return end
			lastVidCheck = lastVidCheck + (dt or 0.016)
			if lastVidCheck >= 0.4 then
				lastVidCheck = 0
				for _, vItem in ipairs(V105State.VideoFrames) do
					local vf = vItem.Video
					if not vItem.IsWallpaper and vf and vf.Parent and vf.Visible then
						vf.Looped = true
						pcall(function()
							if not vf.IsPlaying then
								vf.TimePosition = 0
								vf:Play()
							elseif vf.TimeLength and vf.TimeLength > 0 and vf.TimePosition >= (vf.TimeLength - 0.08) then
								vf.TimePosition = 0
								vf:Play()
							end
						end)
					end
				end
			end
		end))
	end

