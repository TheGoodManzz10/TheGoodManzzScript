	local function SafeDefer(fn)
		if type(task) == "table" and type(task.defer) == "function" then
			task.defer(fn)
		elseif type(task) == "table" and type(task.spawn) == "function" then
			task.spawn(fn)
		else
			pcall(fn)
		end
	end

	local function CreateIcon(iconNameOrId, parent, position, size, zIndex, lockWhite)
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Position = position or UDim2.new(0, 0, 0, 0)
		img.Size = size or UDim2.new(0, 16, 0, 16)
		img.ZIndex = zIndex or 10

		if Icons[iconNameOrId] then
			img.Image = Icons[iconNameOrId]
		elseif type(iconNameOrId) == "string" and Icons[iconNameOrId:lower()] then
			img.Image = Icons[iconNameOrId:lower()]
		elseif type(iconNameOrId) == "string" and Icons[iconNameOrId:lower()] then
			img.Image = Icons[iconNameOrId:lower()]
		elseif type(iconNameOrId) == "string" and (iconNameOrId:find("rbxassetid://") or iconNameOrId:find("http")) then
			img.Image = iconNameOrId
		else
			img.Image = Icons["Block"] or "rbxassetid://10709782497"
		end

		img.Parent = parent
		if lockWhite then
			img.ImageColor3 = Color3.fromRGB(255, 255, 255)
			img:SetAttribute("LockWhiteIcon", true)
		else
			img.ImageColor3 = currentAccentColor
			table.insert(ManagedIcons, img)
		end
		return img
	end

