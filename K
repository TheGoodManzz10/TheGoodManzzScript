	local function AttachSnowfallLayer(targetFrame, baseZIndex)
		local SnowHolder = Instance.new("Frame")
		SnowHolder.Name = "SnowfallOverlay"
		SnowHolder.Parent = targetFrame
		SnowHolder.BackgroundTransparency = 1
		SnowHolder.BorderSizePixel = 0
		SnowHolder.Size = UDim2.new(1, 0, 1, 0)
		SnowHolder.ClipsDescendants = true
		SnowHolder.Active = false
		SnowHolder.Visible = isSnowActive
		SnowHolder.ZIndex = baseZIndex

		local flakes = {}
		local flakeCount = 28
		for i = 1, flakeCount do
			local sz = (i % 4 == 0) and 7 or ((i % 3 == 0) and 5 or ((i % 2 == 0) and 4 or 3))
			local Flake = Instance.new("Frame")
			Flake.Name = "SnowflakeDot"
			Flake.Parent = SnowHolder
			Flake.BackgroundColor3 = Color3.fromRGB(245, 250, 255)
			Flake.BackgroundTransparency = 0.15 + ((i % 5) * 0.08)
			Flake.BorderSizePixel = 0
			local initX = ((i * 37) % 96) / 100
			local initY = ((i * 53) % 98) / 100
			Flake.Position = UDim2.new(initX, 0, initY, 0)
			Flake.Size = UDim2.new(0, sz, 0, sz)
			Flake.Active = false
			Flake.ZIndex = baseZIndex

			local FC = Instance.new("UICorner")
			FC.CornerRadius = UDim.new(1, 0)
			FC.Parent = Flake

			table.insert(flakes, {
				Gui = Flake,
				X = initX,
				Y = initY,
				SpeedY = 0.08 + ((i % 7) * 0.022),
				SwayAmp = 0.012 + ((i % 4) * 0.006),
				SwayFreq = 1.2 + ((i % 5) * 0.45),
				Phase = i * 0.85
			})
		end

		table.insert(SnowContainers, {
			Holder = SnowHolder,
			ParentFrame = targetFrame,
			Flakes = flakes
		})
	end

	do
	local snowClock = 0
	TrackConnection(RunService.RenderStepped:Connect(function(dt)
		if not isSnowActive then
			return
		end
		local step = math.min(dt or 0.016, 0.05) * snowSpeedMultiplier
		snowClock = snowClock + step
		for _, sc in ipairs(SnowContainers) do
			if sc.Holder and sc.Holder.Parent and sc.Holder.Visible and sc.ParentFrame and sc.ParentFrame.Visible then
				for _, f in ipairs(sc.Flakes) do
					f.Y = f.Y + (f.SpeedY * step)
					if f.Y > 1.04 then
						f.Y = -0.04
					end
					local swayX = f.X + math.sin((snowClock * f.SwayFreq) + f.Phase) * f.SwayAmp
					if swayX < 0.01 then swayX = 0.01 elseif swayX > 0.98 then swayX = 0.98 end
					f.Gui.Position = UDim2.new(swayX, 0, f.Y, 0)
				end
			end
		end
	end))
	end

	local function SetSnowfallActive(enabled, speedMult)
		if enabled ~= nil then
			isSnowActive = (enabled == true)
		end
		if speedMult ~= nil then
			snowSpeedMultiplier = math.clamp(tonumber(speedMult) or 1.0, 0.4, 3.0)
		end
		for _, sc in ipairs(SnowContainers) do
			if sc.Holder and sc.Holder.Parent then
				sc.Holder.Visible = isSnowActive
			end
		end
		for _, cb in ipairs(SnowToggleCallbacks) do
			pcall(cb, isSnowActive, snowSpeedMultiplier)
		end
	end

