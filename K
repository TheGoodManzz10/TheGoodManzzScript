			OnAccentChanged(function(col)
				Stroke.Color = col
				Lbl.TextColor3 = col
			end)

			local ConsoleObj = {}
			function ConsoleObj:Log(msg)
				local stamp = os.date("%H:%M:%S")
				table.insert(linesList, "[" .. stamp .. "] " .. tostring(msg))
				while #linesList > maxLines do
					table.remove(linesList, 1)
				end
				LogBox.Text = table.concat(linesList, string.char(10))
				if mLog and mLog.Log then
					pcall(function() mLog:Log(msg) end)
				end
			end
			function ConsoleObj:Clear()
				linesList = {}
				LogBox.Text = "[CLEARED]"
				if mLog and mLog.Clear then
					pcall(function() mLog:Clear() end)
				end
			end

			TrackConnection(ClrBtn.MouseButton1Click:Connect(function()
				ConsoleObj:Clear()
			end))

			return ConsoleObj
		end

