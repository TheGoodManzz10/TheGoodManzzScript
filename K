				Stroke.Color = col
				StepBadge.TextColor3 = col
				BarFill.BackgroundColor3 = col
			end)

			local TrackerObj = {}
			function TrackerObj:SetStep(newStep, newStatus)
				curStep = math.clamp(tonumber(newStep) or curStep, 0, maxStep)
				if newStatus then
					curStatus = tostring(newStatus)
					SubLbl.Text = curStatus
				end
				StepBadge.Text = string.format("Step %d/%d", curStep, maxStep)
				TweenService:Create(BarFill, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.new(math.clamp(curStep / maxStep, 0, 1), 0, 1, 0)
				}):Play()
				if mProg and mProg.SetStep then
					pcall(function() mProg:SetStep(newStep, newStatus) end)
				end
			end
			return TrackerObj
		end

