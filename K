			Knob.Position = isBgVisibleMode and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
			Knob.Size = UDim2.new(0, 14, 0, 14)
			Knob.ZIndex = zBase + 2

			local KC = Instance.new("UICorner")
			KC.CornerRadius = UDim.new(1, 0)
			KC.Parent = Knob

			local function SyncVisual(state)
				if not Switch or not Switch.Parent then return end
				TweenService:Create(Switch, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					BackgroundColor3 = state and currentAccentColor or Color3.fromRGB(50, 50, 70)
				}):Play()
				TweenService:Create(Knob, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
				}):Play()
			end
			table.insert(GlassToggleCallbacks, SyncVisual)

			OnAccentChanged(function(col)
				Stroke.Color = col
				if isBgVisibleMode then
					Switch.BackgroundColor3 = col
				end
			end)

			TrackConnection(Switch.MouseButton1Click:Connect(function()
				ApplyBackgroundVisibleMode(not isBgVisibleMode)
				if callback then
					pcall(callback, isBgVisibleMode)
				end
			end))
		end

