			local function MakeStatPill(initText)
				local Pill = Instance.new("TextLabel")
				Pill.Parent = Grid
				Pill.BackgroundColor3 = Color3.fromRGB(36, 38, 54)
				Pill.Size = UDim2.new(0.32, 0, 1, 0)
				Pill.Font = currentFontBold
				Pill:SetAttribute("IsBoldFont", true)
				Pill.Text = initText
				Pill.TextColor3 = Color3.fromRGB(235, 240, 255)
				Pill.TextSize = 9
				Pill.TextTruncate = Enum.TextTruncate.AtEnd
				Pill.ZIndex = zBase + 2
				local plc = Instance.new("UICorner"); plc.CornerRadius = UDim.new(0, 4); plc.Parent = Pill
				return Pill
			end

			local PillFps = MakeStatPill("FPS: 60")
			local PillPing = MakeStatPill("Ping: 50 ms")
			local PillAlt = MakeStatPill("Alt Y: 0")

			local lastT = os.clock()
			local fCnt = 0
			TrackConnection(RunService.RenderStepped:Connect(function()
				fCnt = fCnt + 1
				local now = os.clock()
				if now - lastT >= 1 then
					local pingVal = 50
					pcall(function()
						pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
					end)
					local altY = 0
					pcall(function()
						local c = LocalPlayer and LocalPlayer.Character
						local r = c and c:FindFirstChild("HumanoidRootPart")
						if r then altY = math.floor(r.Position.Y) end
					end)
					PillFps.Text = "FPS: " .. tostring(fCnt)
					PillPing.Text = "Ping: " .. tostring(pingVal) .. "ms"
					PillAlt.Text = "Alt Y: " .. tostring(altY)
					fCnt = 0
					lastT = now
				end
			end))

			OnAccentChanged(function(col)
				Stroke.Color = col
				Lbl.TextColor3 = col
			end)
		end

