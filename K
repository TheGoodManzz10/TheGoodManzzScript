	-------------------------------------------------------------------
	-- GLOBAL THEME, ACCENT, & SAFE FONT STATE (v22.0)
	-------------------------------------------------------------------
	local currentTextThemeColor = Color3.fromRGB(240, 240, 250)
	local currentAccentColor = Color3.fromRGB(59, 130, 246)
	local currentBaseBgColor = Color3.fromRGB(20, 20, 28)
	local currentFontRegular = Enum.Font.Gotham
	local currentFontBold = Enum.Font.GothamBold
	local isRgbActive = false

	local ManagedIcons = {}
	local AccentCallbacks = {}
	local TextColorCallbacks = {}
	local RgbToggleButtons = {}

	local function SafeGetFont(fontName, fallback)
		local ok, res = pcall(function()
			return Enum.Font[fontName]
		end)
		if ok and res then
			return res
		end
		return fallback or Enum.Font.Gotham
	end

	-- Helper mencampur warna gelap track dengan warna aksen tema
	local function TintWithAccent(baseDark, accentCol, alpha)
		return baseDark:Lerp(accentCol, alpha or 0.22)
	end

	local function OnAccentChanged(fn)
		table.insert(AccentCallbacks, fn)
	end

	local OnThemeChanged = OnAccentChanged

	local function OnTextColorChanged(fn)
		table.insert(TextColorCallbacks, fn)
	end

	local function ApplyAccentColor(newColor)
		currentAccentColor = newColor
		for i = #ManagedIcons, 1, -1 do
			local icon = ManagedIcons[i]
			if icon and icon.Parent then
				icon.ImageColor3 = currentAccentColor
			else
				table.remove(ManagedIcons, i)
			end
		end
		for _, fn in ipairs(AccentCallbacks) do
			pcall(fn, currentAccentColor)
		end
	end

	local function ApplyTextColor(newColor)
		currentTextThemeColor = newColor
		for _, fn in ipairs(TextColorCallbacks) do
			pcall(fn, currentTextThemeColor)
		end
		for _, desc in ipairs(ScreenGui:GetDescendants()) do
			if (desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox")) and not desc:GetAttribute("IgnoreTextColor") then
				desc.TextColor3 = currentTextThemeColor
			end
		end
	end

	local function ApplyFontStyle(regularFont, boldFont)
		currentFontRegular = regularFont or Enum.Font.Gotham
		currentFontBold = boldFont or currentFontRegular
		for _, desc in ipairs(ScreenGui:GetDescendants()) do
			if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
				if desc:GetAttribute("IsCodeFont") then
					desc.Font = Enum.Font.Code
				elseif desc:GetAttribute("IsBoldFont") then
					pcall(function()
						desc.Font = currentFontBold
					end)
				else
					pcall(function()
						desc.Font = currentFontRegular
					end)
				end
			end
		end
	end

	local function SyncRgbButtons()
		local labelText = isRgbActive and "Matikan Mode RGB Aksen & Glow" or "Aktifkan Mode RGB Aksen & Glow"
		for _, btn in ipairs(RgbToggleButtons) do
			if btn and btn.Parent then
				btn.Text = labelText
			end
		end
	end

	-------------------------------------------------------------------
	-- HELPER: DRAGGABLE UI (HANYA UNTUK FLOATING BUTTON & POPUP KECIL)
	-------------------------------------------------------------------
	local function MakeDraggable(triggerGui, targetGui)
		targetGui = targetGui or triggerGui
		local dragging = false
		local dragInput = nil
		local dragStart = nil
		local startPos = nil

		TrackConnection(triggerGui.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = targetGui.Position
			end
		end))

		TrackConnection(triggerGui.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end))

		TrackConnection(UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging and dragStart and startPos then
				local delta = input.Position - dragStart
				targetGui.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end))

		TrackConnection(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
	end

