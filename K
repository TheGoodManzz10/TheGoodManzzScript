		function V105State.ResolveVideoAsset(rawInput)
			if type(rawInput) ~= "string" then return "", "Tidak valid" end
			local trimmed = rawInput:gsub("^%s*(.-)%s*$", "%1")
			if trimmed == "" or trimmed:lower() == "none" or trimmed:lower() == "off" or trimmed:lower() == "reset" then
				return "", "Video Dimatikan"
			end
			-- Dukungan Link YouTube (youtube.com/watch?v=... atau youtu.be/...)
			local ytId = trimmed:match("youtu%.be/([%w_%-]+)") or trimmed:match("[?&]v=([%w_%-]+)") or trimmed:match("youtube%.com/shorts/([%w_%-]+)")
			if ytId or trimmed:lower():find("youtube%.com") or trimmed:lower():find("youtu%.be") then
				local cleanYt = ytId or trimmed:gsub("^https?://", "")
				local customAssetFn = (type(getcustomasset) == "function" and getcustomasset) or (type(getsynasset) == "function" and getsynasset)
				if customAssetFn and type(isfile) == "function" then
					for _, cand in ipairs({ cleanYt .. ".webm", cleanYt .. ".mp4", "youtube_" .. cleanYt .. ".webm" }) do
						local okF, ex = pcall(isfile, cand)
						if okF and ex then
							local okA, uri = pcall(customAssetFn, cand)
							if okA and uri then
								return uri, "YouTube (" .. tostring(cleanYt) .. ")"
							end
						end
					end
				end
				return "rbxassetid://5608297917", "YouTube (" .. tostring(cleanYt) .. ")"
			end
			if trimmed:match("^%d+$") then
				return "rbxassetid://" .. trimmed, "Roblox Video ID (" .. trimmed .. ")"
			end
			if trimmed:lower():sub(1, 13) == "rbxassetid://" then
				return trimmed, "Roblox Video Asset"
			end
			local idFromUrl = trimmed:match("roblox%.com/library/(%d+)") or trimmed:match("roblox%.com/asset/%?id=(%d+)") or trimmed:match("create%.roblox%.com/store/asset/(%d+)")
			if idFromUrl then
				return "rbxassetid://" .. idFromUrl, "Roblox Video ID (" .. idFromUrl .. ")"
			end
			local customAssetFn = (type(getcustomasset) == "function" and getcustomasset) or (type(getsynasset) == "function" and getsynasset)
			if trimmed:lower():sub(1, 4) == "http" then
				if customAssetFn and type(writefile) == "function" then
					local ext = ".webm"
					if trimmed:lower():find("%.mp4") then ext = ".mp4" end
					local cacheFile = "AetherLib_CustomBgVideo" .. ext
					local okDl = pcall(function()
						local data = game:HttpGet(trimmed)
						if data and #data > 0 then writefile(cacheFile, data) end
					end)
					if okDl then
						local okAsset, assetUri = pcall(customAssetFn, cacheFile)
						if okAsset and assetUri then return assetUri, "URL Video (" .. cacheFile .. ")" end
					end
				end
				return trimmed, "Direct Video URL"
			end
			if customAssetFn then
				local candidates = { trimmed }
				if not trimmed:find("%.") then
					table.insert(candidates, trimmed .. ".webm")
					table.insert(candidates, trimmed .. ".mp4")
					table.insert(candidates, trimmed .. ".mov")
				end
				for _, pathCandidate in ipairs(candidates) do
					local fileExists = true
					if type(isfile) == "function" then
						local okCheck, resCheck = pcall(isfile, pathCandidate)
						fileExists = (okCheck and resCheck == true)
					end
					if fileExists then
						local okAsset, assetUri = pcall(customAssetFn, pathCandidate)
						if okAsset and type(assetUri) == "string" and assetUri ~= "" then
							return assetUri, "Workspace Video (" .. pathCandidate .. ")"
						end
					end
				end
			end
			return "rbxassetid://" .. trimmed, "Custom Video (" .. trimmed .. ")"
		end

