		local function ApplyCategoryOpenState(state)
			catObj.IsOpen = (state == true)
			ChevronIcon.Image = Icons[catObj.IsOpen and "lucide-chevron-down" or "lucide-chevron-right"]
			InfoHolder.BackgroundTransparency = catObj.IsOpen and 0.25 or 0.55
