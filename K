		for methodName, methodFn in pairs(Scope) do
			if type(methodFn) == "function" and methodName:sub(1, 3) == "Add" and methodName ~= "AddGroup" and methodName ~= "AddTabGroup" and methodName ~= "AddAccordion" and methodName ~= "AddRow" and methodName ~= "AddDualRow" and methodName ~= "AddSplitRow" and methodName ~= "AddDivider" then
				Scope[methodName] = function(self, ...)
					local beforeCount = #TabContent:GetChildren()
					local res = methodFn(self, ...)
					local children = TabContent:GetChildren()
					local args = { ... }
					local customIconCandidate = nil
					for _, a in ipairs(args) do
						if type(a) == "string" and (a:sub(1, 7) == "lucide-" or a:find("rbxassetid://") or Icons[a]) then
							customIconCandidate = a
							break
						end
					end
					for idx = beforeCount + 1, #children do
						local card = children[idx]
						if card and card:IsA("GuiObject") and card.Name ~= "UniversalDualRow" and not card.Name:find("_Card") and card.Size.Y.Offset >= 20 then
							local hasIcon = false
							local firstLbl = nil
							for _, ch in ipairs(card:GetChildren()) do
								if ch:IsA("ImageLabel") then
									hasIcon = true
									break
								elseif (ch:IsA("TextLabel") or ch:IsA("TextButton")) and not firstLbl then
									firstLbl = ch
								end
							end
							if not hasIcon and firstLbl then
								local autoIcon = ResolveComponentIcon(customIconCandidate, firstLbl.Text, "lucide-sparkles")
								local isSingleRow = (card.Size.Y.Offset <= 42)
								local iconPos = isSingleRow and UDim2.new(0, 8, 0.5, -7) or UDim2.new(0, 8, 0, 5)
								CreateIcon(autoIcon, card, iconPos, UDim2.new(0, 15, 0, 15), (card.ZIndex or zBase) + 1)
								if firstLbl.Position.X.Scale == 0 and firstLbl.Position.X.Offset <= 14 then
									local delta = 28 - firstLbl.Position.X.Offset
									firstLbl.Position = UDim2.new(0, 28, firstLbl.Position.Y.Scale, firstLbl.Position.Y.Offset)
									firstLbl.Size = UDim2.new(firstLbl.Size.X.Scale, firstLbl.Size.X.Offset - delta, firstLbl.Size.Y.Scale, firstLbl.Size.Y.Offset)
								end
							end
						end
					end
					return res
				end
			end
		end

		return Scope
	end

