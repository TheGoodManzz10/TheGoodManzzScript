			RC.Parent = ResetBtn

			OnAccentChanged(function(col)
				Stroke.Color = col
				Lbl.TextColor3 = col
				StartBtn.BackgroundColor3 = col
			end)

			local function FormatTime(sec)
				local mins = math.floor(sec / 60)
				local rem = sec % 60
				return string.format("%02d:%04.1f", mins, rem)
			end

			TrackConnection(RunService.Heartbeat:Connect(function(dt)
				if running and Frame and Frame.Parent then
					elapsed = elapsed + (dt or 0.016)
					Lbl.Text = tostring(title or "Timer") .. ": " .. FormatTime(elapsed)
				end
			end))

			TrackConnection(StartBtn.MouseButton1Click:Connect(function()
				running = not running
				StartBtn.Text = running and "Pause" or "Start"
			end))

			TrackConnection(ResetBtn.MouseButton1Click:Connect(function()
				running = false
				StartBtn.Text = "Start"
				local finalElapsed = elapsed
				elapsed = 0
				Lbl.Text = tostring(title or "Timer") .. ": 00:00.0"
				if onResetCallback then
					pcall(onResetCallback, finalElapsed)
				end
			end))
		end

