				item.Label.ImageTransparency = hasBg and effTrans or 1
				item.Label.ScaleType = currentBgScaleType
			end
		end
		SyncSunlightGlowWithBg()
		if isBgVisibleMode then
			ApplyBackgroundVisibleMode(true)
		end
	end

