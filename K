			SubLbl.Parent = Frame
			SubLbl.BackgroundTransparency = 1
			SubLbl.Position = UDim2.new(0, 10, 0, 22)
			SubLbl.Size = UDim2.new(1, -20, 0, 14)
			SubLbl.Font = currentFontRegular
			SubLbl.Text = curStatus
			SubLbl.TextColor3 = Color3.fromRGB(185, 190, 210)
