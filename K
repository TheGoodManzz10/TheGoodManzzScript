	local defaultMainTabObj = nil

	function Elements:AddTabCategory(categoryTitle, iconName)
		V105State.SidebarItemOrder = V105State.SidebarItemOrder + 1
		V105State.CreatedCategories[tostring(categoryTitle)] = true
		return V105State.CreateSidebarCategoryInfo(categoryTitle, iconName, V105State.SidebarItemOrder * 10 - 1)
	end
	Elements.AddTabInfo = Elements.AddTabCategory
	Elements.AddSidebarInfo = Elements.AddTabCategory

	function Elements:AddTab(tabName, iconName, categoryInfo)
		-- Jika tab sudah pernah dibuat (misal "Tab: 1" atau "Tab: 2"), kembalikan objek tab tersebut agar tidak duplikat
		for _, existingTab in ipairs(StarlightTabs) do
			if existingTab.Entry and (existingTab.Entry.Name == tabName or existingTab.Entry.Name == ("Tab: " .. tostring(tabName))) then
				return existingTab
			end
		end

		local isNovaNow = (starlightStage == 2)
		local TabContent = Instance.new("ScrollingFrame")
		TabContent.Name = tabName .. "_Content"
		TabContent.Parent = StarlightFrame
		TabContent.BackgroundTransparency = 1
		TabContent.Position = isNovaNow and UDim2.new(0, 14, 0, 96) or UDim2.new(0, 142, 0, 52)
		TabContent.Size = isNovaNow and UDim2.new(1, -28, 1, -106) or UDim2.new(1, -150, 1, -60)
		TabContent.CanvasSize = UDim2.new(0, 0, 0, 0)
		TabContent.AutomaticCanvasSize = Enum.AutomaticSize.Y
		TabContent.ScrollBarThickness = 3
		TabContent.ScrollBarImageColor3 = currentAccentColor
		TabContent.Visible = false
		TabContent.ZIndex = 22

		OnAccentChanged(function(col)
			TabContent.ScrollBarImageColor3 = col
		end)

		local ContentLayout = Instance.new("UIListLayout")
		ContentLayout.Parent = TabContent
		ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ContentLayout.Padding = UDim.new(0, 6)

		V105State.SidebarItemOrder = V105State.SidebarItemOrder + 1
		local orderIdx = V105State.SidebarItemOrder
		local entry = CreateDualTabButtons(tabName, iconName or "lucide-layers", orderIdx, TabContent, categoryInfo)

		local TabObj = CreateContainerScope(TabContent, 23, nil)
		TabObj.Entry = entry

		BindDynamicContainer(TabContent, ContentLayout, function()
