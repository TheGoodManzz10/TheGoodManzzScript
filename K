		-- 1. AddSpeedometerGauge: Indikator Bar LED Segmen Interaktif (10 Segmen Bercahaya)
		function Scope:AddSpeedometerGauge(title, min, max, defaultVal, unitText)
			local mGauge = MirrorCall("AddSpeedometerGauge", title, min, max, defaultVal, unitText)
			min = tonumber(min) or 0
			max = tonumber(max) or 100
			unitText = tostring(unitText or "")
			local curVal = math.clamp(tonumber(defaultVal) or min, min, max)

			local Frame = Instance.new("Frame")
			Frame.Parent = TabContent
			Frame.BackgroundColor3 = Color3.fromRGB(26, 26, 38)
			Frame.BackgroundTransparency = 0.15
			Frame.Size = UDim2.new(1, 0, 0, 50)
			Frame.ZIndex = zBase

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 6)
			Corner.Parent = Frame

			local Stroke = Instance.new("UIStroke")
			Stroke.Color = currentAccentColor
			Stroke.Transparency = 0.6
			Stroke.Thickness = 1
			Stroke.Parent = Frame

			CreateIcon("lucide-gauge", Frame, UDim2.new(0, 10, 0, 6), UDim2.new(0, 15, 0, 15), zBase + 1)

			local Lbl = Instance.new("TextLabel")
			Lbl.Parent = Frame
			Lbl.BackgroundTransparency = 1
			Lbl.Position = UDim2.new(0, 30, 0, 4)
			Lbl.Size = UDim2.new(0.6, -30, 0, 18)
			Lbl.Font = currentFontRegular
			Lbl.Text = tostring(title or "Speedometer")
			Lbl.TextColor3 = currentTextThemeColor
			Lbl.TextSize = 11
			Lbl.TextTruncate = Enum.TextTruncate.AtEnd
			Lbl.TextXAlignment = Enum.TextXAlignment.Left
			Lbl.ZIndex = zBase + 1

			local ValLbl = Instance.new("TextLabel")
			ValLbl.Parent = Frame
			ValLbl.BackgroundTransparency = 1
			ValLbl.Position = UDim2.new(0.6, 0, 0, 4)
			ValLbl.Size = UDim2.new(0.4, -10, 0, 18)
			ValLbl.Font = currentFontBold
			ValLbl:SetAttribute("IsBoldFont", true)
			ValLbl:SetAttribute("IgnoreTextColor", true)
			ValLbl.Text = tostring(curVal) .. (unitText ~= "" and (" " .. unitText) or "")
			ValLbl.TextColor3 = currentAccentColor
			ValLbl.TextSize = 11
			ValLbl.TextXAlignment = Enum.TextXAlignment.Right
			ValLbl.ZIndex = zBase + 1

			local SegHolder = Instance.new("Frame")
			SegHolder.Parent = Frame
			SegHolder.BackgroundTransparency = 1
			SegHolder.Position = UDim2.new(0, 10, 0, 28)
			SegHolder.Size = UDim2.new(1, -20, 0, 14)
			SegHolder.ZIndex = zBase + 1

			local Segs = {}
			local segCount = 10
			for i = 1, segCount do
				local Seg = Instance.new("Frame")
				Seg.Parent = SegHolder
				Seg.Position = UDim2.new((i - 1) / segCount, 1, 0, 0)
				Seg.Size = UDim2.new(1 / segCount, -2, 1, 0)
				Seg.BackgroundColor3 = Color3.fromRGB(40, 40, 56)
				Seg.ZIndex = zBase + 2

				local SC = Instance.new("UICorner")
				SC.CornerRadius = UDim.new(0, 3)
				SC.Parent = Seg
				table.insert(Segs, Seg)
			end

			local function RefreshSegments()
				local range = math.max(max - min, 1)
				local ratio = math.clamp((curVal - min) / range, 0, 1)
				local activeCount = math.floor(ratio * segCount + 0.5)
				for i, seg in ipairs(Segs) do
					seg.BackgroundColor3 = (i <= activeCount) and currentAccentColor or Color3.fromRGB(40, 40, 56)
				end
				ValLbl.Text = tostring(curVal) .. (unitText ~= "" and (" " .. unitText) or "")
			end

			RefreshSegments()
			OnAccentChanged(function(col)
				Stroke.Color = col
				ValLbl.TextColor3 = col
				RefreshSegments()
			end)

			local GaugeObj = {}
			function GaugeObj:SetValue(newVal)
				curVal = math.clamp(tonumber(newVal) or min, min, max)
				RefreshSegments()
				if mGauge and mGauge.SetValue then
					pcall(function() mGauge:SetValue(newVal) end)
				end
			end
			return GaugeObj
		end

