	local function ApplyUniversalCurve(radiusVal)
		local r = tonumber(radiusVal) or 20
		customStarlightRadius = r
		customNovaRadius = r
		local targetUDim = UDim.new(0, r)
		local headerUDim = UDim.new(0, math.max(14, r - 2))
		local innerUDim = UDim.new(0, math.max(10, math.floor(r * 0.55)))

		-- UI 1 (MainFrame & TopBar)
		if MainCorner then
			TweenService:Create(MainCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = targetUDim }):Play()
		end
		if TopCorner then
			TweenService:Create(TopCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = headerUDim }):Play()
		end

		-- UI 2 (Starlight) & UI 3 (Aether Nova) Frame, Header, Sidebar & TopBar
		if StarlightCorner then
			TweenService:Create(StarlightCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = targetUDim }):Play()
		end
		if StarlightHeaderCorner then
			TweenService:Create(StarlightHeaderCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = headerUDim }):Play()
		end
		if SSHCorner then
			TweenService:Create(SSHCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = innerUDim }):Play()
		end
		if NTBCorner then
			TweenService:Create(NTBCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = innerUDim }):Play()
		end

		-- Popups (Settings & Command List)
		if NSPCorner then
			TweenService:Create(NSPCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = targetUDim }):Play()
		end
		if CLCorner then
			TweenService:Create(CLCorner, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { CornerRadius = targetUDim }):Play()
		end

		-- Sinkronkan semua layer Glow & Wallpaper Background agar garis tepinya ikut melengkung sempurna
		for _, gItem in ipairs(GlowCornersToSync) do
			if gItem.C1 then gItem.C1.CornerRadius = targetUDim end
			if gItem.C2 then gItem.C2.CornerRadius = targetUDim end
			if gItem.C3 then gItem.C3.CornerRadius = targetUDim end
		end
		for _, bItem in ipairs(BgImageLabels) do
			if bItem.Corner then bItem.Corner.CornerRadius = targetUDim end
		end
		for _, vItem in ipairs(V105State.VideoFrames) do
			if vItem.Corner then vItem.Corner.CornerRadius = targetUDim end
		end
	end

