        KnobCorner.CornerRadius = UDim.new(1, 0)
        KnobCorner.Parent = Knob

        local enabled = false
        TrackConnection(SwitchBg.MouseButton1Click:Connect(function()
            enabled = not enabled
            local goalBgColor = enabled and Color3.fromRGB(90, 150, 255) or Color3.fromRGB(60, 60, 75)
            local goalKnobPos = enabled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)

            TweenService:Create(SwitchBg, TweenInfo.new(0.2), {BackgroundColor3 = goalBgColor}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.2), {Position = goalKnobPos}):Play()

            if callback then pcall(callback, enabled) end
        end))
