        MsgLbl.Size = UDim2.new(1, -20, 0, 20)
        MsgLbl.Font = Enum.Font.Gotham
        MsgLbl.Text = message or ""
        MsgLbl.TextColor3 = Color3.fromRGB(200, 200, 210)
        MsgLbl.TextSize = 10
        MsgLbl.TextXAlignment = Enum.TextXAlignment.Left
        NotifGui.ZIndex = 351

        TweenService:Create(NotifGui, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -125, 0, 20)
        }):Play()

        task.delay(duration, function()
            local tweenOut = TweenService:Create(NotifGui, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, -125, 0, -70)
            })
            tweenOut:Play()
            tweenOut.Completed:Connect(function()
                NotifGui:Destroy()
            end)
        end)
    end

    return Elements
end

function AetherLib:Unload()
    for _, conn in ipairs(AetherLib.Connections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    AetherLib.Connections = {}

    for _, inst in ipairs(AetherLib.Instances) do
        if inst then
            inst:Destroy()
        end
    end
    AetherLib.Instances = {}
end

return AetherLib
