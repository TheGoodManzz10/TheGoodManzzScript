    function Elements:AddSlider(name, min, max, default, callback)
        min = min or 0
        max = max or 100
        default = math.clamp(default or min, min, max)

        local SliderFrame = Instance.new("Frame")
        SliderFrame.Parent = ScrollContainer
        SliderFrame.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
        SliderFrame.Size = UDim2.new(1, 0, 0, 52)
        SliderFrame.ZIndex = 9

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 6)
        Corner.Parent = SliderFrame

        local Label = Instance.new("TextLabel")
        Label.Parent = SliderFrame
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 12, 0, 4)
        Label.Size = UDim2.new(1, -24, 0, 20)
        Label.Font = Enum.Font.Gotham
        Label.Text = name .. " : " .. tostring(default)
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 12
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.ZIndex = 10

        local SliderBar = Instance.new("Frame")
        SliderBar.Parent = SliderFrame
        SliderBar.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        SliderBar.Position = UDim2.new(0, 12, 0, 32)
        SliderBar.Size = UDim2.new(1, -24, 0, 5)
        SliderBar.ZIndex = 10

        local BarCorner = Instance.new("UICorner")
        BarCorner.CornerRadius = UDim.new(1, 0)
        BarCorner.Parent = SliderBar

        local range = (max - min) == 0 and 1 or (max - min)
        local initialRatio = (default - min) / range

        local Fill = Instance.new("Frame")
        Fill.Parent = SliderBar
        Fill.BackgroundColor3 = Color3.fromRGB(90, 150, 255)
        Fill.Size = UDim2.new(initialRatio, 0, 1, 0)
        Fill.ZIndex = 11

        local FillCorner = Instance.new("UICorner")
        FillCorner.CornerRadius = UDim.new(1, 0)
        FillCorner.Parent = Fill

        local Knob = Instance.new("Frame")
        Knob.Parent = SliderBar
        Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Knob.Position = UDim2.new(initialRatio, -8, 0.5, -8)
        Knob.Size = UDim2.new(0, 16, 0, 16)
        Knob.ZIndex = 12

        local KnobCorner = Instance.new("UICorner")
        KnobCorner.CornerRadius = UDim.new(1, 0)
        KnobCorner.Parent = Knob

        local sliding = false
        local function update(input)
            local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ((max - min) * pos))

            Fill.Size = UDim2.new(pos, 0, 1, 0)
            Knob.Position = UDim2.new(pos, -8, 0.5, -8)
            Label.Text = name .. " : " .. tostring(val)

            if callback then pcall(callback, val) end
        end

        TrackConnection(Knob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
            end
        end))

        TrackConnection(SliderBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                update(input)
            end
        end))

        TrackConnection(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end))

        TrackConnection(UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end))
    end

    function Elements:AddDropdown(name, options, callback)
        local DropdownFrame = Instance.new("Frame")
        DropdownFrame.Parent = ScrollContainer
        DropdownFrame.BackgroundColor3 = Color3.fromRGB(42, 42, 54)
        DropdownFrame.Size = UDim2.new(1, 0, 0, 42)
        DropdownFrame.ClipsDescendants = true
        DropdownFrame.ZIndex = 9

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 6)
        Corner.Parent = DropdownFrame

        local DropBtn = Instance.new("TextButton")
        DropBtn.Parent = DropdownFrame
        DropBtn.BackgroundTransparency = 1
        DropBtn.Size = UDim2.new(1, 0, 0, 42)
        DropBtn.Font = Enum.Font.Gotham
        DropBtn.Text = " " .. name .. " : Select..."
        DropBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DropBtn.TextSize = 12
        DropBtn.TextXAlignment = Enum.TextXAlignment.Left
        DropBtn.ZIndex = 10

        local OptionList = Instance.new("ScrollingFrame")
        OptionList.Parent = DropdownFrame
        OptionList.BackgroundTransparency = 1
        OptionList.Position = UDim2.new(0, 8, 0, 42)
        OptionList.Size = UDim2.new(1, -16, 0, 90)
        OptionList.CanvasSize = UDim2.new(0, 0, 0, 0)
        OptionList.AutomaticCanvasSize = Enum.AutomaticSize.Y
        OptionList.ScrollBarThickness = 3
        OptionList.ZIndex = 10

        local ListLayout = Instance.new("UIListLayout")
        ListLayout.Parent = OptionList
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ListLayout.Padding = UDim.new(0, 4)

        local open = false
        TrackConnection(DropBtn.MouseButton1Click:Connect(function()
            open = not open
            local targetSize = open and UDim2.new(1, 0, 0, 140) or UDim2.new(1, 0, 0, 42)
            TweenService:Create(DropdownFrame, TweenInfo.new(0.25), {Size = targetSize}):Play()
        end))

        local DropdownObj = {}
        function DropdownObj:Refresh(newOptions)
            for _, child in ipairs(OptionList:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            if not newOptions or #newOptions == 0 then newOptions = {"Tidak ada pilihan"} end
            for _, optionName in ipairs(newOptions) do
                local ItemBtn = Instance.new("TextButton")
                ItemBtn.Parent = OptionList
                ItemBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
                ItemBtn.Size = UDim2.new(1, 0, 0, 26)
                ItemBtn.Font = Enum.Font.Gotham
                ItemBtn.Text = optionName
                ItemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                ItemBtn.TextSize = 11
                ItemBtn.ZIndex = 11

                local ItemCorner = Instance.new("UICorner")
                ItemCorner.CornerRadius = UDim.new(0, 4)
                ItemCorner.Parent = ItemBtn

                TrackConnection(ItemBtn.MouseButton1Click:Connect(function()
                    DropBtn.Text = " " .. name .. " : " .. optionName
                    open = false
                    TweenService:Create(DropdownFrame, TweenInfo.new(0.25), {Size = UDim2.new(1, 0, 0, 42)}):Play()
                    if callback then pcall(callback, optionName) end
                end))
            end
        end

        DropdownObj:Refresh(options)
        return DropdownObj
    end

