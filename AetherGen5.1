        Stroke.Parent = PerfFrame

        local PerfText = Instance.new("TextLabel")
        PerfText.Parent = PerfFrame
        PerfText.BackgroundTransparency = 1
        PerfText.Size = UDim2.new(1, 0, 1, 0)
        PerfText.Font = Enum.Font.GothamBold
        PerfText.Text = "⚡ FPS: -- | 📶 Ping: -- ms"
        PerfText.TextColor3 = Color3.fromRGB(255, 255, 255)
        PerfText.TextSize = 10
        PerfText.ZIndex = 151

        local lastUpdate = tick()
        local frameCount = 0

        TrackConnection(game:GetService("RunService").RenderStepped:Connect(function()
            frameCount = frameCount + 1
            if tick() - lastUpdate >= 1 then
                local fps = frameCount
                local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                PerfText.Text = string.format("⚡ FPS: %d | 📶 Ping: %d ms", fps, ping)
                frameCount = 0
                lastUpdate = tick()
            end
        end))
    end

